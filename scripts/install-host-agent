#!/usr/bin/env python3
"""Install fixed host-agent credentials and its hardened system unit."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import secrets
import stat
import subprocess
import sys
from typing import Sequence


UNIT_NAME = "codex-master-host-agent.service"
UNIT_SOURCE = Path(__file__).resolve().parents[1] / "systemd" / UNIT_NAME
ROOT_UID = 0
_OPEN_DIRECTORY = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
_OPEN_FILE = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW


class InstallerError(Exception):
    """A deliberately detail-free installation failure."""


class _Parser(argparse.ArgumentParser):
    def error(self, _message: str) -> None:
        raise InstallerError


def _absolute_path(value: str) -> Path:
    path = Path(value)
    if not path.is_absolute() or any(part in {".", ".."} for part in path.parts):
        raise InstallerError
    return path


def _same_metadata(first: os.stat_result, second: os.stat_result) -> bool:
    return (
        first.st_dev,
        first.st_ino,
        first.st_mode,
        first.st_uid,
        first.st_gid,
        first.st_nlink,
        first.st_size,
        first.st_mtime_ns,
        first.st_ctime_ns,
    ) == (
        second.st_dev,
        second.st_ino,
        second.st_mode,
        second.st_uid,
        second.st_gid,
        second.st_nlink,
        second.st_size,
        second.st_mtime_ns,
        second.st_ctime_ns,
    )


def _assert_trusted_regular(metadata: os.stat_result, mode: int) -> None:
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != ROOT_UID
        or metadata.st_nlink != 1
        or stat.S_IMODE(metadata.st_mode) != mode
    ):
        raise InstallerError


def _open_directory(path: Path) -> int:
    descriptor = os.open("/", _OPEN_DIRECTORY)
    try:
        for component in path.parts[1:]:
            before = os.stat(component, dir_fd=descriptor, follow_symlinks=False)
            if not stat.S_ISDIR(before.st_mode):
                raise InstallerError
            child = os.open(component, _OPEN_DIRECTORY, dir_fd=descriptor)
            try:
                opened = os.fstat(child)
                after = os.stat(component, dir_fd=descriptor, follow_symlinks=False)
                if not _same_metadata(before, opened) or not _same_metadata(
                    before, after
                ):
                    raise InstallerError
            except BaseException:
                os.close(child)
                raise
            os.close(descriptor)
            descriptor = child
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _open_trusted_source(path: Path, mode: int) -> int:
    parent = _open_directory(path.parent)
    descriptor = -1
    try:
        before = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
        _assert_trusted_regular(before, mode)
        descriptor = os.open(path.name, _OPEN_FILE, dir_fd=parent)
        opened = os.fstat(descriptor)
        after = os.stat(path.name, dir_fd=parent, follow_symlinks=False)
        if not _same_metadata(before, opened) or not _same_metadata(before, after):
            raise InstallerError
        _assert_trusted_regular(opened, mode)
        return descriptor
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    finally:
        os.close(parent)


def _open_or_create_directory(parent: int, name: str, mode: int) -> int:
    try:
        before = os.stat(name, dir_fd=parent, follow_symlinks=False)
    except FileNotFoundError:
        os.mkdir(name, mode, dir_fd=parent)
        before = os.stat(name, dir_fd=parent, follow_symlinks=False)
        created = True
    else:
        created = False
    if not stat.S_ISDIR(before.st_mode):
        raise InstallerError
    descriptor = os.open(name, _OPEN_DIRECTORY, dir_fd=parent)
    try:
        opened = os.fstat(descriptor)
        after = os.stat(name, dir_fd=parent, follow_symlinks=False)
        if not _same_metadata(before, opened) or not _same_metadata(before, after):
            raise InstallerError
        if created:
            os.fchown(descriptor, ROOT_UID, ROOT_UID)
            os.fchmod(descriptor, mode)
            os.fsync(descriptor)
            os.fsync(parent)
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


def _copy_atomically(source: int, parent: int, name: str, mode: int) -> None:
    temporary = f".{name}.tmp-{os.getpid()}-{secrets.token_hex(16)}"
    destination = -1
    try:
        destination = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
            mode,
            dir_fd=parent,
        )
        os.fchown(destination, ROOT_UID, ROOT_UID)
        os.fchmod(destination, mode)
        while chunk := os.read(source, 64 * 1024):
            view = memoryview(chunk)
            while view:
                view = view[os.write(destination, view) :]
        os.fsync(destination)
        os.close(destination)
        destination = -1
        os.replace(temporary, name, src_dir_fd=parent, dst_dir_fd=parent)
        os.fsync(parent)
    finally:
        if destination >= 0:
            os.close(destination)
        try:
            os.unlink(temporary, dir_fd=parent)
        except FileNotFoundError:
            pass


def _destination_directories(root: Path) -> tuple[int, int]:
    destination_root = _open_directory(root)
    etc = systemd = credentials = units = -1
    try:
        etc = _open_or_create_directory(destination_root, "etc", 0o755)
        credentials = _open_or_create_directory(etc, "codex-master", 0o700)
        systemd = _open_or_create_directory(etc, "systemd", 0o755)
        units = _open_or_create_directory(systemd, "system", 0o755)
        return credentials, units
    except BaseException:
        if units >= 0:
            os.close(units)
        if credentials >= 0:
            os.close(credentials)
        raise
    finally:
        if systemd >= 0:
            os.close(systemd)
        if etc >= 0:
            os.close(etc)
        os.close(destination_root)


def _parse_arguments(argv: Sequence[str] | None) -> argparse.Namespace:
    parser = _Parser(add_help=False)
    parser.add_argument("--agent-client-key", required=True)
    parser.add_argument("--agent-client-cert", required=True)
    parser.add_argument("--agent-master-ca", required=True)
    parser.add_argument("--agent-config", required=True)
    parser.add_argument("--destdir", default="/")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--enable", action="store_true")
    arguments = parser.parse_args(argv)
    arguments.agent_client_key = _absolute_path(arguments.agent_client_key)
    arguments.agent_client_cert = _absolute_path(arguments.agent_client_cert)
    arguments.agent_master_ca = _absolute_path(arguments.agent_master_ca)
    arguments.agent_config = _absolute_path(arguments.agent_config)
    arguments.destdir = _absolute_path(arguments.destdir)
    return arguments


def _enable_service() -> None:
    subprocess.run(
        ["/usr/bin/systemctl", "daemon-reload"],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    subprocess.run(
        ["/usr/bin/systemctl", "enable", "--now", UNIT_NAME],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main(argv: Sequence[str] | None = None) -> int:
    sources: list[tuple[int, str, int]] = []
    try:
        arguments = _parse_arguments(argv)
        if os.geteuid() != ROOT_UID:
            raise InstallerError
        sources = [
            (
                _open_trusted_source(arguments.agent_client_key, 0o400),
                "agent-client.key",
                0o400,
            ),
            (
                _open_trusted_source(arguments.agent_client_cert, 0o444),
                "agent-client.crt",
                0o444,
            ),
            (
                _open_trusted_source(arguments.agent_master_ca, 0o444),
                "agent-master-ca.crt",
                0o444,
            ),
            (
                _open_trusted_source(arguments.agent_config, 0o400),
                "agent-config.json",
                0o400,
            ),
            (_open_trusted_source(UNIT_SOURCE, 0o644), UNIT_NAME, 0o644),
        ]
        if arguments.dry_run:
            return 0
        credentials, units = _destination_directories(arguments.destdir)
        try:
            for descriptor, name, mode in sources[:-1]:
                _copy_atomically(descriptor, credentials, name, mode)
            descriptor, name, mode = sources[-1]
            _copy_atomically(descriptor, units, name, mode)
        finally:
            os.close(credentials)
            os.close(units)
        if arguments.enable:
            _enable_service()
        return 0
    except (InstallerError, OSError, subprocess.SubprocessError, SystemExit):
        print("install-host-agent: installation failed", file=sys.stderr)
        return 1
    finally:
        for descriptor, _name, _mode in sources:
            os.close(descriptor)


if __name__ == "__main__":
    raise SystemExit(main())
