#!/usr/bin/python3
"""Materialize one complete, private Runtime Image without activating units."""

from __future__ import annotations

import argparse
import contextlib
import ctypes
from dataclasses import dataclass
import errno
import hashlib
import json
import os
from pathlib import Path
import stat
import sys
import tempfile


sys.dont_write_bytecode = True
_RUNTIME_PROCESS_SOURCE = Path(__file__).resolve().parents[1] / "src"
if not _RUNTIME_PROCESS_SOURCE.is_dir():
    raise SystemExit("runtime_process_source_missing")
sys.path.insert(0, os.fspath(_RUNTIME_PROCESS_SOURCE))
from codex_master.runtime_process import (  # noqa: E402
    DEFAULT_STDERR_LIMIT,
    BoundedProcessError,
    run_bounded,
)


_RUNTIME_ROOT_NAME = "codex-master-runtime"
_MAX_SOURCE_BYTES = 2 * 1024 * 1024
_MAX_STAGE_DIAGNOSTIC_BYTES = 256 * 1024
_MAX_MANIFEST_BYTES = 512 * 1024
_MANIFEST_NAME = ".codex-master-runtime-manifest.json"
_MANIFEST_SCHEMA_VERSION = 1
# Provenance: canonical 23510da legacy probe payload.  The focused regression
# test reconstructs the former installer contract from that revision; runtime
# cleanup remains fully static and never invokes Git or a checkout.
_LEGACY_PROBE_MANIFEST_DIGEST = (
    "723416595c8c8eec8c68d3021964d01014652abb8300a39a511d32e6976f7802"
)
_LEGACY_LIBEXEC_DIGEST = (
    "eda064e0df15689218e45d4a3460c26c8007ad097edc3101b20302038f3c262f"
)
_LEGACY_LIBEXEC_SIZE = 520
_UNIT_NAMES = (
    "codex-master-hive-hourly-probe.service",
    "codex-master-hive-hourly-probe.timer",
)
# This is the sole product Runtime Image definition. Recursive entries carry
# complete product trees; no Probe-specific mirror is maintained.
_RUNTIME_IMAGE_FILES = (
    ("bin/codex-master-mcp", "bin/codex-master-mcp", 0o755),
    ("bin/codex-master-hive-hourly-probe", "bin/codex-master-hive-hourly-probe", 0o755),
    (".codex-plugin/plugin.json", ".codex-plugin/plugin.json", 0o644),
    (".mcp.json", ".mcp.json", 0o644),
    (".app.json", ".app.json", 0o644),
    ("codex-hive.json", "codex-hive.json", 0o644),
    ("codex-agent-classes.json", "codex-agent-classes.json", 0o644),
    ("codex-agent-pool.json", "codex-agent-pool.json", 0o644),
    ("codex-model-policy.json", "codex-model-policy.json", 0o644),
)
_RUNTIME_IMAGE_TREES = (
    ("src/codex_master", "src/codex_master"),
    ("skills/codex-master-fleet", "skills/codex-master-fleet"),
    ("hooks", "hooks"),
    ("schemas", "schemas"),
)


class InstallError(Exception):
    pass


@dataclass(slots=True)
class _LegacyCleanupEntry:
    parent_fd: int
    name: str
    kind: str
    identity: tuple[int, int, str]
    root_fd: int | None = None


def _directory(path: Path, *, mode: int, create: bool) -> None:
    try:
        item = path.lstat()
    except FileNotFoundError:
        if not create:
            raise InstallError("home_unavailable") from None
        path.mkdir(mode=mode)
        item = path.lstat()
    except OSError as exc:
        raise InstallError("install_path_untrusted") from exc
    if (
        stat.S_ISLNK(item.st_mode)
        or not stat.S_ISDIR(item.st_mode)
        or item.st_uid != os.geteuid()
        or stat.S_IMODE(item.st_mode) & 0o022
    ):
        raise InstallError("install_path_untrusted")


def _child_directory(home: Path, parts: tuple[str, ...], *, mode: int) -> Path:
    current = home
    for part in parts:
        current /= part
        _directory(current, mode=mode, create=True)
    try:
        os.chmod(current, mode)
    except OSError as exc:
        raise InstallError("install_path_untrusted") from exc
    return current


def _source_bytes(path: Path) -> bytes:
    """Read one bounded, own regular source through a no-follow descriptor."""

    descriptor = -1
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
        )
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != os.geteuid()
            or stat.S_IMODE(before.st_mode) & 0o022
            or before.st_size <= 0
            or before.st_size > _MAX_SOURCE_BYTES
        ):
            raise InstallError("install_source_untrusted")
        chunks: list[bytes] = []
        remaining = _MAX_SOURCE_BYTES + 1
        while remaining:
            chunk = os.read(descriptor, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        after = os.fstat(descriptor)
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError("install_source_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if (
        not data
        or len(data) > _MAX_SOURCE_BYTES
        or (
            before.st_dev,
            before.st_ino,
            before.st_mode,
            before.st_uid,
            before.st_nlink,
            before.st_size,
        )
        != (
            after.st_dev,
            after.st_ino,
            after.st_mode,
            after.st_uid,
            after.st_nlink,
            after.st_size,
        )
    ):
        raise InstallError("install_source_untrusted")
    return data


def _source_directory(path: Path) -> None:
    try:
        item = path.lstat()
    except OSError as exc:
        raise InstallError("install_source_untrusted") from exc
    if (
        stat.S_ISLNK(item.st_mode)
        or not stat.S_ISDIR(item.st_mode)
        or item.st_uid != os.geteuid()
        or stat.S_IMODE(item.st_mode) & 0o022
    ):
        raise InstallError("install_source_untrusted")


def _install_regular(source: Path, target: Path, *, mode: int) -> None:
    content = _source_bytes(source)
    try:
        existing = target.lstat()
    except FileNotFoundError:
        existing = None
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    if existing is not None and (
        stat.S_ISLNK(existing.st_mode) or not stat.S_ISREG(existing.st_mode)
    ):
        raise InstallError("install_target_untrusted")
    descriptor = -1
    temporary = Path()
    try:
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=f".{target.name}.", dir=target.parent
        )
        temporary = Path(temporary_name)
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, target)
        temporary = Path()
        installed = target.lstat()
        if (
            stat.S_ISLNK(installed.st_mode)
            or not stat.S_ISREG(installed.st_mode)
            or installed.st_nlink != 1
            or installed.st_uid != os.geteuid()
            or stat.S_IMODE(installed.st_mode) != mode
        ):
            raise InstallError("install_target_untrusted")
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary.name:
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass


def _install_tree(source_root: Path, target_root: Path) -> None:
    _source_directory(source_root)
    copied = 0
    for directory, child_directories, file_names in os.walk(source_root):
        current = Path(directory)
        _source_directory(current)
        relative_directory = current.relative_to(source_root)
        _child_directory(target_root, tuple(relative_directory.parts), mode=0o700)
        for name in child_directories:
            _source_directory(current / name)
        child_directories[:] = [
            name for name in child_directories if name != "__pycache__"
        ]
        for name in sorted(file_names):
            source = current / name
            target = target_root / relative_directory / name
            _install_regular(source, target, mode=0o644)
            copied += 1
    if copied == 0:
        raise InstallError("install_source_untrusted")


def _fsync_directory(path: Path) -> None:
    descriptor = -1
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        os.fsync(descriptor)
    except OSError as exc:
        raise InstallError("install_fsync_failed") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _fsync_tree(root: Path) -> None:
    for directory, _child_directories, file_names in os.walk(root, topdown=False):
        current = Path(directory)
        _source_directory(current)
        for name in file_names:
            if not _source_bytes(current / name):
                raise InstallError("install_target_untrusted")
        _fsync_directory(current)


def _build_runtime_image(*, repository: Path, stage: Path) -> None:
    _directory(stage, mode=0o700, create=False)
    for source_name, target_name, mode in _RUNTIME_IMAGE_FILES:
        target = stage / target_name
        _child_directory(
            stage, tuple(target.parent.relative_to(stage).parts), mode=0o700
        )
        _install_regular(repository / source_name, target, mode=mode)
    for source_name, target_name in _RUNTIME_IMAGE_TREES:
        target = stage / target_name
        _child_directory(stage, tuple(target.relative_to(stage).parts), mode=0o700)
        _install_tree(repository / source_name, target)
    _write_runtime_image_manifest(root=stage)
    _fsync_tree(stage)


def _validate_runtime_image_stage(*, stage: Path, home: Path) -> None:
    """Exercise the three v2 diagnostics from the isolated, complete stage."""

    command = stage / "bin" / "codex-master-mcp"
    for hive_command in ("runtime-status", "status", "doctor"):
        try:
            completed = run_bounded(
                [os.fspath(command), "hive", hive_command],
                cwd=stage,
                home=home,
                timeout_seconds=45,
                stdout_limit=_MAX_STAGE_DIAGNOSTIC_BYTES,
                stderr_limit=DEFAULT_STDERR_LIMIT,
            )
        except BoundedProcessError as exc:
            raise InstallError("install_stage_validation_failed") from exc
        if completed.returncode != 0:
            raise InstallError("install_stage_validation_failed")
        try:
            payload = json.loads(completed.stdout)
        except (json.JSONDecodeError, RecursionError) as exc:
            raise InstallError("install_stage_validation_failed") from exc
        if not isinstance(payload, dict):
            raise InstallError("install_stage_validation_failed")
        if hive_command == "runtime-status" and payload.get("ok") is not True:
            raise InstallError("install_stage_validation_failed")


def _canonical_json(value: object) -> bytes:
    try:
        return (
            json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
            + "\n"
        ).encode("ascii")
    except (TypeError, ValueError, RecursionError) as exc:
        raise InstallError("install_target_untrusted") from exc


def _relative_name(value: object, *, root_allowed: bool = False) -> str:
    if root_allowed and value == ".":
        return "."
    if not isinstance(value, str) or not value or value.startswith("/"):
        raise InstallError("install_target_untrusted")
    parts = value.split("/")
    if any(not part or part in {".", ".."} or "\x00" in part for part in parts):
        raise InstallError("install_target_untrusted")
    return value


def _open_absolute_directory(path: Path, *, error_code: str) -> int:
    if not isinstance(path, Path) or not path.is_absolute():
        raise InstallError(error_code)
    descriptor = -1
    retained = False
    try:
        descriptor = os.open(
            path.anchor,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_CLOEXEC", 0),
        )
        for part in path.parts[1:]:
            next_descriptor = os.open(
                part,
                os.O_RDONLY
                | getattr(os, "O_DIRECTORY", 0)
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_CLOEXEC", 0),
                dir_fd=descriptor,
            )
            os.close(descriptor)
            descriptor = next_descriptor
        opened = os.fstat(descriptor)
        if stat.S_ISLNK(opened.st_mode) or not stat.S_ISDIR(opened.st_mode):
            raise InstallError(error_code)
        retained = True
        return descriptor
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError(error_code) from exc
    except Exception:
        raise InstallError(error_code) from None
    finally:
        if descriptor >= 0 and not retained:
            os.close(descriptor)


def _open_directory_at(
    parent_fd: int, name: str, *, error_code: str
) -> tuple[int, os.stat_result]:
    _relative_name(name)
    descriptor = -1
    retained = False
    try:
        expected = os.lstat(name, dir_fd=parent_fd)
        descriptor = os.open(
            name,
            os.O_RDONLY
            | getattr(os, "O_DIRECTORY", 0)
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_CLOEXEC", 0),
            dir_fd=parent_fd,
        )
        opened = os.fstat(descriptor)
        if (
            stat.S_ISLNK(expected.st_mode)
            or not stat.S_ISDIR(expected.st_mode)
            or (
                opened.st_dev,
                opened.st_ino,
                opened.st_mode,
                opened.st_uid,
                opened.st_nlink,
            )
            != (
                expected.st_dev,
                expected.st_ino,
                expected.st_mode,
                expected.st_uid,
                expected.st_nlink,
            )
        ):
            raise InstallError(error_code)
        retained = True
        return descriptor, opened
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError(error_code) from exc
    finally:
        if descriptor >= 0 and not retained:
            os.close(descriptor)


def _read_regular_at(
    parent_fd: int, name: str, *, max_bytes: int, error_code: str
) -> tuple[bytes, os.stat_result]:
    _relative_name(name)
    descriptor = -1
    try:
        expected = os.lstat(name, dir_fd=parent_fd)
        descriptor = os.open(
            name,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
            dir_fd=parent_fd,
        )
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != os.geteuid()
            or before.st_size <= 0
            or before.st_size > max_bytes
            or (
                before.st_dev,
                before.st_ino,
                before.st_mode,
                before.st_uid,
                before.st_nlink,
                before.st_size,
            )
            != (
                expected.st_dev,
                expected.st_ino,
                expected.st_mode,
                expected.st_uid,
                expected.st_nlink,
                expected.st_size,
            )
        ):
            raise InstallError(error_code)
        chunks: list[bytes] = []
        remaining = max_bytes + 1
        while remaining:
            chunk = os.read(descriptor, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        raw = b"".join(chunks)
        after = os.fstat(descriptor)
        if (
            len(raw) != before.st_size
            or len(raw) > max_bytes
            or (
                before.st_dev,
                before.st_ino,
                before.st_mode,
                before.st_uid,
                before.st_nlink,
                before.st_size,
            )
            != (
                after.st_dev,
                after.st_ino,
                after.st_mode,
                after.st_uid,
                after.st_nlink,
                after.st_size,
            )
        ):
            raise InstallError(error_code)
        return raw, after
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError(error_code) from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _runtime_manifest_payload(root: Path) -> dict[str, object]:
    _directory(root, mode=0o700, create=False)
    directories: dict[str, dict[str, int]] = {}
    files: dict[str, dict[str, object]] = {}
    for directory, child_directories, file_names in os.walk(root):
        current = Path(directory)
        _source_directory(current)
        relative = current.relative_to(root).as_posix() if current != root else "."
        current_stat = current.lstat()
        directories[relative] = {
            "mode": stat.S_IMODE(current_stat.st_mode),
            "nlink": current_stat.st_nlink,
        }
        child_directories[:] = sorted(child_directories)
        for name in child_directories:
            _source_directory(current / name)
        for name in sorted(file_names):
            if name == _MANIFEST_NAME:
                raise InstallError("install_target_untrusted")
            raw = _source_bytes(current / name)
            item = (current / name).lstat()
            files[(current / name).relative_to(root).as_posix()] = {
                "mode": stat.S_IMODE(item.st_mode),
                "nlink": item.st_nlink,
                "size": len(raw),
                "sha256": hashlib.sha256(raw).hexdigest(),
            }
    return {
        "schema_version": _MANIFEST_SCHEMA_VERSION,
        "directories": directories,
        "files": files,
    }


def _write_runtime_image_manifest(*, root: Path) -> None:
    encoded = _canonical_json(_runtime_manifest_payload(root))
    if len(encoded) > _MAX_MANIFEST_BYTES:
        raise InstallError("install_target_untrusted")
    descriptor = -1
    temporary = Path()
    try:
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=f".{_MANIFEST_NAME}.", dir=root
        )
        temporary = Path(temporary_name)
        os.fchmod(descriptor, 0o644)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, root / _MANIFEST_NAME)
        temporary = Path()
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary.name:
            with contextlib.suppress(FileNotFoundError):
                temporary.unlink()


def _validated_manifest(
    root_fd: int, *, error_code: str
) -> tuple[dict[str, object], bytes]:
    raw, item = _read_regular_at(
        root_fd, _MANIFEST_NAME, max_bytes=_MAX_MANIFEST_BYTES, error_code=error_code
    )
    if stat.S_IMODE(item.st_mode) != 0o644:
        raise InstallError(error_code)
    try:
        payload = json.loads(raw.decode("ascii"))
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as exc:
        raise InstallError(error_code) from exc
    if not isinstance(payload, dict) or raw != _canonical_json(payload):
        raise InstallError(error_code)
    if (
        frozenset(payload) != {"schema_version", "directories", "files"}
        or payload.get("schema_version") != _MANIFEST_SCHEMA_VERSION
    ):
        raise InstallError(error_code)
    directories = payload.get("directories")
    files = payload.get("files")
    if (
        not isinstance(directories, dict)
        or not isinstance(files, dict)
        or "." not in directories
    ):
        raise InstallError(error_code)
    for name, details in directories.items():
        _relative_name(name, root_allowed=True)
        if not isinstance(details, dict) or frozenset(details) != {"mode", "nlink"}:
            raise InstallError(error_code)
        if (
            details.get("mode") != 0o700
            or type(details.get("nlink")) is not int
            or details["nlink"] < 2
        ):
            raise InstallError(error_code)
        if name != "." and "/" in name and name.rsplit("/", 1)[0] not in directories:
            raise InstallError(error_code)
    for name, details in files.items():
        _relative_name(name)
        if (
            name == _MANIFEST_NAME
            or not isinstance(details, dict)
            or frozenset(details) != {"mode", "nlink", "size", "sha256"}
        ):
            raise InstallError(error_code)
        parent = name.rsplit("/", 1)[0] if "/" in name else "."
        if parent not in directories:
            raise InstallError(error_code)
        digest = details.get("sha256")
        if (
            details.get("mode") not in {0o644, 0o755}
            or details.get("nlink") != 1
            or type(details.get("size")) is not int
            or not 0 < details["size"] <= _MAX_SOURCE_BYTES
            or not isinstance(digest, str)
            or len(digest) != 64
            or any(character not in "0123456789abcdef" for character in digest)
        ):
            raise InstallError(error_code)
    return payload, raw


def _validate_manifest_tree(
    root_fd: int, payload: dict[str, object], manifest_raw: bytes, *, error_code: str
) -> None:
    directories = payload["directories"]
    files = payload["files"]
    assert isinstance(directories, dict) and isinstance(files, dict)
    observed_directories: set[str] = {"."}
    observed_files: set[str] = set()

    def walk(directory_fd: int, prefix: str) -> None:
        scan_fd = os.dup(directory_fd)
        with os.scandir(scan_fd) as entries:
            for entry in entries:
                name = entry.name
                _relative_name(name)
                relative = f"{prefix}/{name}" if prefix else name
                item = entry.stat(follow_symlinks=False)
                if stat.S_ISDIR(item.st_mode):
                    details = directories.get(relative)
                    if (
                        not isinstance(details, dict)
                        or stat.S_ISLNK(item.st_mode)
                        or item.st_uid != os.geteuid()
                        or stat.S_IMODE(item.st_mode) != details.get("mode")
                        or item.st_nlink != details.get("nlink")
                    ):
                        raise InstallError(error_code)
                    child_fd, _opened = _open_directory_at(
                        directory_fd, name, error_code=error_code
                    )
                    try:
                        observed_directories.add(relative)
                        walk(child_fd, relative)
                    finally:
                        os.close(child_fd)
                    continue
                if not stat.S_ISREG(item.st_mode) or stat.S_ISLNK(item.st_mode):
                    raise InstallError(error_code)
                if relative == _MANIFEST_NAME:
                    raw, manifest_item = _read_regular_at(
                        directory_fd,
                        name,
                        max_bytes=_MAX_MANIFEST_BYTES,
                        error_code=error_code,
                    )
                    if (
                        stat.S_IMODE(manifest_item.st_mode) != 0o644
                        or raw != manifest_raw
                    ):
                        raise InstallError(error_code)
                    continue
                details = files.get(relative)
                if not isinstance(details, dict):
                    raise InstallError(error_code)
                raw, opened = _read_regular_at(
                    directory_fd,
                    name,
                    max_bytes=_MAX_SOURCE_BYTES,
                    error_code=error_code,
                )
                if (
                    stat.S_IMODE(opened.st_mode) != details.get("mode")
                    or opened.st_nlink != details.get("nlink")
                    or opened.st_size != details.get("size")
                    or hashlib.sha256(raw).hexdigest() != details.get("sha256")
                ):
                    raise InstallError(error_code)
                observed_files.add(relative)

    root_details = directories.get(".")
    root_stat = os.fstat(root_fd)
    if (
        not isinstance(root_details, dict)
        or root_stat.st_uid != os.geteuid()
        or stat.S_IMODE(root_stat.st_mode) != root_details.get("mode")
        or root_stat.st_nlink != root_details.get("nlink")
    ):
        raise InstallError(error_code)
    walk(root_fd, "")
    if observed_directories != set(directories) or observed_files != set(files):
        raise InstallError(error_code)


def _validated_image_at(
    parent_fd: int, name: str, *, error_code: str
) -> tuple[int, int, str]:
    root_fd = -1
    try:
        root_fd, root_stat = _open_directory_at(parent_fd, name, error_code=error_code)
        if (
            root_stat.st_uid != os.geteuid()
            or stat.S_IMODE(root_stat.st_mode) != 0o700
            or root_stat.st_nlink < 2
        ):
            raise InstallError(error_code)
        manifest, raw = _validated_manifest(root_fd, error_code=error_code)
        _validate_manifest_tree(root_fd, manifest, raw, error_code=error_code)
        final_stat = os.fstat(root_fd)
        if (final_stat.st_dev, final_stat.st_ino, final_stat.st_nlink) != (
            root_stat.st_dev,
            root_stat.st_ino,
            root_stat.st_nlink,
        ):
            raise InstallError(error_code)
        return root_stat.st_dev, root_stat.st_ino, hashlib.sha256(raw).hexdigest()
    finally:
        if root_fd >= 0:
            os.close(root_fd)


def _rename_exchange(parent_fd: int, stage_name: str, target_name: str) -> None:
    library = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(library, "renameat2", None)
    if renameat2 is None:
        raise InstallError("install_swap_unavailable")
    renameat2.argtypes = (
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    )
    renameat2.restype = ctypes.c_int
    if (
        renameat2(
            parent_fd, os.fsencode(stage_name), parent_fd, os.fsencode(target_name), 2
        )
        != 0
    ):
        error = ctypes.get_errno()
        if error in {errno.ENOSYS, errno.EINVAL}:
            raise InstallError("install_swap_unavailable")
        raise InstallError("install_swap_failed")


def _open_relative_directory(root_fd: int, relative: str, *, error_code: str) -> int:
    descriptor = os.dup(root_fd)
    try:
        if relative == ".":
            return descriptor
        for part in _relative_name(relative).split("/"):
            next_descriptor, _item = _open_directory_at(
                descriptor, part, error_code=error_code
            )
            os.close(descriptor)
            descriptor = next_descriptor
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def _open_bound_image_root(
    parent_fd: int, name: str, identity: tuple[int, int, str], *, error_code: str
) -> tuple[int, dict[str, object], bytes]:
    """Reopen one image root only when name, inode and manifest still agree."""

    root_fd = -1
    retained = False
    try:
        root_fd, root_stat = _open_directory_at(parent_fd, name, error_code=error_code)
        if (root_stat.st_dev, root_stat.st_ino) != identity[:2]:
            raise InstallError(error_code)
        manifest, raw = _validated_manifest(root_fd, error_code=error_code)
        if hashlib.sha256(raw).hexdigest() != identity[2]:
            raise InstallError(error_code)
        _validate_manifest_tree(root_fd, manifest, raw, error_code=error_code)
        final_stat = os.fstat(root_fd)
        if (final_stat.st_dev, final_stat.st_ino) != identity[:2]:
            raise InstallError(error_code)
        retained = True
        return root_fd, manifest, raw
    finally:
        if root_fd >= 0 and not retained:
            os.close(root_fd)


def _cleanup_directory_fds(
    root_fd: int, directories: dict[str, object], *, error_code: str
) -> dict[str, int]:
    """Pin every manifest directory before destructive child operations."""

    descriptors = {".": os.dup(root_fd)}
    try:
        for relative in sorted(name for name in directories if name != "."):
            parent = relative.rsplit("/", 1)[0] if "/" in relative else "."
            base = relative.rsplit("/", 1)[-1]
            parent_fd = descriptors[parent]
            descriptor, item = _open_directory_at(
                parent_fd, base, error_code=error_code
            )
            expected = directories[relative]
            if (
                not isinstance(expected, dict)
                or item.st_uid != os.geteuid()
                or stat.S_IMODE(item.st_mode) != expected.get("mode")
                or item.st_nlink != expected.get("nlink")
            ):
                os.close(descriptor)
                raise InstallError(error_code)
            descriptors[relative] = descriptor
        return descriptors
    except Exception:
        for descriptor in descriptors.values():
            os.close(descriptor)
        raise


def _close_directory_fds(descriptors: dict[str, int]) -> None:
    for descriptor in descriptors.values():
        with contextlib.suppress(OSError):
            os.close(descriptor)


def _unlink_verified_regular_at(
    parent_fd: int,
    name: str,
    details: dict[str, object],
    *,
    max_bytes: int,
    error_code: str,
) -> None:
    """Verify the no-follow object in this exact parent FD immediately before unlink."""

    _relative_name(name)
    descriptor = -1
    try:
        named_before = os.lstat(name, dir_fd=parent_fd)
        descriptor = os.open(
            name,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
            dir_fd=parent_fd,
        )
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != os.geteuid()
            or opened.st_nlink != details.get("nlink")
            or stat.S_IMODE(opened.st_mode) != details.get("mode")
            or opened.st_size != details.get("size")
            or (
                named_before.st_dev,
                named_before.st_ino,
                named_before.st_mode,
                named_before.st_uid,
                named_before.st_nlink,
                named_before.st_size,
            )
            != (
                opened.st_dev,
                opened.st_ino,
                opened.st_mode,
                opened.st_uid,
                opened.st_nlink,
                opened.st_size,
            )
        ):
            raise InstallError(error_code)
        chunks: list[bytes] = []
        remaining = max_bytes + 1
        while remaining:
            chunk = os.read(descriptor, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        content = b"".join(chunks)
        final_stat = os.fstat(descriptor)
        named_final = os.lstat(name, dir_fd=parent_fd)
        if (
            len(content) != opened.st_size
            or len(content) > max_bytes
            or hashlib.sha256(content).hexdigest() != details.get("sha256")
            or (
                opened.st_dev,
                opened.st_ino,
                opened.st_mode,
                opened.st_uid,
                opened.st_nlink,
                opened.st_size,
            )
            != (
                final_stat.st_dev,
                final_stat.st_ino,
                final_stat.st_mode,
                final_stat.st_uid,
                final_stat.st_nlink,
                final_stat.st_size,
            )
            or (
                named_final.st_dev,
                named_final.st_ino,
                named_final.st_mode,
                named_final.st_uid,
                named_final.st_nlink,
                named_final.st_size,
            )
            != (
                opened.st_dev,
                opened.st_ino,
                opened.st_mode,
                opened.st_uid,
                opened.st_nlink,
                opened.st_size,
            )
        ):
            raise InstallError(error_code)
        os.unlink(name, dir_fd=parent_fd)
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError(error_code) from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _rmdir_bound_directory(
    parent_fd: int, name: str, directory_fd: int, *, error_code: str
) -> None:
    """Refuse to remove a name unless this parent still names the pinned directory."""

    try:
        named = os.lstat(name, dir_fd=parent_fd)
        opened = os.fstat(directory_fd)
        if (
            stat.S_ISLNK(named.st_mode)
            or not stat.S_ISDIR(named.st_mode)
            or (named.st_dev, named.st_ino) != (opened.st_dev, opened.st_ino)
        ):
            raise InstallError(error_code)
        os.rmdir(name, dir_fd=parent_fd)
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError(error_code) from exc


def _remove_validated_image(
    parent_fd: int, name: str, identity: tuple[int, int, str]
) -> None:
    if (
        _validated_image_at(parent_fd, name, error_code="install_old_image_changed")
        != identity
    ):
        raise InstallError("install_old_image_changed")
    root_fd, manifest, raw = _open_bound_image_root(
        parent_fd, name, identity, error_code="install_old_image_changed"
    )
    descriptors: dict[str, int] = {}
    try:
        files = manifest["files"]
        directories = manifest["directories"]
        assert isinstance(files, dict) and isinstance(directories, dict)
        descriptors = _cleanup_directory_fds(
            root_fd, directories, error_code="install_old_image_changed"
        )
        for relative in sorted(
            files, key=lambda item: (item.count("/"), item), reverse=True
        ):
            parent = relative.rsplit("/", 1)[0] if "/" in relative else "."
            base = relative.rsplit("/", 1)[-1]
            details = files[relative]
            if not isinstance(details, dict):
                raise InstallError("install_old_image_changed")
            _unlink_verified_regular_at(
                descriptors[parent],
                base,
                details,
                max_bytes=_MAX_SOURCE_BYTES,
                error_code="install_old_image_changed",
            )
        _unlink_verified_regular_at(
            descriptors["."],
            _MANIFEST_NAME,
            {
                "mode": 0o644,
                "nlink": 1,
                "size": len(raw),
                "sha256": identity[2],
            },
            max_bytes=_MAX_MANIFEST_BYTES,
            error_code="install_old_image_changed",
        )
        for relative in sorted(
            (item for item in directories if item != "."),
            key=lambda item: (item.count("/"), item),
            reverse=True,
        ):
            parent = relative.rsplit("/", 1)[0] if "/" in relative else "."
            _rmdir_bound_directory(
                descriptors[parent],
                relative.rsplit("/", 1)[-1],
                descriptors[relative],
                error_code="install_old_image_changed",
            )
        _rmdir_bound_directory(
            parent_fd, name, root_fd, error_code="install_old_image_changed"
        )
    finally:
        _close_directory_fds(descriptors)
        os.close(root_fd)


def _publish_runtime_image(*, stage: Path, target: Path) -> None:
    if stage.parent != target.parent or not stage.name.startswith(
        f".{_RUNTIME_ROOT_NAME}.stage."
    ):
        raise InstallError("install_stage_untrusted")
    parent_fd = _open_absolute_directory(
        target.parent, error_code="install_target_untrusted"
    )
    try:
        _validated_image_at(parent_fd, stage.name, error_code="install_stage_untrusted")
        try:
            os.lstat(target.name, dir_fd=parent_fd)
        except FileNotFoundError:
            try:
                os.rename(
                    stage.name, target.name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd
                )
            except OSError as exc:
                raise InstallError("install_swap_failed") from exc
            os.fsync(parent_fd)
            return
        previous_identity = _validated_image_at(
            parent_fd, target.name, error_code="install_target_untrusted"
        )
        _rename_exchange(parent_fd, stage.name, target.name)
        os.fsync(parent_fd)
        _remove_validated_image(parent_fd, stage.name, previous_identity)
        os.fsync(parent_fd)
    except OSError as exc:
        raise InstallError("install_swap_failed") from exc
    finally:
        os.close(parent_fd)


def _legacy_probe_payload(root_fd: int) -> dict[str, object]:
    directories: set[str] = {"."}
    files: dict[str, dict[str, object]] = {}

    def walk(directory_fd: int, prefix: str) -> None:
        scan_fd = os.dup(directory_fd)
        with os.scandir(scan_fd) as entries:
            for entry in entries:
                name = _relative_name(entry.name)
                relative = f"{prefix}/{name}" if prefix else name
                item = entry.stat(follow_symlinks=False)
                if stat.S_ISDIR(item.st_mode):
                    if (
                        stat.S_ISLNK(item.st_mode)
                        or item.st_uid != os.geteuid()
                        or stat.S_IMODE(item.st_mode) != 0o700
                    ):
                        raise InstallError("install_legacy_untrusted")
                    child_fd, _opened = _open_directory_at(
                        directory_fd, name, error_code="install_legacy_untrusted"
                    )
                    try:
                        directories.add(relative)
                        walk(child_fd, relative)
                    finally:
                        os.close(child_fd)
                    continue
                if not stat.S_ISREG(item.st_mode) or stat.S_ISLNK(item.st_mode):
                    raise InstallError("install_legacy_untrusted")
                raw, opened = _read_regular_at(
                    directory_fd,
                    name,
                    max_bytes=_MAX_SOURCE_BYTES,
                    error_code="install_legacy_untrusted",
                )
                mode = stat.S_IMODE(opened.st_mode)
                if mode not in {0o644, 0o755}:
                    raise InstallError("install_legacy_untrusted")
                files[relative] = {
                    "mode": mode,
                    "nlink": opened.st_nlink,
                    "size": opened.st_size,
                    "sha256": hashlib.sha256(raw).hexdigest(),
                }

    root = os.fstat(root_fd)
    if (
        stat.S_ISLNK(root.st_mode)
        or not stat.S_ISDIR(root.st_mode)
        or root.st_uid != os.geteuid()
        or stat.S_IMODE(root.st_mode) != 0o700
        or root.st_nlink < 2
    ):
        raise InstallError("install_legacy_untrusted")
    walk(root_fd, "")
    return {"schema_version": 1, "directories": sorted(directories), "files": files}


def _validated_legacy_probe_root(parent_fd: int, name: str) -> tuple[int, int, str]:
    root_fd = -1
    try:
        root_fd, root = _open_directory_at(
            parent_fd, name, error_code="install_legacy_untrusted"
        )
        payload = _legacy_probe_payload(root_fd)
        encoded = _canonical_json(payload)
        digest = hashlib.sha256(encoded).hexdigest()
        if (
            digest != _LEGACY_PROBE_MANIFEST_DIGEST
            or len(payload["directories"]) != 6
            or len(payload["files"]) != 143
        ):
            raise InstallError("install_legacy_untrusted")
        return root.st_dev, root.st_ino, digest
    finally:
        if root_fd >= 0:
            os.close(root_fd)


def _validated_legacy_libexec(parent_fd: int, name: str) -> tuple[int, int, str]:
    raw, item = _read_regular_at(
        parent_fd,
        name,
        max_bytes=_MAX_SOURCE_BYTES,
        error_code="install_legacy_untrusted",
    )
    if (
        stat.S_IMODE(item.st_mode) != 0o755
        or item.st_size != _LEGACY_LIBEXEC_SIZE
        or hashlib.sha256(raw).hexdigest() != _LEGACY_LIBEXEC_DIGEST
    ):
        raise InstallError("install_legacy_untrusted")
    return item.st_dev, item.st_ino, _LEGACY_LIBEXEC_DIGEST


def _validated_legacy_bin(
    parent_fd: int, name: str, *, repository: Path
) -> tuple[int, int, str]:
    try:
        item = os.lstat(name, dir_fd=parent_fd)
        target = os.readlink(name, dir_fd=parent_fd)
    except OSError as exc:
        raise InstallError("install_legacy_untrusted") from exc
    expected = os.fspath(repository / "bin" / "codex-master-mcp")
    if (
        not stat.S_ISLNK(item.st_mode)
        or item.st_uid != os.geteuid()
        or item.st_nlink != 1
        or target != expected
        or len(target) > 1024
    ):
        raise InstallError("install_legacy_untrusted")
    return item.st_dev, item.st_ino, hashlib.sha256(target.encode("utf-8")).hexdigest()


def _close_legacy_cleanup_entries(entries: tuple[_LegacyCleanupEntry, ...]) -> None:
    for entry in entries:
        if entry.root_fd is not None:
            with contextlib.suppress(OSError):
                os.close(entry.root_fd)
            entry.root_fd = None
        if entry.parent_fd >= 0:
            with contextlib.suppress(OSError):
                os.close(entry.parent_fd)
            entry.parent_fd = -1


def _preflight_legacy_paths(
    *, library: Path, libexec: Path, user_bin: Path, repository: Path
) -> tuple[_LegacyCleanupEntry, ...]:
    entries: list[_LegacyCleanupEntry] = []
    for parent, name, kind in (
        (library, "codex-master-hive-probe", "probe_root"),
        (libexec, "codex_master_hive_hourly_probe.py", "libexec"),
        (user_bin, "codex-master-mcp", "bin"),
    ):
        parent_fd = _open_absolute_directory(
            parent, error_code="install_legacy_untrusted"
        )
        try:
            try:
                os.lstat(name, dir_fd=parent_fd)
            except FileNotFoundError:
                continue
            if kind == "probe_root":
                identity = _validated_legacy_probe_root(parent_fd, name)
            elif kind == "libexec":
                identity = _validated_legacy_libexec(parent_fd, name)
            else:
                identity = _validated_legacy_bin(parent_fd, name, repository=repository)
            root_fd: int | None = None
            if kind == "probe_root":
                root_fd, root_stat = _open_directory_at(
                    parent_fd, name, error_code="install_legacy_untrusted"
                )
                if (root_stat.st_dev, root_stat.st_ino) != identity[:2]:
                    os.close(root_fd)
                    root_fd = None
                    raise InstallError("install_legacy_untrusted")
            entries.append(
                _LegacyCleanupEntry(parent_fd, name, kind, identity, root_fd)
            )
            parent_fd = -1
        except Exception:
            _close_legacy_cleanup_entries(tuple(entries))
            raise
        finally:
            if parent_fd >= 0:
                os.close(parent_fd)
    return tuple(entries)


def _open_bound_legacy_probe_root(
    parent_fd: int, name: str, identity: tuple[int, int, str], *, error_code: str
) -> int:
    root_fd = -1
    retained = False
    try:
        root_fd, root = _open_directory_at(parent_fd, name, error_code=error_code)
        if (root.st_dev, root.st_ino) != identity[:2]:
            raise InstallError(error_code)
        payload = _legacy_probe_payload(root_fd)
        digest = hashlib.sha256(_canonical_json(payload)).hexdigest()
        if digest != identity[2]:
            raise InstallError(error_code)
        retained = True
        return root_fd
    finally:
        if root_fd >= 0 and not retained:
            os.close(root_fd)


def _legacy_cleanup_directory_fds(
    root_fd: int, directories: list[object], *, error_code: str
) -> dict[str, int]:
    descriptors = {".": os.dup(root_fd)}
    try:
        names = [item for item in directories if isinstance(item, str) and item != "."]
        if len(names) != len(directories) - 1:
            raise InstallError(error_code)
        for relative in sorted(names):
            parent = relative.rsplit("/", 1)[0] if "/" in relative else "."
            descriptor, _item = _open_directory_at(
                descriptors[parent],
                relative.rsplit("/", 1)[-1],
                error_code=error_code,
            )
            descriptors[relative] = descriptor
        return descriptors
    except Exception:
        _close_directory_fds(descriptors)
        raise


def _remove_legacy_probe_root(
    parent_fd: int, name: str, identity: tuple[int, int, str], root_fd: int
) -> None:
    if _validated_legacy_probe_root(parent_fd, name) != identity:
        raise InstallError("install_legacy_cleanup_failed")
    rebound_fd = _open_bound_legacy_probe_root(
        parent_fd, name, identity, error_code="install_legacy_cleanup_failed"
    )
    os.close(rebound_fd)
    held_root = os.fstat(root_fd)
    if (held_root.st_dev, held_root.st_ino) != identity[:2]:
        raise InstallError("install_legacy_cleanup_failed")
    descriptors: dict[str, int] = {}
    try:
        payload = _legacy_probe_payload(root_fd)
        if hashlib.sha256(_canonical_json(payload)).hexdigest() != identity[2]:
            raise InstallError("install_legacy_cleanup_failed")
        files = payload["files"]
        directories = payload["directories"]
        assert isinstance(files, dict) and isinstance(directories, list)
        descriptors = _legacy_cleanup_directory_fds(
            root_fd, directories, error_code="install_legacy_cleanup_failed"
        )
        for relative in sorted(
            files, key=lambda item: (item.count("/"), item), reverse=True
        ):
            parent = relative.rsplit("/", 1)[0] if "/" in relative else "."
            base = relative.rsplit("/", 1)[-1]
            expected = files[relative]
            if not isinstance(expected, dict):
                raise InstallError("install_legacy_cleanup_failed")
            _unlink_verified_regular_at(
                descriptors[parent],
                base,
                expected,
                max_bytes=_MAX_SOURCE_BYTES,
                error_code="install_legacy_cleanup_failed",
            )
        for relative in sorted(
            (item for item in directories if item != "."),
            key=lambda item: (item.count("/"), item),
            reverse=True,
        ):
            parent = relative.rsplit("/", 1)[0] if "/" in relative else "."
            _rmdir_bound_directory(
                descriptors[parent],
                relative.rsplit("/", 1)[-1],
                descriptors[relative],
                error_code="install_legacy_cleanup_failed",
            )
        _rmdir_bound_directory(
            parent_fd, name, root_fd, error_code="install_legacy_cleanup_failed"
        )
    finally:
        _close_directory_fds(descriptors)


def _unlink_bound_legacy_path(
    parent_fd: int, name: str, identity: tuple[int, int, str], *, error_code: str
) -> None:
    try:
        named = os.lstat(name, dir_fd=parent_fd)
        if (named.st_dev, named.st_ino) != identity[:2]:
            raise InstallError(error_code)
        os.unlink(name, dir_fd=parent_fd)
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError(error_code) from exc


def _remove_preflighted_legacy(
    entries: tuple[_LegacyCleanupEntry, ...], *, repository: Path
) -> None:
    try:
        for entry in entries:
            parent_fd = entry.parent_fd
            name = entry.name
            kind = entry.kind
            identity = entry.identity
            try:
                if kind == "probe_root":
                    if entry.root_fd is None:
                        raise InstallError("install_legacy_cleanup_failed")
                    _remove_legacy_probe_root(parent_fd, name, identity, entry.root_fd)
                    continue
                current = (
                    _validated_legacy_libexec(parent_fd, name)
                    if kind == "libexec"
                    else _validated_legacy_bin(parent_fd, name, repository=repository)
                )
                if current != identity:
                    raise InstallError("install_legacy_cleanup_failed")
                _unlink_bound_legacy_path(
                    parent_fd,
                    name,
                    identity,
                    error_code="install_legacy_cleanup_failed",
                )
            except InstallError:
                raise
            except OSError as exc:
                raise InstallError("install_legacy_cleanup_failed") from exc
    finally:
        _close_legacy_cleanup_entries(entries)


def _ensure_probe_lock(state: Path) -> None:
    lock = state / ".hive-hourly-probe.lock"
    descriptor = -1
    try:
        try:
            descriptor = os.open(
                lock,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
            )
        except FileExistsError:
            descriptor = -1
        if descriptor >= 0:
            os.close(descriptor)
            descriptor = -1
        item = lock.lstat()
        if (
            stat.S_ISLNK(item.st_mode)
            or not stat.S_ISREG(item.st_mode)
            or item.st_nlink != 1
            or item.st_uid != os.geteuid()
            or stat.S_IMODE(item.st_mode) != 0o600
        ):
            raise InstallError("install_target_untrusted")
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def install(*, home: Path) -> dict[str, object]:
    if not home.is_absolute():
        raise InstallError("home_unavailable")
    _directory(home, mode=0o700, create=False)
    repository = Path(__file__).resolve().parents[1]
    library = _child_directory(home, (".local", "lib"), mode=0o700)
    libexec = _child_directory(home, (".local", "libexec"), mode=0o700)
    user_bin = _child_directory(home, (".local", "bin"), mode=0o700)
    legacy_entries = _preflight_legacy_paths(
        library=library,
        libexec=libexec,
        user_bin=user_bin,
        repository=repository,
    )
    try:
        state = _child_directory(
            home, (".local", "state", "codex-master-mcp"), mode=0o700
        )
        units = _child_directory(home, (".config", "systemd", "user"), mode=0o700)
        for name in _UNIT_NAMES:
            _install_regular(
                repository / "systemd" / "user" / name, units / name, mode=0o644
            )
        _ensure_probe_lock(state)
        stage = Path(
            tempfile.mkdtemp(prefix=f".{_RUNTIME_ROOT_NAME}.stage.", dir=library)
        )
        _build_runtime_image(repository=repository, stage=stage)
        _validate_runtime_image_stage(stage=stage, home=home)
        _publish_runtime_image(stage=stage, target=library / _RUNTIME_ROOT_NAME)
        # A failed build or exchange leaves its private stage intact.  Deleting it
        # after an interrupted exchange could delete the prevalidated old root.
        _remove_preflighted_legacy(legacy_entries, repository=repository)
        return {"status": "installed", "raw_output": "not_returned"}
    finally:
        _close_legacy_cleanup_entries(legacy_entries)


def main() -> int:
    parser = argparse.ArgumentParser(prog="codex-master-hive-hourly-probe-install")
    parser.add_argument("--home", type=Path, default=Path.home())
    arguments = parser.parse_args()
    try:
        print(json.dumps(install(home=arguments.home), sort_keys=True))
    except InstallError as exc:
        print(
            json.dumps(
                {"status": str(exc), "raw_output": "not_returned"}, sort_keys=True
            )
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
