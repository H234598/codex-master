#!/usr/bin/python3
import argparse
import ctypes
import fcntl
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import shutil
import stat
import time


ABI = "/usr/local/libexec/the-hive/hook-abi/v1/launcher"
ROOT_HOOK_ABI_PARENT = Path("/usr/local/libexec/the-hive/hook-abi")
ROOT_EFFECT_RECEIPT = "root-hook-effect-receipt-v1.json"
ROOT_OWNER_LOCK = ".root-hook-abi-owner.lock"
TRIO = {
    "launcher": ("bin/the-hive-plugin-hook-stable", 0o755),
    "companion": ("src/the_hive/hook_session_pin_store.py", 0o644),
    "core": ("src/the_hive/hook_abi_v1_core.py", 0o644),
}
HOOKS = {
    "native_bee_event": "TheHivePluginBundleV1/hooks/native_bee_event.py",
    "native_spawn_admission": "TheHivePluginBundleV1/hooks/native_spawn_admission.py",
}


class GateError(ValueError):
    pass


def _need(condition, reason="hook_abi_gate_invalid"):
    if not condition:
        raise GateError(reason)


def _sha(raw):
    return hashlib.sha256(raw).hexdigest()


def _json(raw):
    def unique(pairs):
        value = dict(pairs)
        _need(len(value) == len(pairs))
        return value

    def reject_constant(_value):
        raise GateError("hook_abi_gate_invalid")

    try:
        return json.loads(
            raw.decode("ascii"),
            object_pairs_hook=unique,
            parse_constant=reject_constant,
        )
    except (UnicodeError, ValueError, RecursionError) as exc:
        raise GateError("hook_abi_gate_invalid") from exc


def _canonical(value):
    return (
        json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
        + "\n"
    ).encode("ascii")


def _directory(fd, name, uid, gid=None, mode=None):
    child = os.open(
        name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd
    )
    item = os.fstat(child)
    if not (
        item.st_uid == uid
        and (gid is None or item.st_gid == gid)
        and (mode is None or stat.S_IMODE(item.st_mode) == mode)
        and not stat.S_IMODE(item.st_mode) & 0o022
    ):
        os.close(child)
        raise GateError("hook_abi_gate_untrusted_directory")
    return child


def _absolute(path, uid, gid=None, mode=None):
    _need(path.is_absolute() and ".." not in path.parts)
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        for part in path.parts[1:]:
            child = os.open(
                part,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=fd,
            )
            os.close(fd)
            fd = child
            ancestor = os.fstat(fd)
            _need(
                ancestor.st_uid in (0, uid)
                and (ancestor.st_uid != 0 or ancestor.st_gid == 0)
                and not stat.S_IMODE(ancestor.st_mode) & 0o022
            )
        item = os.fstat(fd)
        _need(
            item.st_uid == uid
            and (gid is None or item.st_gid == gid)
            and (mode is None or stat.S_IMODE(item.st_mode) == mode)
            and not stat.S_IMODE(item.st_mode) & 0o022
        )
        return fd
    except BaseException:
        os.close(fd)
        raise


def _read(fd, relative, uid, mode, gid=None, dir_mode=0o700):
    parts = relative.split("/")
    _need(all(part and part not in (".", "..") for part in parts))
    directory = os.dup(fd)
    try:
        for part in parts[:-1]:
            child = _directory(directory, part, uid, gid, dir_mode)
            os.close(directory)
            directory = child
        source = os.open(
            parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory
        )
        try:
            before = os.fstat(source)
            _need(
                stat.S_ISREG(before.st_mode)
                and before.st_uid == uid
                and (gid is None or before.st_gid == gid)
                and before.st_nlink == 1
                and stat.S_IMODE(before.st_mode) == mode
                and 0 < before.st_size <= 2 * 1024 * 1024
            )
            with os.fdopen(os.dup(source), "rb") as stream:
                raw = stream.read(before.st_size + 1)
            after = os.fstat(source)
            # stat_result[:7] is mode, inode, device, links, uid, gid, size.
            _need(
                len(raw) == before.st_size
                and before[:7] == after[:7]
                and before.st_mtime_ns == after.st_mtime_ns
                and before.st_ctime_ns == after.st_ctime_ns
            )
            return raw
        finally:
            os.close(source)
    finally:
        os.close(directory)


def _payload(home, uid, generation, pin):
    release_fd = _absolute(home / ".local/lib/the-hive-runtime", uid, mode=0o700)
    try:
        generations = _directory(release_fd, "generations", uid, mode=0o700)
        try:
            generation_fd = _directory(generations, generation, uid, mode=0o700)
        finally:
            os.close(generations)
        try:
            return _generation_payload(release_fd, generation_fd, uid, generation, pin)
        finally:
            os.close(generation_fd)
    finally:
        os.close(release_fd)


def _generation_payload(release_fd, generation_fd, uid, generation, pin):
    pointers = _json(_read(release_fd, ".the-hive-release-pointers.json", uid, 0o644))
    _need(
        isinstance(pointers, dict)
        and set(pointers) == {"schema_version", "current", "previous"}
        and pointers["schema_version"] == 1
        and pointers["current"] == {"generation": generation, "manifest_digest": pin}
    )
    manifest_raw = _read(generation_fd, ".the-hive-runtime-manifest.json", uid, 0o644)
    _need("sha256:" + _sha(manifest_raw) == pin, "hook_abi_gate_pin_mismatch")
    manifest = _json(manifest_raw)
    _need(
        isinstance(manifest, dict)
        and manifest.get("schema_version") == 2
        and manifest.get("generation") == generation
        and isinstance(manifest.get("files"), dict)
    )
    files = manifest["files"]

    def member(path, mode):
        entry = files.get(path)
        _need(
            isinstance(entry, dict)
            and entry.get("mode") == mode
            and entry.get("nlink") == 1
        )
        raw = _read(generation_fd, path, uid, mode)
        _need(len(raw) == entry.get("size") and _sha(raw) == entry.get("sha256"))
        return raw, "sha256:" + entry["sha256"]

    sources = {key: member(path, mode) for key, (path, mode) in TRIO.items()}
    hooks = {key: member(path, 0o644)[1] for key, path in HOOKS.items()}
    plan = {
        "schema": "RootInstallPlanV1",
        "plugin_id": "the-hive",
        "generation": generation,
        "runtime_manifest_digest": pin,
    }
    targets = {
        "launcher": ABI,
        "companion": ABI.replace("/launcher", "/hook_session_pin_store.py"),
        "core": ABI.replace("/launcher", "/hook_abi_v1_core.py"),
    }
    for key, (path, _mode) in TRIO.items():
        plan[key] = {"source": path, "target": targets[key], "sha256": sources[key][1]}
    plan_raw = _canonical(plan)
    _need(_read(generation_fd, "root-install-plan.json", uid, 0o644) == plan_raw)
    descriptor = {
        "schema": "TheHivePluginBundleV1",
        "plugin_id": "the-hive",
        "generation": generation,
        "runtime_manifest_digest": pin,
        "launcher_abi": ABI,
        "hooks": hooks,
    }
    descriptor_raw = _canonical(descriptor)
    _need(
        _read(generation_fd, "TheHivePluginBundleV1/release-binding.json", uid, 0o644)
        == descriptor_raw
    )
    allowlist = {
        "schema": "D320DispatchAllowlistV1",
        "plugin_id": "the-hive",
        "generation": generation,
        "runtime_manifest_digest": pin,
        "launcher_abi": ABI,
        "descriptor_sha256": "sha256:" + _sha(descriptor_raw),
        "root_install_plan_sha256": "sha256:" + _sha(plan_raw),
        "hooks": hooks,
    }
    return {
        "launcher": sources["launcher"][0],
        "hook_session_pin_store.py": sources["companion"][0],
        "hook_abi_v1_core.py": sources["core"][0],
        "allowlists/" + _sha(descriptor_raw) + ".json": _canonical(allowlist),
    }


def _existing(parent, payload, uid, gid, name="v1"):
    root = _directory(parent, name, uid, gid, 0o755)
    try:
        _need(
            set(os.listdir(root))
            == {
                "launcher",
                "hook_session_pin_store.py",
                "hook_abi_v1_core.py",
                "allowlists",
            }
        )
        allow = _directory(root, "allowlists", uid, gid, 0o755)
        try:
            _need(
                set(os.listdir(allow))
                == {
                    next(
                        k.split("/")[1] for k in payload if k.startswith("allowlists/")
                    )
                }
            )
        finally:
            os.close(allow)
        for path, raw in payload.items():
            _need(
                _read(
                    root, path, uid, 0o755 if path == "launcher" else 0o644, gid, 0o755
                )
                == raw
            )
    finally:
        os.close(root)


def _directory_state(fd):
    info = os.fstat(fd)
    _need(stat.S_ISDIR(info.st_mode))
    return {
        "dev": info.st_dev,
        "gid": info.st_gid,
        "ino": info.st_ino,
        "mode": stat.S_IMODE(info.st_mode),
        "uid": info.st_uid,
    }


def _file_state(root_fd, relative, uid, gid, mode, *, allow_empty=False):
    parts = relative.split("/")
    _need(all(part and part not in (".", "..") for part in parts))
    directory = os.dup(root_fd)
    try:
        for part in parts[:-1]:
            child = _directory(directory, part, uid, gid, 0o755)
            os.close(directory)
            directory = child
        descriptor = os.open(
            parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory
        )
        try:
            before = os.fstat(descriptor)
            _need(
                stat.S_ISREG(before.st_mode)
                and before.st_uid == uid
                and before.st_gid == gid
                and before.st_nlink == 1
                and stat.S_IMODE(before.st_mode) == mode
                and (before.st_size >= 0 if allow_empty else before.st_size > 0)
                and before.st_size <= 2 * 1024 * 1024,
                "hook_abi_gate_untrusted_file",
            )
            chunks = []
            remaining = before.st_size + 1
            while remaining:
                chunk = os.read(descriptor, min(65536, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
            raw = b"".join(chunks)
            after = os.fstat(descriptor)
            named = os.stat(parts[-1], dir_fd=directory, follow_symlinks=False)
            _need(
                len(raw) == before.st_size
                and before[:7] == after[:7]
                and before.st_mtime_ns == after.st_mtime_ns
                and before.st_ctime_ns == after.st_ctime_ns
                and (named.st_dev, named.st_ino) == (before.st_dev, before.st_ino),
                "hook_abi_gate_untrusted_file",
            )
            return (
                raw,
                {
                    "dev": before.st_dev,
                    "gid": before.st_gid,
                    "ino": before.st_ino,
                    "mode": stat.S_IMODE(before.st_mode),
                    "nlink": before.st_nlink,
                    "present": True,
                    "sha256": _sha(raw),
                    "size": before.st_size,
                    "uid": before.st_uid,
                },
            )
        finally:
            os.close(descriptor)
    finally:
        os.close(directory)


def _optional_file_state(parent_fd, name, uid, gid, mode, *, allow_empty=False):
    try:
        return _file_state(parent_fd, name, uid, gid, mode, allow_empty=allow_empty)[1]
    except FileNotFoundError:
        return {"present": False}


def _inspect_root_state_once(parent_path, root_uid, root_gid, *, lock_held=False):
    parent = _absolute(parent_path, root_uid, root_gid, mode=0o755)
    lock = -1
    target = -1
    try:
        parent_state = _directory_state(parent)
        try:
            names = set(os.listdir(parent))
        except OSError as exc:
            raise GateError("hook_abi_gate_snapshot_untrusted") from exc
        allowed = {
            ROOT_OWNER_LOCK,
            "v1",
            ROOT_EFFECT_RECEIPT,
            ".root-hook-abi-upgrade-v1.json",
        }
        transaction_names = {
            name
            for name in names
            if re.fullmatch(r"\.v1\.(?:stage|previous)-[0-9a-f]{32}", name)
        }
        _need(
            len(transaction_names) <= 1 and names <= allowed | transaction_names,
            "hook_abi_gate_snapshot_untrusted",
        )

        try:
            owner_lock = _optional_file_state(
                parent, ROOT_OWNER_LOCK, root_uid, root_gid, 0o644, allow_empty=True
            )
        except GateError as exc:
            raise GateError("hook_abi_gate_owner_lock_untrusted") from exc
        if owner_lock["present"]:
            lock = os.open(
                ROOT_OWNER_LOCK,
                os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=parent,
            )
            lock_info = os.fstat(lock)
            _need(
                (lock_info.st_dev, lock_info.st_ino)
                == (owner_lock["dev"], owner_lock["ino"]),
                "hook_abi_gate_snapshot_untrusted",
            )
            if not lock_held:
                try:
                    fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
                except BlockingIOError as exc:
                    raise GateError("hook_abi_gate_busy") from exc

        try:
            os.stat("v1", dir_fd=parent, follow_symlinks=False)
        except FileNotFoundError:
            target_state = {"present": False}
            receipt_state = _optional_file_state(
                parent, ROOT_EFFECT_RECEIPT, root_uid, root_gid, 0o644
            )
            upgrade_state = _optional_file_state(
                parent, ".root-hook-abi-upgrade-v1.json", root_uid, root_gid, 0o644
            )
            result = {
                "parent": parent_state,
                "owner_lock": owner_lock,
                "target": target_state,
                "receipt": receipt_state,
                "upgrade_state": upgrade_state,
            }
            if upgrade_state.get("present"):
                raw, _info = _file_state(
                    parent, ".root-hook-abi-upgrade-v1.json", root_uid, root_gid, 0o644
                )
                upgrade = _json(raw)
                _need(
                    isinstance(upgrade, dict)
                    and upgrade.get("schema") == "RootHookAbiUpgradeStateV1"
                    and upgrade.get("status") == "pending"
                    and upgrade.get("old_target") == {"present": False}
                    and upgrade.get("target", {}).get("present") is None
                    and upgrade.get("backup_name") is None
                    and upgrade.get("expected_root_state_sha256")
                    and isinstance(upgrade.get("stage_name"), str)
                    and upgrade["stage_name"] in transaction_names
                    and bool(transaction_names),
                    "hook_abi_gate_snapshot_untrusted",
                )
                stage_info = os.stat(
                    upgrade["stage_name"], dir_fd=parent, follow_symlinks=False
                )
                _need(
                    stat.S_ISDIR(stage_info.st_mode)
                    and (stage_info.st_dev, stage_info.st_ino)
                    == (upgrade["target"].get("dev"), upgrade["target"].get("ino")),
                    "hook_abi_gate_snapshot_untrusted",
                )
            else:
                _need(not transaction_names, "hook_abi_gate_snapshot_untrusted")
            return result

        target = _directory(parent, "v1", root_uid, root_gid, 0o755)
        target_state = _directory_state(target)
        target_names = set(os.listdir(target))
        _need(
            target_names
            == {
                "launcher",
                "hook_session_pin_store.py",
                "hook_abi_v1_core.py",
                "allowlists",
            },
            "hook_abi_gate_snapshot_untrusted",
        )
        allow_fd = _directory(target, "allowlists", root_uid, root_gid, 0o755)
        try:
            allow_names = sorted(os.listdir(allow_fd))
            _need(
                len(allow_names) == 1
                and re.fullmatch(r"[0-9a-f]{64}\.json", allow_names[0]) is not None,
                "hook_abi_gate_snapshot_untrusted",
            )
            allow_raw, allow_state = _file_state(
                target, "allowlists/" + allow_names[0], root_uid, root_gid, 0o644
            )
        finally:
            os.close(allow_fd)
        allowlist = _json(allow_raw)
        expected_allowlist_keys = {
            "schema",
            "plugin_id",
            "generation",
            "runtime_manifest_digest",
            "launcher_abi",
            "descriptor_sha256",
            "root_install_plan_sha256",
            "hooks",
        }
        _need(
            isinstance(allowlist, dict)
            and set(allowlist) == expected_allowlist_keys
            and allowlist["schema"] == "D320DispatchAllowlistV1"
            and allowlist["plugin_id"] == "the-hive"
            and re.fullmatch(r"[0-9a-f]{40}", allowlist["generation"]) is not None
            and re.fullmatch(
                r"sha256:[0-9a-f]{64}", allowlist["runtime_manifest_digest"]
            )
            is not None
            and allowlist["launcher_abi"] == ABI
            and allowlist["descriptor_sha256"] == "sha256:" + allow_names[0][:-5]
            and re.fullmatch(
                r"sha256:[0-9a-f]{64}", allowlist["root_install_plan_sha256"]
            )
            is not None
            and isinstance(allowlist["hooks"], dict)
            and set(allowlist["hooks"]) == set(HOOKS)
            and all(
                re.fullmatch(r"sha256:[0-9a-f]{64}", value)
                for value in allowlist["hooks"].values()
            ),
            "hook_abi_gate_snapshot_untrusted",
        )
        files = []
        for name, mode in (
            ("launcher", 0o755),
            ("hook_session_pin_store.py", 0o644),
            ("hook_abi_v1_core.py", 0o644),
        ):
            _raw, state = _file_state(target, name, root_uid, root_gid, mode)
            files.append({"path": name, **state})
        files.append({"path": "allowlists/" + allow_names[0], **allow_state})
        root_state = {
            "parent": parent_state,
            "owner_lock": owner_lock,
            "target": {
                **target_state,
                "files": sorted(files, key=lambda item: item["path"]),
            },
            "receipt": _optional_file_state(
                parent, ROOT_EFFECT_RECEIPT, root_uid, root_gid, 0o644
            ),
            "upgrade_state": _optional_file_state(
                parent, ".root-hook-abi-upgrade-v1.json", root_uid, root_gid, 0o644
            ),
            "binding": {
                "generation": allowlist["generation"],
                "manifest_digest": allowlist["runtime_manifest_digest"],
                "descriptor_sha256": allowlist["descriptor_sha256"],
            },
        }
        if transaction_names:
            upgrade_raw, _upgrade_info = _file_state(
                parent, ".root-hook-abi-upgrade-v1.json", root_uid, root_gid, 0o644
            )
            upgrade = _json(upgrade_raw)
            transaction_name = next(iter(transaction_names))
            old_target = (
                upgrade.get("old_target") if isinstance(upgrade, dict) else None
            )
            transaction_info = os.stat(
                transaction_name, dir_fd=parent, follow_symlinks=False
            )
            current_target = root_state["target"]
            transaction_identity = (transaction_info.st_dev, transaction_info.st_ino)
            target_identity = (current_target["dev"], current_target["ino"])
            state_target = (
                upgrade.get("target", {}) if isinstance(upgrade, dict) else {}
            )
            target_matches_new = target_identity == (
                state_target.get("dev"),
                state_target.get("ino"),
            )
            transaction_matches_old = (
                isinstance(old_target, dict)
                and old_target.get("present") is True
                and transaction_identity
                == (old_target.get("dev"), old_target.get("ino"))
            )
            transaction_matches_new = transaction_identity == (
                state_target.get("dev"),
                state_target.get("ino"),
            )
            target_matches_old = (
                isinstance(old_target, dict)
                and old_target.get("present") is True
                and target_identity == (old_target.get("dev"), old_target.get("ino"))
            )
            committed_backup = (
                isinstance(upgrade, dict)
                and upgrade.get("status") == "committed"
                and upgrade.get("backup_name") == transaction_name
                and target_matches_new
                and transaction_matches_old
            )
            pending_before_exchange = (
                isinstance(upgrade, dict)
                and upgrade.get("status") == "pending"
                and upgrade.get("stage_name") == transaction_name
                and transaction_matches_new
                and (target_matches_old or old_target == {"present": False})
            )
            pending_after_exchange = (
                isinstance(upgrade, dict)
                and upgrade.get("status") == "pending"
                and upgrade.get("stage_name") == transaction_name
                and target_matches_new
                and transaction_matches_old
            )
            pending_receipt_refresh = (
                isinstance(upgrade, dict)
                and upgrade.get("status") == "pending"
                and upgrade.get("stage_name") is None
                and upgrade.get("backup_name") == transaction_name
                and target_matches_new
                and transaction_matches_old
            )
            _need(
                isinstance(upgrade, dict)
                and upgrade.get("schema") == "RootHookAbiUpgradeStateV1"
                and stat.S_ISDIR(transaction_info.st_mode)
                and transaction_info.st_uid == root_uid
                and transaction_info.st_gid == root_gid
                and stat.S_IMODE(transaction_info.st_mode) == 0o755
                and (
                    committed_backup
                    or pending_before_exchange
                    or pending_after_exchange
                    or pending_receipt_refresh
                ),
                "hook_abi_gate_snapshot_untrusted",
            )
        elif root_state["upgrade_state"].get("present"):
            upgrade_raw, _upgrade_info = _file_state(
                parent, ".root-hook-abi-upgrade-v1.json", root_uid, root_gid, 0o644
            )
            upgrade = _json(upgrade_raw)
            _need(
                isinstance(upgrade, dict)
                and upgrade.get("schema") == "RootHookAbiUpgradeStateV1"
                and upgrade.get("status") in {"pending", "committed"}
                and upgrade.get("backup_name") is None
                and upgrade.get("old_target") == {"present": False},
                "hook_abi_gate_snapshot_untrusted",
            )
        return root_state
    except GateError:
        raise
    except OSError as exc:
        raise GateError("hook_abi_gate_snapshot_untrusted") from exc
    finally:
        if lock >= 0:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)
        if target >= 0:
            os.close(target)
        os.close(parent)


def _inspect_root_state(
    *, parent_path=Path("/usr/local/libexec/the-hive/hook-abi"), root_uid=0, root_gid=0
):
    first = _inspect_root_state_once(parent_path, root_uid, root_gid)
    second = _inspect_root_state_once(parent_path, root_uid, root_gid)
    _need(first == second, "hook_abi_gate_snapshot_changed")
    digest = _sha(_canonical(first))
    return {
        "schema": "RootHookAbiStateSnapshotV1",
        "status": "complete",
        "root_state": first,
        "root_state_sha256": digest,
        "mutation_performed": False,
        "raw_output": "not_returned",
    }


def _root_object(info):
    return {
        "dev": info.st_dev,
        "gid": info.st_gid,
        "ino": info.st_ino,
        "mode": stat.S_IMODE(info.st_mode),
        "uid": info.st_uid,
    }


def _root_file_object(parent, name, root_uid, root_gid, *, allow_empty=False):
    try:
        raw, state = _file_state(
            parent, name, root_uid, root_gid, 0o644, allow_empty=allow_empty
        )
    except FileNotFoundError:
        return {"present": False}
    info = os.stat(name, dir_fd=parent, follow_symlinks=False)
    return {
        "dev": info.st_dev,
        "gid": info.st_gid,
        "ino": info.st_ino,
        "mode": stat.S_IMODE(info.st_mode),
        "nlink": info.st_nlink,
        "present": True,
        "sha256": _sha(raw),
        "size": info.st_size,
        "uid": info.st_uid,
    }


def _root_install_baseline(parent, root_uid, root_gid):
    names = set(os.listdir(parent))
    allowed = {
        ROOT_OWNER_LOCK,
        "v1",
        ROOT_EFFECT_RECEIPT,
        ".root-hook-abi-upgrade-v1.json",
    }
    _need(names <= allowed, "hook_abi_gate_snapshot_untrusted")
    _need(
        "v1" not in names
        and ROOT_EFFECT_RECEIPT not in names
        and ".root-hook-abi-upgrade-v1.json" not in names,
        "hook_abi_gate_upgrade_conflict",
    )
    try:
        lock_state = _root_file_object(
            parent, ROOT_OWNER_LOCK, root_uid, root_gid, allow_empty=True
        )
    except GateError as exc:
        raise GateError("hook_abi_gate_owner_lock_untrusted") from exc
    return {
        "parent": _directory_state(parent),
        "owner_lock": lock_state,
        "target": {"present": False},
        "receipt": {"present": False},
        "upgrade_state": {"present": False},
    }


def _write_upgrade_state(parent, state, root_uid, root_gid, *, expected_info=None):
    encoded = _canonical(state)
    stage = ".root-hook-abi-upgrade-v1.stage-" + state["transaction_id"]
    descriptor = -1
    visible = False
    try:
        descriptor = os.open(
            stage,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o644,
            dir_fd=parent,
        )
        os.fchown(descriptor, root_uid, root_gid)
        os.fchmod(descriptor, 0o644)
        view = memoryview(encoded)
        while view:
            written = os.write(descriptor, view)
            _need(written > 0, "hook_abi_gate_upgrade_durability_unknown")
            view = view[written:]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        if expected_info is None:
            libc = ctypes.CDLL(None, use_errno=True)
            if libc.renameat2(
                parent,
                stage.encode(),
                parent,
                b".root-hook-abi-upgrade-v1.json",
                1,
            ):
                error = ctypes.get_errno()
                raise OSError(error, os.strerror(error))
        else:
            current = os.stat(
                ".root-hook-abi-upgrade-v1.json",
                dir_fd=parent,
                follow_symlinks=False,
            )
            _need(
                (current.st_dev, current.st_ino)
                == (expected_info.st_dev, expected_info.st_ino),
                "hook_abi_gate_upgrade_raced",
            )
            os.replace(
                stage,
                ".root-hook-abi-upgrade-v1.json",
                src_dir_fd=parent,
                dst_dir_fd=parent,
            )
        visible = True
        os.fsync(parent)
        raw, info = _file_state(
            parent,
            ".root-hook-abi-upgrade-v1.json",
            root_uid,
            root_gid,
            0o644,
        )
        _need(raw == encoded, "hook_abi_gate_upgrade_durability_unknown")
        named = os.stat(
            ".root-hook-abi-upgrade-v1.json", dir_fd=parent, follow_symlinks=False
        )
        _need(
            (named.st_dev, named.st_ino) == (info["dev"], info["ino"]),
            "hook_abi_gate_upgrade_durability_unknown",
        )
        return named
    except GateError:
        raise
    except OSError as exc:
        raise GateError("hook_abi_gate_upgrade_durability_unknown") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if not visible:
            try:
                os.unlink(stage, dir_fd=parent)
                os.fsync(parent)
            except FileNotFoundError:
                pass


def _pending_upgrade_state(
    parent,
    lock_info,
    stage_name,
    target_info,
    baseline,
    payload,
    uid,
    root_uid,
    root_gid,
    expected_root_state_sha256,
):
    allowlist = next(
        raw for name, raw in payload.items() if name.startswith("allowlists/")
    )
    values = _json(allowlist)
    transaction_id = Path(stage_name).name.rsplit("-", 1)[-1]
    return {
        "backup_name": None,
        "expected_root_state_sha256": expected_root_state_sha256,
        "generation": values["generation"],
        "manifest_digest": values["runtime_manifest_digest"],
        "old_receipt": baseline["receipt"],
        "old_target": _upgrade_target_identity(baseline["target"]),
        "owner_lock": _root_lock_object(parent, lock_info, root_uid, root_gid),
        "parent": _directory_state(parent),
        "receipt": {"present": False},
        "schema": "RootHookAbiUpgradeStateV1",
        "stage_name": stage_name,
        "status": "pending",
        "target": _root_object(target_info),
        "transaction_id": transaction_id,
    }


def _upgrade_target_identity(value):
    if "dev" not in value:
        return {"present": False}
    return {
        "dev": value["dev"],
        "gid": value["gid"],
        "ino": value["ino"],
        "mode": value["mode"],
        "present": True,
        "uid": value["uid"],
    }


def _upgrade_state_info(parent, baseline, root_uid, root_gid):
    expected = baseline["upgrade_state"]
    if expected.get("present") is not True:
        return None
    raw, state = _file_state(
        parent, ".root-hook-abi-upgrade-v1.json", root_uid, root_gid, 0o644
    )
    _need(
        all(state.get(key) == expected.get(key) for key in expected),
        "hook_abi_gate_snapshot_changed",
    )
    return os.stat(
        ".root-hook-abi-upgrade-v1.json", dir_fd=parent, follow_symlinks=False
    )


def _root_lock_object(parent, lock_info, root_uid, root_gid):
    raw, state = _file_state(
        parent, ROOT_OWNER_LOCK, root_uid, root_gid, 0o644, allow_empty=True
    )
    _need(
        (state["dev"], state["ino"]) == (lock_info.st_dev, lock_info.st_ino),
        "hook_abi_gate_owner_lock_untrusted",
    )
    return {
        key: state[key]
        for key in ("dev", "gid", "ino", "mode", "nlink", "sha256", "size", "uid")
    }


def _committed_upgrade_state(parent, lock_info, pending, root_uid, root_gid):
    target_fd = os.open(
        "v1", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent
    )
    try:
        target_info = os.fstat(target_fd)
    finally:
        os.close(target_fd)
    receipt_raw, receipt_state = _file_state(
        parent, ROOT_EFFECT_RECEIPT, root_uid, root_gid, 0o644
    )
    backup_name = pending["stage_name"] or pending["backup_name"]
    if pending["old_target"].get("present"):
        backup = os.stat(backup_name, dir_fd=parent, follow_symlinks=False)
        _need(
            stat.S_ISDIR(backup.st_mode)
            and (backup.st_dev, backup.st_ino)
            == (pending["old_target"]["dev"], pending["old_target"]["ino"]),
            "hook_abi_gate_upgrade_durability_unknown",
        )
    else:
        backup_name = None
    return {
        **pending,
        "backup_name": backup_name,
        "owner_lock": _root_lock_object(parent, lock_info, root_uid, root_gid),
        "receipt": {
            key: receipt_state[key]
            for key in ("dev", "gid", "ino", "mode", "nlink", "sha256", "size", "uid")
        },
        "stage_name": None,
        "status": "committed",
        "target": _root_object(target_info),
    }


def _receipt_payload(payload, uid, generation, pin, root_uid, issued_at_unix_ns):
    files = {}
    for name, raw in payload.items():
        mode = 0o755 if name == "launcher" else 0o644
        files[name] = {
            "mode": mode,
            "nlink": 1,
            "sha256": _sha(raw),
            "size": len(raw),
        }
    return {
        "effect": "root_hook_abi_verified_present",
        "files": files,
        "generation": generation,
        "issued_at_unix_ns": issued_at_unix_ns,
        "manifest_digest": pin,
        "owner": "root_hook_abi_v1",
        "root_uid": root_uid,
        "schema_version": 1,
        "source_uid": uid,
        "target": ABI.rsplit("/", 1)[0],
    }


def _receipt_needs_refresh(parent, root_uid, root_gid):
    raw, _state = _file_state(parent, ROOT_EFFECT_RECEIPT, root_uid, root_gid, 0o644)
    receipt = _json(raw)
    _need(
        isinstance(receipt, dict)
        and type(receipt.get("issued_at_unix_ns")) is int
        and receipt["issued_at_unix_ns"] > 0,
        "hook_abi_gate_receipt_conflict",
    )
    now = time.time_ns()
    issued = receipt["issued_at_unix_ns"]
    return issued > now or now >= issued + 3_600_000_000_000


def _identity_matches(info, expected):
    return all(
        getattr(info, attr) == expected.get(key)
        for attr, key in (
            ("st_dev", "dev"),
            ("st_ino", "ino"),
            ("st_uid", "uid"),
            ("st_gid", "gid"),
        )
    ) and stat.S_IMODE(info.st_mode) == expected.get("mode")


def _resume_pending_upgrade(parent, pending_state, payload, uid, gid):
    stage_name = pending_state.get("stage_name")
    transaction_name = stage_name or pending_state.get("backup_name")
    old_target = pending_state["old_target"]
    target = pending_state["target"]
    try:
        current = os.stat("v1", dir_fd=parent, follow_symlinks=False)
        current_exists = True
    except FileNotFoundError:
        current = None
        current_exists = False
    try:
        stage = (
            os.stat(transaction_name, dir_fd=parent, follow_symlinks=False)
            if transaction_name
            else None
        )
    except FileNotFoundError:
        stage = None
    if current_exists and _identity_matches(current, target):
        _existing(parent, payload, uid, gid)
        if old_target.get("present"):
            _need(
                stage is not None and _identity_matches(stage, old_target),
                "hook_abi_gate_upgrade_conflict",
            )
        else:
            _need(stage is None, "hook_abi_gate_upgrade_conflict")
        target_fd = -1
        try:
            target_fd = os.open(
                "v1",
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=parent,
            )
            target_info = os.fstat(target_fd)
            _need(
                _identity_matches(target_info, target),
                "hook_abi_gate_upgrade_durability_unknown",
            )
            os.fsync(target_fd)
            os.fsync(parent)
        except OSError as exc:
            raise GateError("hook_abi_gate_upgrade_durability_unknown") from exc
        finally:
            if target_fd >= 0:
                os.close(target_fd)
        return
    _need(
        stage is not None and _identity_matches(stage, target),
        "hook_abi_gate_upgrade_conflict",
    )
    _need(stage_name is not None, "hook_abi_gate_upgrade_conflict")
    _existing(parent, payload, uid, gid, stage_name)
    if old_target.get("present"):
        _need(
            current_exists and _identity_matches(current, old_target),
            "hook_abi_gate_upgrade_conflict",
        )
        flag = 2
    else:
        _need(not current_exists, "hook_abi_gate_upgrade_conflict")
        flag = 1
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.renameat2(parent, stage_name.encode(), parent, b"v1", flag):
        error = ctypes.get_errno()
        raise GateError("hook_abi_gate_upgrade_durability_unknown") from OSError(
            error, os.strerror(error)
        )
    os.fsync(parent)
    published = os.stat("v1", dir_fd=parent, follow_symlinks=False)
    _need(
        _identity_matches(published, target), "hook_abi_gate_upgrade_durability_unknown"
    )


def _open_owner_lock(parent, root_uid, root_gid, *, return_created=False):
    created = False
    try:
        descriptor = os.open(
            ROOT_OWNER_LOCK,
            os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o644,
            dir_fd=parent,
        )
        created = True
    except FileExistsError:
        descriptor = os.open(
            ROOT_OWNER_LOCK,
            os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
    try:
        if created:
            os.fchmod(descriptor, 0o644)
        info = os.fstat(descriptor)
        _need(
            stat.S_ISREG(info.st_mode)
            and info.st_uid == root_uid
            and info.st_gid == root_gid
            and info.st_nlink == 1
            and stat.S_IMODE(info.st_mode) == 0o644,
            "hook_abi_gate_owner_lock_untrusted",
        )
        if created:
            os.fsync(descriptor)
            os.fsync(parent)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise GateError("hook_abi_gate_busy") from exc
        return (descriptor, created) if return_created else descriptor
    except OSError as exc:
        os.close(descriptor)
        raise GateError("hook_abi_gate_lock_durability_unknown") from exc
    except BaseException:
        os.close(descriptor)
        raise


def _write_effect_receipt(
    parent,
    payload,
    uid,
    generation,
    pin,
    root_uid,
    root_gid,
    *,
    expected_old_receipt=None,
):
    issued_at_unix_ns = time.time_ns()
    value = _receipt_payload(payload, uid, generation, pin, root_uid, issued_at_unix_ns)
    encoded = _canonical(value)
    existing = None
    existing_info = None
    try:
        descriptor = os.open(
            ROOT_EFFECT_RECEIPT,
            os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
    except FileNotFoundError:
        pass
    else:
        try:
            existing_info = os.fstat(descriptor)
            _need(
                stat.S_ISREG(existing_info.st_mode)
                and existing_info.st_uid == root_uid
                and existing_info.st_gid == root_gid
                and existing_info.st_nlink == 1
                and stat.S_IMODE(existing_info.st_mode) == 0o644
                and 0 < existing_info.st_size <= 65536,
                "hook_abi_gate_receipt_untrusted",
            )
            chunks = []
            remaining = existing_info.st_size + 1
            while remaining:
                chunk = os.read(descriptor, min(65536, remaining))
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
            raw = b"".join(chunks)
            after = os.fstat(descriptor)
            _need(
                len(raw) == existing_info.st_size
                and existing_info[:7] == after[:7]
                and existing_info.st_mtime_ns == after.st_mtime_ns
                and existing_info.st_ctime_ns == after.st_ctime_ns,
                "hook_abi_gate_receipt_untrusted",
            )
            existing = _json(raw)
        finally:
            os.close(descriptor)
        semantic_match = (
            isinstance(existing, dict)
            and set(existing) == set(value)
            and {
                key: item
                for key, item in existing.items()
                if key != "issued_at_unix_ns"
            }
            == {key: item for key, item in value.items() if key != "issued_at_unix_ns"}
            and type(existing.get("issued_at_unix_ns")) is int
            and existing["issued_at_unix_ns"] > 0
        )
        if semantic_match:
            issued = existing["issued_at_unix_ns"]
            if issued <= time.time_ns() < issued + 3_600_000_000_000:
                descriptor = -1
                try:
                    descriptor = os.open(
                        ROOT_EFFECT_RECEIPT,
                        os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC,
                        dir_fd=parent,
                    )
                    current = os.fstat(descriptor)
                    _need(
                        (current.st_dev, current.st_ino)
                        == (existing_info.st_dev, existing_info.st_ino),
                        "hook_abi_gate_receipt_raced",
                    )
                    os.fsync(descriptor)
                    named = os.stat(
                        ROOT_EFFECT_RECEIPT,
                        dir_fd=parent,
                        follow_symlinks=False,
                    )
                    _need(
                        (named.st_dev, named.st_ino)
                        == (current.st_dev, current.st_ino),
                        "hook_abi_gate_receipt_raced",
                    )
                    os.fsync(parent)
                except OSError as exc:
                    raise GateError("hook_abi_gate_receipt_durability_unknown") from exc
                finally:
                    if descriptor >= 0:
                        os.close(descriptor)
                return existing_info
        else:
            _need(expected_old_receipt is not None, "hook_abi_gate_receipt_conflict")
        if expected_old_receipt is None:
            raise GateError("hook_abi_gate_receipt_conflict")
        _need(
            isinstance(expected_old_receipt, dict)
            and expected_old_receipt.get("present") is True
            and (existing_info.st_dev, existing_info.st_ino, _sha(raw))
            == (
                expected_old_receipt.get("dev"),
                expected_old_receipt.get("ino"),
                expected_old_receipt.get("sha256"),
            ),
            "hook_abi_gate_receipt_raced",
        )

    stage = f".{ROOT_EFFECT_RECEIPT}.{os.urandom(16).hex()}"
    descriptor = -1
    visible = False
    try:
        descriptor = os.open(
            stage,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o644,
            dir_fd=parent,
        )
        os.fchmod(descriptor, 0o644)
        view = memoryview(encoded)
        while view:
            view = view[os.write(descriptor, view) :]
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        if existing_info is None:
            libc = ctypes.CDLL(None, use_errno=True)
            if libc.renameat2(
                parent, stage.encode(), parent, ROOT_EFFECT_RECEIPT.encode(), 1
            ):
                error = ctypes.get_errno()
                raise OSError(error, os.strerror(error))
        else:
            current = os.stat(ROOT_EFFECT_RECEIPT, dir_fd=parent, follow_symlinks=False)
            _need(
                (current.st_dev, current.st_ino)
                == (existing_info.st_dev, existing_info.st_ino),
                "hook_abi_gate_receipt_raced",
            )
            os.replace(
                stage,
                ROOT_EFFECT_RECEIPT,
                src_dir_fd=parent,
                dst_dir_fd=parent,
            )
        visible = True
        os.fsync(parent)
    except GateError:
        raise
    except OSError as exc:
        raise GateError("hook_abi_gate_receipt_durability_unknown") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if not visible:
            try:
                os.unlink(stage, dir_fd=parent)
                os.fsync(parent)
            except FileNotFoundError:
                pass


def _publish(parent, payload, uid, gid, verify, *, before_publish=None, exchange=False):
    _need(
        not any(name.startswith(".v1.stage-") for name in os.listdir(parent)),
        "hook_abi_gate_stale_stage_hold",
    )
    name = (".v1.previous-" if exchange else ".v1.stage-") + os.urandom(16).hex()
    os.mkdir(name, 0o700, dir_fd=parent)
    visible = False
    reserved = False
    try:
        root = _directory(parent, name, uid, gid, 0o700)
        try:
            os.mkdir("allowlists", 0o755, dir_fd=root)
            allow = _directory(root, "allowlists", uid, gid)
            try:
                os.fchmod(allow, 0o755)
                for path, raw in payload.items():
                    directory = allow if path.startswith("allowlists/") else root
                    target = path.split("/")[-1]
                    fd = os.open(
                        target,
                        os.O_WRONLY
                        | os.O_CREAT
                        | os.O_EXCL
                        | os.O_NOFOLLOW
                        | os.O_CLOEXEC,
                        0o755 if path == "launcher" else 0o644,
                        dir_fd=directory,
                    )
                    try:
                        os.fchown(fd, uid, gid)
                        os.fchmod(fd, 0o755 if path == "launcher" else 0o644)
                        view = memoryview(raw)
                        while view:
                            view = view[os.write(fd, view) :]
                        os.fsync(fd)
                    finally:
                        os.close(fd)
                os.fsync(allow)
            finally:
                os.close(allow)
            os.fchmod(root, 0o755)
            os.fsync(root)
        finally:
            os.close(root)
        _existing(parent, payload, uid, gid, name)
        _need(verify() == payload, "hook_abi_gate_source_changed")
        if before_publish is not None:
            reserved = True
            before_publish(name, os.stat(name, dir_fd=parent, follow_symlinks=False))
        libc = ctypes.CDLL(None, use_errno=True)
        if libc.renameat2(parent, name.encode(), parent, b"v1", 2 if exchange else 1):
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error))
        visible = True
        try:
            os.fsync(parent)
        except OSError as exc:
            raise GateError("hook_abi_gate_publish_durability_unknown") from exc
    finally:
        if not visible and not reserved:
            candidate = Path(f"/proc/self/fd/{parent}") / name
            if candidate.is_dir() and not candidate.is_symlink():
                shutil.rmtree(candidate)


def install(
    home,
    uid,
    generation,
    pin,
    *,
    parent_path=Path("/usr/local/libexec/the-hive/hook-abi"),
    root_uid=0,
    root_gid=0,
    expected_root_state_sha256=None,
):
    _need(
        isinstance(uid, int)
        and uid > 0
        and re.fullmatch("[0-9a-f]{40}", generation) is not None
        and re.fullmatch("sha256:[0-9a-f]{64}", pin) is not None
    )
    parent = _absolute(parent_path, root_uid, root_gid, mode=0o755)
    lock = -1
    try:
        payload = _payload(home, uid, generation, pin)
        snapshot = _inspect_root_state_once(parent_path, root_uid, root_gid)
        _need(
            isinstance(expected_root_state_sha256, str)
            and re.fullmatch(r"[0-9a-f]{64}", expected_root_state_sha256) is not None,
            "hook_abi_gate_snapshot_changed",
        )
        pending_state = None
        if snapshot["upgrade_state"].get("present"):
            raw, _state_info = _file_state(
                parent, ".root-hook-abi-upgrade-v1.json", root_uid, root_gid, 0o644
            )
            candidate_state = _json(raw)
            if (
                isinstance(candidate_state, dict)
                and candidate_state.get("status") == "pending"
            ):
                _need(
                    candidate_state.get("expected_root_state_sha256")
                    == expected_root_state_sha256,
                    "hook_abi_gate_snapshot_changed",
                )
                pending_state = candidate_state
            else:
                _need(
                    _sha(_canonical(snapshot)) == expected_root_state_sha256,
                    "hook_abi_gate_snapshot_changed",
                )
        else:
            _need(
                _sha(_canonical(snapshot)) == expected_root_state_sha256,
                "hook_abi_gate_snapshot_changed",
            )
        try:
            os.stat("v1", dir_fd=parent, follow_symlinks=False)
            target_exists = True
        except FileNotFoundError:
            target_exists = False
        lock, lock_created = _open_owner_lock(
            parent, root_uid, root_gid, return_created=True
        )
        lock_info = os.fstat(lock)
        baseline = _inspect_root_state_once(
            parent_path, root_uid, root_gid, lock_held=True
        )
        if not target_exists and pending_state is None:
            baseline = _root_install_baseline(parent, root_uid, root_gid)
        comparable = dict(baseline)
        if lock_created and snapshot["owner_lock"].get("present") is not True:
            comparable["owner_lock"] = snapshot["owner_lock"]
        _need(comparable == snapshot, "hook_abi_gate_snapshot_changed")
        pending = None
        if pending_state is not None:
            _need(
                pending_state.get("generation") == generation
                and pending_state.get("manifest_digest") == pin,
                "hook_abi_gate_upgrade_conflict",
            )
            pending = {
                "state": pending_state,
                "info": _upgrade_state_info(parent, baseline, root_uid, root_gid),
            }
            _resume_pending_upgrade(parent, pending_state, payload, root_uid, root_gid)
        try:
            fresh_payload = _payload(home, uid, generation, pin)
        except GateError:
            raise
        if fresh_payload != payload:
            raise GateError("hook_abi_gate_source_changed")
        try:
            os.stat("v1", dir_fd=parent, follow_symlinks=False)
            target_exists_now = True
        except FileNotFoundError:
            target_exists_now = False
        if pending is not None:
            result = "already_installed"
        elif not target_exists_now:
            pending = {}

            def reserve_upgrade(stage_name, stage_info):
                state = _pending_upgrade_state(
                    parent,
                    lock_info,
                    stage_name,
                    stage_info,
                    baseline,
                    payload,
                    uid,
                    root_uid,
                    root_gid,
                    expected_root_state_sha256,
                )
                pending["info"] = _write_upgrade_state(
                    parent,
                    state,
                    root_uid,
                    root_gid,
                    expected_info=_upgrade_state_info(
                        parent, baseline, root_uid, root_gid
                    ),
                )
                pending["state"] = state

            _publish(
                parent,
                payload,
                root_uid,
                root_gid,
                lambda: _payload(home, uid, generation, pin),
                before_publish=reserve_upgrade,
            )
            result = "installed"
        else:
            if (
                baseline["binding"]["generation"] == generation
                and baseline["binding"]["manifest_digest"] == pin
            ):
                _existing(parent, payload, root_uid, root_gid)
                result = "already_installed"
                if _receipt_needs_refresh(parent, root_uid, root_gid):
                    marker_raw, _marker_state = _file_state(
                        parent,
                        ".root-hook-abi-upgrade-v1.json",
                        root_uid,
                        root_gid,
                        0o644,
                    )
                    committed = _json(marker_raw)
                    _need(
                        isinstance(committed, dict)
                        and committed.get("schema") == "RootHookAbiUpgradeStateV1"
                        and committed.get("status") == "committed"
                        and committed.get("generation") == generation
                        and committed.get("manifest_digest") == pin,
                        "hook_abi_gate_upgrade_conflict",
                    )
                    pending_state = {
                        **committed,
                        "expected_root_state_sha256": expected_root_state_sha256,
                        "old_receipt": baseline["receipt"],
                        "stage_name": None,
                        "status": "pending",
                        "transaction_id": os.urandom(16).hex(),
                    }
                    pending = {
                        "state": pending_state,
                        "info": _write_upgrade_state(
                            parent,
                            pending_state,
                            root_uid,
                            root_gid,
                            expected_info=_upgrade_state_info(
                                parent, baseline, root_uid, root_gid
                            ),
                        ),
                    }
            else:
                pending = {}

                def reserve_upgrade(stage_name, stage_info):
                    state = _pending_upgrade_state(
                        parent,
                        lock_info,
                        stage_name,
                        stage_info,
                        baseline,
                        payload,
                        uid,
                        root_uid,
                        root_gid,
                        expected_root_state_sha256,
                    )
                    pending["info"] = _write_upgrade_state(
                        parent,
                        state,
                        root_uid,
                        root_gid,
                        expected_info=_upgrade_state_info(
                            parent, baseline, root_uid, root_gid
                        ),
                    )
                    pending["state"] = state

                _publish(
                    parent,
                    payload,
                    root_uid,
                    root_gid,
                    lambda: _payload(home, uid, generation, pin),
                    before_publish=reserve_upgrade,
                    exchange=True,
                )
                result = "upgraded"
        _existing(parent, payload, root_uid, root_gid)
        old_receipt = (
            pending_state.get("old_receipt") if pending_state is not None else None
        )
        if old_receipt is None and pending is not None:
            old_receipt = pending["state"].get("old_receipt")
        if isinstance(old_receipt, dict) and old_receipt.get("present") is True:
            _write_effect_receipt(
                parent,
                payload,
                uid,
                generation,
                pin,
                root_uid,
                root_gid,
                expected_old_receipt=old_receipt,
            )
        else:
            _write_effect_receipt(
                parent, payload, uid, generation, pin, root_uid, root_gid
            )
        if result in {"installed", "upgraded"} or pending is not None:
            committed = _committed_upgrade_state(
                parent, lock_info, pending["state"], root_uid, root_gid
            )
            _write_upgrade_state(
                parent,
                committed,
                root_uid,
                root_gid,
                expected_info=pending["info"],
            )
        return result
    finally:
        if lock >= 0:
            try:
                fcntl.flock(lock, fcntl.LOCK_UN)
            finally:
                os.close(lock)
        os.close(parent)


def main():
    parser = argparse.ArgumentParser()
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--inspect-root-state", action="store_true")
    parser.add_argument("--expected-root-state-sha256")
    parser.add_argument("--uid", type=int)
    parser.add_argument("--generation")
    parser.add_argument("--manifest-sha256")
    args = parser.parse_args()
    try:
        _need(os.geteuid() == 0 and os.getegid() == 0, "hook_abi_gate_root_required")
        if args.inspect_root_state:
            _need(
                args.uid is None
                and args.generation is None
                and args.manifest_sha256 is None
                and args.expected_root_state_sha256 is None,
                "hook_abi_gate_invalid_arguments",
            )
            result = _inspect_root_state(
                parent_path=ROOT_HOOK_ABI_PARENT, root_uid=0, root_gid=0
            )
            print(json.dumps(result, sort_keys=True, separators=(",", ":")))
            return 0
        _need(
            isinstance(args.uid, int)
            and isinstance(args.generation, str)
            and isinstance(args.manifest_sha256, str),
            "hook_abi_gate_invalid_arguments",
        )
        home = Path(pwd.getpwuid(args.uid).pw_dir)
        status = install(
            home,
            args.uid,
            args.generation,
            args.manifest_sha256,
            expected_root_state_sha256=args.expected_root_state_sha256,
        )
    except (GateError, OSError, KeyError) as exc:
        print(json.dumps({"status": str(exc)}))
        return 1
    print(json.dumps({"status": status}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
