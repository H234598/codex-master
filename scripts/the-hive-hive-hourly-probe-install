class InstallError(Exception):
    pass


def _directory(path: Path, *, mode: int, create: bool) -> None:
    try:
        item = path.lstat()
    except FileNotFoundError:
        if not create:
            raise InstallError("home_unavailable") from None
        path.mkdir(mode=mode)
        item = path.lstat()
    except OSError as exc:
        raise InstallError("install_path_untrusted") from exc
    if (
        stat.S_ISLNK(item.st_mode)
        or not stat.S_ISDIR(item.st_mode)
        or item.st_uid != os.geteuid()
        or stat.S_IMODE(item.st_mode) & 0o022
    ):
        raise InstallError("install_path_untrusted")


def _child_directory(home: Path, parts: tuple[str, ...], *, mode: int) -> Path:
    current = home
    for part in parts:
        current /= part
        _directory(current, mode=mode, create=True)
    try:
        os.chmod(current, mode)
    except OSError as exc:
        raise InstallError("install_path_untrusted") from exc
    return current


def _source_bytes(path: Path) -> bytes:
    """Read one bounded, own regular source through a no-follow descriptor."""

    descriptor = -1
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0),
        )
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != os.geteuid()
            or stat.S_IMODE(before.st_mode) & 0o022
            or before.st_size <= 0
            or before.st_size > _MAX_SOURCE_BYTES
        ):
            raise InstallError("install_source_untrusted")
        chunks: list[bytes] = []
        remaining = _MAX_SOURCE_BYTES + 1
        while remaining:
            chunk = os.read(descriptor, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        after = os.fstat(descriptor)
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError("install_source_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if (
        not data
        or len(data) > _MAX_SOURCE_BYTES
        or (
            before.st_dev,
            before.st_ino,
            before.st_mode,
            before.st_uid,
            before.st_nlink,
            before.st_size,
        )
        != (
            after.st_dev,
            after.st_ino,
            after.st_mode,
            after.st_uid,
            after.st_nlink,
            after.st_size,
        )
    ):
        raise InstallError("install_source_untrusted")
    return data


def _source_directory(path: Path) -> None:
    try:
        item = path.lstat()
    except OSError as exc:
        raise InstallError("install_source_untrusted") from exc
    if (
        stat.S_ISLNK(item.st_mode)
        or not stat.S_ISDIR(item.st_mode)
        or item.st_uid != os.geteuid()
        or stat.S_IMODE(item.st_mode) & 0o022
    ):
        raise InstallError("install_source_untrusted")


def _install_regular(source: Path, target: Path, *, mode: int) -> None:
    content = _source_bytes(source)
    try:
        existing = target.lstat()
    except FileNotFoundError:
        existing = None
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    if existing is not None and (
        stat.S_ISLNK(existing.st_mode) or not stat.S_ISREG(existing.st_mode)
    ):
        raise InstallError("install_target_untrusted")
    descriptor = -1
    temporary = Path()
    try:
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=f".{target.name}.", dir=target.parent
        )
        temporary = Path(temporary_name)
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, target)
        temporary = Path()
        installed = target.lstat()
        if (
            stat.S_ISLNK(installed.st_mode)
            or not stat.S_ISREG(installed.st_mode)
            or installed.st_nlink != 1
            or installed.st_uid != os.geteuid()
            or stat.S_IMODE(installed.st_mode) != mode
        ):
            raise InstallError("install_target_untrusted")
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _install_attested_bytes(target: Path, content: bytes, *, mode: int) -> None:
    """Atomically materialize only bytes already read from one release manifest."""

    if not content:
        raise InstallError("install_target_untrusted")
    try:
        existing = target.lstat()
    except FileNotFoundError:
        existing = None
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    if existing is not None and (
        stat.S_ISLNK(existing.st_mode) or not stat.S_ISREG(existing.st_mode)
    ):
        raise InstallError("install_target_untrusted")
    descriptor = -1
    temporary = Path()
    try:
        descriptor, name = tempfile.mkstemp(
            prefix=f".{target.name}.", dir=target.parent
        )
        temporary = Path(name)
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, target)
        temporary = Path()
        installed = target.lstat()
        if (
            stat.S_ISLNK(installed.st_mode)
            or not stat.S_ISREG(installed.st_mode)
            or installed.st_nlink != 1
            or installed.st_uid != os.geteuid()
            or stat.S_IMODE(installed.st_mode) != mode
            or _source_bytes(target) != content
        ):
            raise InstallError("install_target_untrusted")
        _fsync_directory(target.parent)
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary != Path():
            try:
                temporary.unlink()
            except FileNotFoundError:
                pass
            except OSError:
                pass


def _install_tree(source_root: Path, target_root: Path) -> None:
    _source_directory(source_root)
    copied = 0
    for directory, child_directories, file_names in os.walk(source_root):
        current = Path(directory)
        _source_directory(current)
        relative_directory = current.relative_to(source_root)
        _child_directory(target_root, tuple(relative_directory.parts), mode=0o700)
        for name in child_directories:
            _source_directory(current / name)
        child_directories[:] = [
            name for name in child_directories if name != "__pycache__"
        ]
        for name in sorted(file_names):
            source = current / name
            target = target_root / relative_directory / name
            _install_regular(source, target, mode=0o644)
            copied += 1
    if copied == 0:
        raise InstallError("install_source_untrusted")


def _fsync_directory(path: Path) -> None:
    descriptor = -1
    try:
        descriptor = os.open(
            path,
            os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0),
        )
        os.fsync(descriptor)
    except OSError as exc:
        raise InstallError("install_fsync_failed") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _fsync_tree(root: Path) -> None:
    for directory, _child_directories, file_names in os.walk(root, topdown=False):
        current = Path(directory)
        _source_directory(current)
        for name in file_names:
            if not _source_bytes(current / name):
                raise InstallError("install_target_untrusted")
        _fsync_directory(current)


def _compile_runtime_spawn_helper(*, stage: Path) -> None:
    """Build the Linux/glibc spawn ABI helper inside the unpublished image."""

    source = stage / _RUNTIME_SPAWN_HELPER_SOURCE
    library = stage / _RUNTIME_SPAWN_HELPER_LIBRARY
    try:
        completed = subprocess.run(
            [
                "/usr/bin/cc",
                "-std=c11",
                "-D_GNU_SOURCE",
                "-fPIC",
                "-shared",
                "-Werror",
                "-Wall",
                "-Wextra",
                "-o",
                os.fspath(library),
                os.fspath(source),
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env={"LANG": "C.UTF-8", "PATH": "/usr/bin:/bin"},
        )
        if completed.returncode != 0:
            raise InstallError("install_runtime_helper_unavailable")
        os.chmod(library, 0o755)
    except (OSError, subprocess.SubprocessError) as exc:
        raise InstallError("install_runtime_helper_unavailable") from exc


def _build_runtime_image(
    *,
    repository: Path,
    stage: Path,
    generation: str = _R2_BASE_COMMIT,
    commit: str = _R2_BASE_COMMIT,
) -> None:
    _directory(stage, mode=0o700, create=False)
    for source_name, target_name, mode in _RUNTIME_IMAGE_FILES:
        target = stage / target_name
        _child_directory(
            stage, tuple(target.parent.relative_to(stage).parts), mode=0o700
        )
        _install_regular(repository / source_name, target, mode=mode)
    for source_name, target_name in _RUNTIME_IMAGE_TREES:
        target = stage / target_name
        _child_directory(stage, tuple(target.relative_to(stage).parts), mode=0o700)
        _install_tree(repository / source_name, target)
    _compile_runtime_spawn_helper(stage=stage)
    _write_runtime_image_manifest(root=stage, generation=generation, commit=commit)
    _fsync_tree(stage)


def _verified_release_commit(repository: Path) -> str:
    """Read only a clean R2-base-descended checkout identity for a real publish."""

    command_env = {"LANG": "C.UTF-8", "PATH": "/usr/bin:/bin"}
    try:
        status = subprocess.run(
            ["git", "-C", os.fspath(repository), "status", "--porcelain=v1", "-z"],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=command_env,
        )
        head = subprocess.run(
            [
                "git",
                "-C",
                os.fspath(repository),
                "rev-parse",
                "--verify",
                "HEAD^{commit}",
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=command_env,
        )
        if status.returncode != 0 or status.stdout or head.returncode != 0:
            raise InstallError("install_release_checkout_dirty")
        commit = head.stdout.decode("ascii").strip()
        ancestor = subprocess.run(
            [
                "git",
                "-C",
                os.fspath(repository),
                "merge-base",
                "--is-ancestor",
                _R2_BASE_COMMIT,
                commit,
            ],
            check=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=command_env,
        )
    except (OSError, UnicodeError) as exc:
        raise InstallError("install_release_checkout_dirty") from exc
    if ancestor.returncode != 0:
        raise InstallError("install_release_checkout_not_r2_base_descended")
    _release_metadata(generation=commit, commit=commit)
    return commit


def _validate_runtime_image_stage(*, stage: Path, home: Path) -> None:
    """Exercise the three v2 diagnostics from the isolated, complete stage."""

    try:
        layout = RuntimeLayout.from_runtime_root(stage)
        layout.read_attested_file("src/the_hive/server.py")
    except ValueError as exc:
        raise InstallError("install_stage_validation_failed") from exc
    stage_server = (
        "import runpy, sys\n"
        "from pathlib import Path\n"
        "root = Path(sys.argv[1])\n"
        "sys.path.insert(0, str(root / 'src'))\n"
        "sys.argv = [str(root / 'src' / 'the_hive' / 'server.py'), *sys.argv[2:]]\n"
        "runpy.run_module('the_hive.server', run_name='__main__', alter_sys=True)\n"
    )
    try:
        mcp = run_bounded(
            [
                "/usr/bin/python3",
                "-I",
                "-B",
                "-c",
                stage_server,
                os.fspath(stage),
                "--runtime-status-mcp",
            ],
            cwd=stage,
            home=home,
            timeout_seconds=hourly_probe.HIVE_DIAGNOSTIC_TIMEOUT_SECONDS,
            stdout_limit=_MAX_STAGE_DIAGNOSTIC_BYTES,
            stderr_limit=DEFAULT_STDERR_LIMIT,
            input_data=_probe_payload(),
            runtime_layout=layout,
        )
    except BoundedProcessError as exc:
        raise InstallError("install_stage_validation_failed") from exc
    if _mcp_surface(mcp.returncode, mcp.stdout).get("ok") is not True:
        raise InstallError("install_stage_validation_failed")
    for hive_command in ("status", "doctor"):
        try:
            completed = run_bounded(
                [
                    "/usr/bin/python3",
                    "-I",
                    "-B",
                    "-c",
                    stage_server,
                    os.fspath(stage),
                    "hive",
                    hive_command,
                ],
                cwd=stage,
                home=home,
                timeout_seconds=hourly_probe.HIVE_DIAGNOSTIC_TIMEOUT_SECONDS,
                stdout_limit=_MAX_STAGE_DIAGNOSTIC_BYTES,
                stderr_limit=DEFAULT_STDERR_LIMIT,
                runtime_layout=layout,
            )
        except BoundedProcessError as exc:
            raise InstallError("install_stage_validation_failed") from exc
        if completed.returncode != 0:
            raise InstallError("install_stage_validation_failed")
        try:
            payload = json.loads(completed.stdout)
        except (json.JSONDecodeError, RecursionError) as exc:
            raise InstallError("install_stage_validation_failed") from exc
        if not isinstance(payload, dict):
            raise InstallError("install_stage_validation_failed")


def _canonical_json(value: object) -> bytes:
    try:
        return (
            json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
            + "\n"
        ).encode("ascii")
    except (TypeError, ValueError, RecursionError) as exc:
        raise InstallError("install_target_untrusted") from exc


def _relative_name(value: object, *, root_allowed: bool = False) -> str:
    if root_allowed and value == ".":
        return "."
    if not isinstance(value, str) or not value or value.startswith("/"):
        raise InstallError("install_target_untrusted")
    parts = value.split("/")
    if any(not part or part in {".", ".."} or "\x00" in part for part in parts):
        raise InstallError("install_target_untrusted")
    return value


def _release_metadata(*, generation: str, commit: str) -> dict[str, object]:
    _relative_name(generation)
    if (
        not isinstance(commit, str)
        or len(commit) != 40
        or any(character not in "0123456789abcdef" for character in commit)
    ):
        raise InstallError("install_release_identity_invalid")
    return {
        "commit": commit,
        "generation": generation,
        "r2_base": {"commit": _R2_BASE_COMMIT, "tree": _R2_BASE_TREE},
        "historical_lineage": _HISTORICAL_LINEAGE,
        "successor_witness": {
            "path": _SUCCESSOR_WITNESS_PATH,
            "sha256": _SUCCESSOR_WITNESS_SHA256,
        },
        "release": {
            "stable_launchers": [
                _STABLE_MCP_LAUNCHER_SOURCE,
                "bin/the-hive-mcp",
                "bin/the-hive-resource-monitor",
            ],
            "hook_abi_source": _STABLE_HOOK_LAUNCHER_SOURCE,
            "hook_abi": _HOOK_ABI_V1_LAUNCHER,
            "hook_abi_companion": _HOOK_ABI_V1_COMPANION,
            "hook_abi_core": _HOOK_ABI_V1_CORE,
            "hook_entrypoints": list(_HOOK_ENTRYPOINTS),
            "plugin_bundle": _PLUGIN_BUNDLE_DIRECTORY,
            "root_install_plan": _ROOT_INSTALL_PLAN_NAME,
            "python_tree": "src/the_hive",
            "monitor_entrypoint": "bin/the-hive-resource-monitor",
            "h4_units": [
                "systemd/user/the-hive-resource-monitor.service",
                "systemd/user/the-hive.slice",
            ],
            "bind_sources": [
                "bin/the-hive-resource-monitor",
                "src/the_hive",
                "codex-agent-classes.json",
                "codex-hive.json",
                "%h/.local/state/codex-master-mcp/hive",
            ],
        },
    }


def _runtime_manifest_payload(
    root: Path, *, generation: str = _R2_BASE_COMMIT, commit: str = _R2_BASE_COMMIT
) -> dict[str, object]:
    _directory(root, mode=0o700, create=False)
    directories: dict[str, dict[str, int]] = {}
    files: dict[str, dict[str, object]] = {}
    for directory, child_directories, file_names in os.walk(root):
        current = Path(directory)
        _source_directory(current)
        relative = current.relative_to(root).as_posix() if current != root else "."
        current_stat = current.lstat()
        directories[relative] = {
            "mode": stat.S_IMODE(current_stat.st_mode),
            "nlink": current_stat.st_nlink,
        }
        child_directories[:] = sorted(child_directories)
        for name in child_directories:
            _source_directory(current / name)
        for name in sorted(file_names):
            if name == _MANIFEST_NAME:
                raise InstallError("install_target_untrusted")
            # The nested descriptor binds this manifest's digest and therefore
            # cannot itself be a member of the manifest hash inventory.
            if (
                (current / name).relative_to(root).as_posix()
                == f"{_PLUGIN_BUNDLE_DIRECTORY}/{_RELEASE_BINDING_NAME}"
                or name == _ROOT_INSTALL_PLAN_NAME
            ):
                continue
            raw = _source_bytes(current / name)
            item = (current / name).lstat()
            files[(current / name).relative_to(root).as_posix()] = {
                "mode": stat.S_IMODE(item.st_mode),
                "nlink": item.st_nlink,
                "size": len(raw),
                "sha256": hashlib.sha256(raw).hexdigest(),
            }
    witness = files.get(_SUCCESSOR_WITNESS_PATH)
    if (
        not isinstance(witness, dict)
        or witness.get("sha256") != _SUCCESSOR_WITNESS_SHA256
    ):
        raise InstallError("install_release_binding_drift")
    return {
        "schema_version": _MANIFEST_SCHEMA_VERSION,
        **_release_metadata(generation=generation, commit=commit),
        "directories": directories,
        "files": files,
    }


def _plugin_bundle_source_files(*, root: Path) -> tuple[tuple[str, str, int], ...]:
    """List each bundle artifact once from the sealed runtime source image."""

    members = [(name, name, mode) for name, mode in _PLUGIN_BUNDLE_FILES]
    for source_root, target_root in _PLUGIN_BUNDLE_TREES:
        source = root / source_root
        _source_directory(source)
        for directory, child_directories, file_names in os.walk(source):
            current = Path(directory)
            _source_directory(current)
            child_directories[:] = sorted(child_directories)
            for name in child_directories:
                _source_directory(current / name)
            for name in sorted(file_names):
                relative = (current / name).relative_to(source).as_posix()
                item = (current / name).lstat()
                mode = stat.S_IMODE(item.st_mode)
                if mode & 0o022:
                    raise InstallError("install_source_untrusted")
                members.append(
                    (
                        (Path(source_root) / relative).as_posix(),
                        (Path(target_root) / relative).as_posix(),
                        mode,
                    )
                )
    return tuple(members)


def _write_runtime_image_manifest(
    *, root: Path, generation: str = _R2_BASE_COMMIT, commit: str = _R2_BASE_COMMIT
) -> None:
    _remove_generated_plugin_bundle(root=root)
    _remove_generated_regular(root=root, name=_ROOT_INSTALL_PLAN_NAME)
    _remove_generated_regular(root=root, name=_RELEASE_BINDING_NAME)
    # The complete native plugin payload, including its `src/the_hive` import
    # tree, exists before the manifest is sealed.  Only the descriptor itself
    # follows the seal because it binds the resulting manifest digest.
    _materialize_plugin_bundle_payload(root=root)
    encoded = _canonical_json(
        _runtime_manifest_payload(root, generation=generation, commit=commit)
    )
    if len(encoded) > _MAX_MANIFEST_BYTES:
        raise InstallError("install_target_untrusted")
    descriptor = -1
    temporary = Path()
    try:
        descriptor, temporary_name = tempfile.mkstemp(
            prefix=f".{_MANIFEST_NAME}.", dir=root
        )
        temporary = Path(temporary_name)
        os.fchmod(descriptor, 0o644)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, root / _MANIFEST_NAME)
        temporary = Path()
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)

    _write_root_install_plan(root=root)
    _write_release_binding_descriptor(root=root)
    _fsync_tree(root / _PLUGIN_BUNDLE_DIRECTORY)


def _remove_generated_regular(*, root: Path, name: str) -> None:
    target = root / name
    try:
        item = target.lstat()
    except FileNotFoundError:
        return
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    if (
        stat.S_ISLNK(item.st_mode)
        or not stat.S_ISREG(item.st_mode)
        or item.st_uid != os.geteuid()
        or item.st_nlink != 1
        or stat.S_IMODE(item.st_mode) != 0o644
    ):
        raise InstallError("install_target_untrusted")
    try:
        _source_bytes(target)
        target.unlink()
        _fsync_directory(root)
    except (InstallError, OSError) as exc:
        raise InstallError("install_target_untrusted") from exc


def _remove_generated_plugin_bundle(*, root: Path) -> None:
    """Discard only a prior complete bundle while resealing an unpublished stage."""

    bundle = root / _PLUGIN_BUNDLE_DIRECTORY
    try:
        bundle.lstat()
    except FileNotFoundError:
        return
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    try:
        for directory, child_directories, file_names in os.walk(bundle, topdown=False):
            current = Path(directory)
            _source_directory(current)
            for name in child_directories:
                _source_directory(current / name)
            for name in file_names:
                _source_bytes(current / name)
        shutil.rmtree(bundle)
        _fsync_directory(root)
    except (InstallError, OSError) as exc:
        raise InstallError("install_target_untrusted") from exc


def _write_generated_regular(*, directory: Path, name: str, content: bytes) -> None:
    if not content or len(content) > _MAX_MANIFEST_BYTES:
        raise InstallError("install_target_untrusted")
    descriptor = -1
    temporary = Path()
    try:
        descriptor, temporary_name = tempfile.mkstemp(prefix=f".{name}.", dir=directory)
        temporary = Path(temporary_name)
        os.fchmod(descriptor, 0o644)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, directory / name)
        temporary = Path()
        _fsync_directory(directory)
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if temporary != Path():
            try:
                temporary.unlink()
            except OSError:
                pass


def _write_release_binding_descriptor(*, root: Path) -> None:
    """Atomically bind the native plugin bundle to its sealed image."""

    try:
        manifest_raw = _source_bytes(root / _MANIFEST_NAME)
        manifest = json.loads(manifest_raw.decode("utf-8"))
        if not isinstance(manifest, dict):
            raise InstallError("install_target_untrusted")
        encoded = release_binding_bytes(
            manifest,
            "sha256:" + hashlib.sha256(manifest_raw).hexdigest(),
        )
    except (UnicodeError, json.JSONDecodeError, ValueError) as exc:
        raise InstallError("install_target_untrusted") from exc
    _write_generated_regular(
        directory=root / _PLUGIN_BUNDLE_DIRECTORY,
        name=_RELEASE_BINDING_NAME,
        content=encoded,
    )


def _write_root_install_plan(*, root: Path) -> None:
    """Emit bytes for a later RootInstallPlanV1 gate; never install them here."""

    try:
        manifest_raw = _source_bytes(root / _MANIFEST_NAME)
        manifest = json.loads(manifest_raw.decode("utf-8"))
        if not isinstance(manifest, dict):
            raise InstallError("install_target_untrusted")
        encoded = root_install_plan_bytes(
            manifest,
            "sha256:" + hashlib.sha256(manifest_raw).hexdigest(),
        )
    except (UnicodeError, json.JSONDecodeError, ValueError) as exc:
        raise InstallError("install_target_untrusted") from exc
    _write_generated_regular(
        directory=root, name=_ROOT_INSTALL_PLAN_NAME, content=encoded
    )


def _materialize_plugin_bundle_payload(*, root: Path) -> None:
    """Materialize the complete plugin payload before manifest attestation."""

    bundle = _child_directory(root, (_PLUGIN_BUNDLE_DIRECTORY,), mode=0o700)
    for source_name, target_name, mode in _plugin_bundle_source_files(root=root):
        target = bundle / target_name
        _child_directory(
            bundle, tuple(target.parent.relative_to(bundle).parts), mode=0o700
        )
        _install_regular(root / source_name, target, mode=mode)
    _fsync_tree(bundle)


def _release_pointer_entry(layout: RuntimeLayout) -> dict[str, str]:
    manifest = json.loads(_source_bytes(layout.root / _MANIFEST_NAME).decode("utf-8"))
    generation = manifest.get("generation") if isinstance(manifest, dict) else None
    if not isinstance(generation, str):
        raise InstallError("install_release_invalid")
    _relative_name(generation)
    return {"generation": generation, "manifest_digest": layout.manifest_digest}


def _attested_release_pointer(root: Path, value: object) -> dict[str, str] | None:
    if value is None:
        return None
    if not isinstance(value, dict) or set(value) != {"generation", "manifest_digest"}:
        raise InstallError("install_release_pointer_invalid")
    generation = value.get("generation")
    digest = value.get("manifest_digest")
    if not isinstance(generation, str) or not isinstance(digest, str):
        raise InstallError("install_release_pointer_invalid")
    _relative_name(generation)
    try:
        layout = RuntimeLayout.from_runtime_root(
            root / _RELEASE_GENERATIONS_NAME / generation
        )
    except ValueError as exc:
        raise InstallError("install_release_pointer_invalid") from exc
    if _release_pointer_entry(layout) != value or layout.manifest_digest != digest:
        raise InstallError("install_release_pointer_invalid")
    return {"generation": generation, "manifest_digest": digest}


def _read_release_pointers(root: Path) -> dict[str, dict[str, str] | None]:
    pointer = root / _RELEASE_POINTERS_NAME
    try:
        item = pointer.lstat()
    except FileNotFoundError:
        return {"current": None, "previous": None}
    except OSError as exc:
        raise InstallError("install_release_pointer_invalid") from exc
    if (
        not stat.S_ISREG(item.st_mode)
        or stat.S_ISLNK(item.st_mode)
        or item.st_uid != os.geteuid()
        or stat.S_IMODE(item.st_mode) != 0o644
    ):
        raise InstallError("install_release_pointer_invalid")
    try:
        value = json.loads(_source_bytes(pointer).decode("utf-8"))
    except (UnicodeError, json.JSONDecodeError) as exc:
        raise InstallError("install_release_pointer_invalid") from exc
    if (
        not isinstance(value, dict)
        or set(value) != {"schema_version", "current", "previous"}
        or value.get("schema_version") != 1
    ):
        raise InstallError("install_release_pointer_invalid")
    return {
        "current": _attested_release_pointer(root, value["current"]),
        "previous": _attested_release_pointer(root, value["previous"]),
    }


def _restore_release_pointer_bytes(root: Path, previous: bytes | None) -> None:
    pointer = root / _RELEASE_POINTERS_NAME
    if previous is None:
        try:
            pointer.unlink()
        except FileNotFoundError:
            return
        except OSError as exc:
            raise InstallError("install_release_pointer_durability_unknown") from exc
    else:
        descriptor = -1
        temporary = Path()
        try:
            descriptor, name = tempfile.mkstemp(
                prefix=f".{_RELEASE_POINTERS_NAME}.rollback.", dir=root
            )
            temporary = Path(name)
            os.fchmod(descriptor, 0o644)
            with os.fdopen(descriptor, "wb") as handle:
                descriptor = -1
                handle.write(previous)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(temporary, pointer)
            temporary = Path()
        except OSError as exc:
            raise InstallError("install_release_pointer_durability_unknown") from exc
        finally:
            if descriptor >= 0:
                os.close(descriptor)
    _fsync_directory(root)


def _release_pointer_bytes(root: Path) -> bytes | None:
    """Snapshot an already parsed pointer without silently repairing it."""

    target = root / _RELEASE_POINTERS_NAME
    try:
        return _source_bytes(target)
    except InstallError:
        try:
            target.lstat()
        except FileNotFoundError:
            return None
        except OSError as exc:
            raise InstallError("install_release_pointer_invalid") from exc
        raise


def _write_release_pointers(
    root: Path, pointers: dict[str, dict[str, str] | None]
) -> None:
    encoded = _canonical_json({"schema_version": 1, **pointers})
    descriptor = -1
    temporary = Path()
    previous: bytes | None
    try:
        previous = _source_bytes(root / _RELEASE_POINTERS_NAME)
    except InstallError:
        try:
            (root / _RELEASE_POINTERS_NAME).lstat()
        except FileNotFoundError:
            previous = None
        except OSError as exc:
            raise InstallError("install_release_pointer_write_failed") from exc
        else:
            raise
    try:
        descriptor, name = tempfile.mkstemp(
            prefix=f".{_RELEASE_POINTERS_NAME}.", dir=root
        )
        temporary = Path(name)
        os.fchmod(descriptor, 0o644)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(encoded)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, root / _RELEASE_POINTERS_NAME)
        temporary = Path()
        try:
            _fsync_directory(root)
        except InstallError as exc:
            try:
                _restore_release_pointer_bytes(root, previous)
            except InstallError:
                raise InstallError(
                    "install_release_pointer_durability_unknown"
                ) from exc
            raise InstallError("install_release_pointer_write_failed") from exc
    except OSError as exc:
        raise InstallError("install_release_pointer_write_failed") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _attested_stable_mcp_launcher_bytes(layout: RuntimeLayout) -> bytes:
    """Read generic MCP launcher bytes before any publication is visible."""

    try:
        return layout.read_attested_file(_STABLE_MCP_LAUNCHER_SOURCE)
    except ValueError as exc:
        raise InstallError("install_release_invalid") from exc


def _materialize_stable_mcp_launcher(*, source: bytes, release_root: Path) -> None:
    """Install only already-attested generic MCP launcher bytes."""

    _install_attested_bytes(
        release_root / _STABLE_MCP_LAUNCHER_NAME, source, mode=0o755
    )


def _render_legacy_probe_launcher(
    source: bytes, *, generation: str, manifest_digest: str
) -> bytes:
    """Bind the public launcher to this exact attested generation at install time."""

    try:
        template = source.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise InstallError("install_release_invalid") from exc
    if (
        template.count("@MASTERJET_GENERATION@") != 1
        or template.count("@MASTERJET_MANIFEST_DIGEST@") != 1
    ):
        raise InstallError("install_release_invalid")
    rendered = template.replace("@MASTERJET_GENERATION@", generation).replace(
        "@MASTERJET_MANIFEST_DIGEST@", manifest_digest
    )
    if "@MASTERJET_" in rendered:
        raise InstallError("install_release_invalid")
    return rendered.encode("utf-8")


def _attested_legacy_probe_launcher_bytes(layout: RuntimeLayout) -> bytes:
    """Render the public probe from one staged generation before cutover."""

    try:
        source = layout.read_attested_file(_LEGACY_PROBE_LAUNCHER_SOURCE)
    except ValueError as exc:
        raise InstallError("install_release_invalid") from exc
    return _render_legacy_probe_launcher(
        source,
        generation=layout.root.name,
        manifest_digest=layout.manifest_digest,
    )


def _materialize_legacy_probe_launcher(*, source: bytes, libexec: Path) -> None:
    """Replace the owned historical public probe with already-attested bytes."""

    _install_attested_bytes(libexec / _LEGACY_PROBE_LAUNCHER_NAME, source, mode=0o755)


def _owned_launcher_bytes(target: Path) -> bytes | None:
    """Snapshot one owned executable through a no-follow, single-link path."""

    try:
        item = target.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise InstallError("install_release_triplet_invalid") from exc
    if (
        stat.S_ISLNK(item.st_mode)
        or not stat.S_ISREG(item.st_mode)
        or item.st_nlink != 1
        or item.st_uid != os.geteuid()
        or stat.S_IMODE(item.st_mode) != 0o755
    ):
        raise InstallError("install_release_triplet_invalid")
    try:
        return _source_bytes(target)
    except InstallError as exc:
        raise InstallError("install_release_triplet_invalid") from exc


def _stable_launcher_bytes(release_root: Path, *, name: str) -> bytes | None:
    """Snapshot one private stable launcher before a pointer update."""

    return _owned_launcher_bytes(release_root / name)


def _stable_mcp_launcher_bytes(release_root: Path) -> bytes | None:
    return _stable_launcher_bytes(release_root, name=_STABLE_MCP_LAUNCHER_NAME)


def _legacy_probe_launcher_bytes(libexec: Path) -> bytes | None:
    """Snapshot the owned public probe before the release transaction alters it."""

    try:
        _source_directory(libexec)
        return _owned_launcher_bytes(libexec / _LEGACY_PROBE_LAUNCHER_NAME)
    except InstallError as exc:
        raise InstallError("install_release_triplet_invalid") from exc


def _restore_owned_launcher(*, target: Path, previous: bytes | None) -> None:
    """Durably restore one owned launcher when the release transaction aborts."""

    try:
        if previous is None:
            try:
                item = target.lstat()
            except FileNotFoundError:
                return
            if (
                stat.S_ISLNK(item.st_mode)
                or not stat.S_ISREG(item.st_mode)
                or item.st_nlink != 1
                or item.st_uid != os.geteuid()
                or stat.S_IMODE(item.st_mode) != 0o755
            ):
                raise InstallError("install_release_triplet_durability_unknown")
            target.unlink()
            _fsync_directory(target.parent)
        else:
            _install_attested_bytes(target, previous, mode=0o755)
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError("install_release_triplet_durability_unknown") from exc


def _restore_stable_launcher(
    *, release_root: Path, name: str, previous: bytes | None
) -> None:
    """Durably restore one private stable launcher after an aborted transaction."""

    _restore_owned_launcher(target=release_root / name, previous=previous)


def _restore_stable_mcp_launcher(*, release_root: Path, previous: bytes | None) -> None:
    _restore_stable_launcher(
        release_root=release_root, name=_STABLE_MCP_LAUNCHER_NAME, previous=previous
    )


def _restore_legacy_probe_launcher(*, libexec: Path, previous: bytes | None) -> None:
    """Restore the public probe within the same rollback boundary as Current."""

    try:
        _source_directory(libexec)
        _restore_owned_launcher(
            target=libexec / _LEGACY_PROBE_LAUNCHER_NAME, previous=previous
        )
    except InstallError as exc:
        raise InstallError("install_release_triplet_durability_unknown") from exc


def _render_hourly_probe_service(
    template: bytes, *, generation: str, manifest_digest: str
) -> bytes:
    """Bind the delivered hourly unit to exactly one current release generation."""

    try:
        text = template.decode("utf-8")
    except UnicodeDecodeError as exc:
        raise InstallError("install_release_template_invalid") from exc
    if (
        text.count("@MASTERJET_GENERATION@") != 2
        or text.count("@MASTERJET_MANIFEST_DIGEST@") != 1
        or _HOURLY_PROBE_RUNTIME_ROOT_BINDING not in text
        or "%h/.local/lib/codex-master-runtime/bin/" in text
        or "%h/codex-master" in text
    ):
        raise InstallError("install_release_template_invalid")
    rendered = text.replace("@MASTERJET_GENERATION@", generation).replace(
        "@MASTERJET_MANIFEST_DIGEST@", manifest_digest
    )
    if "@MASTERJET_" in rendered or _HOURLY_PROBE_RUNTIME_ROOT_BINDING not in rendered:
        raise InstallError("install_release_template_invalid")
    expected = (
        "ExecStart=%h/.local/lib/the-hive-runtime/generations/"
        f"{generation}/bin/the-hive-hive-hourly-probe "
        "%h/.local/lib/the-hive-runtime "
        f"{generation} {manifest_digest} --json"
    )
    if expected not in rendered:
        raise InstallError("install_release_template_invalid")
    return rendered.encode("utf-8")


def _hourly_probe_unit_bytes(target: Path) -> bytes | None:
    """Read one private installed hourly unit, if it is present."""

    try:
        item = target.lstat()
    except FileNotFoundError:
        return None
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    if (
        stat.S_ISLNK(item.st_mode)
        or not stat.S_ISREG(item.st_mode)
        or item.st_nlink != 1
        or item.st_uid != os.geteuid()
        or stat.S_IMODE(item.st_mode) != 0o644
    ):
        raise InstallError("install_target_untrusted")
    return _source_bytes(target)


def _snapshot_hourly_probe_units(*, units: Path) -> tuple[bytes | None, bytes | None]:
    """Capture the complete private Unit pair before replacing either member."""

    try:
        _source_directory(units)
        return (
            _hourly_probe_unit_bytes(units / "the-hive-hive-hourly-probe.service"),
            _hourly_probe_unit_bytes(units / "the-hive-hive-hourly-probe.timer"),
        )
    except InstallError as exc:
        raise InstallError("install_release_retention_failed") from exc


def _restore_hourly_probe_units(
    *, units: Path, previous: tuple[bytes | None, bytes | None]
) -> None:
    """Restore a Unit pair after its unpublished replacement did not complete."""

    try:
        _source_directory(units)
        for name, content in zip(_UNIT_NAMES, previous, strict=True):
            target = units / name
            current = _hourly_probe_unit_bytes(target)
            if content is None:
                if current is not None:
                    target.unlink()
            elif current != content:
                _install_attested_bytes(target, content, mode=0o644)
        _fsync_directory(units)
    except InstallError as exc:
        raise InstallError("install_release_pair_durability_unknown") from exc
    except OSError as exc:
        raise InstallError("install_release_pair_durability_unknown") from exc


def _discard_unpublished_generation(
    *, generations: Path, target: Path, entry: dict[str, str]
) -> None:
    """Remove one manifest-attested generation before any pointer names it."""

    try:
        layout = RuntimeLayout.from_runtime_root(target)
        if _release_pointer_entry(layout) != entry:
            raise InstallError("install_release_invalid")
        shutil.rmtree(target)
        _fsync_directory(generations)
    except (InstallError, OSError, ValueError) as exc:
        raise InstallError("install_release_pair_durability_unknown") from exc


def _remove_fresh_publish_artifacts(*, release_root: Path) -> None:
    """Remove only an empty, publisher-created first-release root.

    This is intentionally narrower than retention: it runs only after a root
    that was absent before this publisher call has rolled back completely.
    Any unexpected member, link, ownership/mode drift, or cleanup failure is
    durability-unknown rather than permission to remove broader state.
    """

    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    parent_fd = -1
    root_fd = -1
    generation_fd = -1
    try:
        parent_fd = os.open(release_root.parent, flags)
        parent_info = os.fstat(parent_fd)
        if (
            not stat.S_ISDIR(parent_info.st_mode)
            or parent_info.st_uid != os.geteuid()
            or stat.S_IMODE(parent_info.st_mode) & 0o022
        ):
            raise InstallError("install_release_transaction_durability_unknown")
        root_fd = os.open(release_root.name, flags, dir_fd=parent_fd)
        root_info = os.fstat(root_fd)
        if (
            not stat.S_ISDIR(root_info.st_mode)
            or root_info.st_uid != os.geteuid()
            or stat.S_IMODE(root_info.st_mode) != 0o700
        ):
            raise InstallError("install_release_transaction_durability_unknown")
        members = set(os.listdir(root_fd))
        expected = {_RELEASE_GENERATIONS_NAME, _PUBLISH_LOCK_NAME}
        if not members.issubset(expected):
            raise InstallError("install_release_transaction_durability_unknown")
        if _RELEASE_GENERATIONS_NAME in members:
            generation_fd = os.open(_RELEASE_GENERATIONS_NAME, flags, dir_fd=root_fd)
            generation_info = os.fstat(generation_fd)
            if (
                not stat.S_ISDIR(generation_info.st_mode)
                or generation_info.st_uid != os.geteuid()
                or stat.S_IMODE(generation_info.st_mode) != 0o700
                or os.listdir(generation_fd)
            ):
                raise InstallError("install_release_transaction_durability_unknown")
            os.close(generation_fd)
            generation_fd = -1
            os.rmdir(_RELEASE_GENERATIONS_NAME, dir_fd=root_fd)
        if _PUBLISH_LOCK_NAME in members:
            lock_info = os.stat(
                _PUBLISH_LOCK_NAME, dir_fd=root_fd, follow_symlinks=False
            )
            if (
                not stat.S_ISREG(lock_info.st_mode)
                or lock_info.st_uid != os.geteuid()
                or lock_info.st_nlink != 1
                or stat.S_IMODE(lock_info.st_mode) != 0o600
            ):
                raise InstallError("install_release_transaction_durability_unknown")
            os.unlink(_PUBLISH_LOCK_NAME, dir_fd=root_fd)
        if os.listdir(root_fd):
            raise InstallError("install_release_transaction_durability_unknown")
        os.fsync(root_fd)
        os.close(root_fd)
        root_fd = -1
        os.rmdir(release_root.name, dir_fd=parent_fd)
        os.fsync(parent_fd)
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError("install_release_transaction_durability_unknown") from exc
    finally:
        if generation_fd >= 0:
            os.close(generation_fd)
        if root_fd >= 0:
            os.close(root_fd)
        if parent_fd >= 0:
            os.close(parent_fd)


def _staged_hourly_probe_unit_bytes(
    *, layout: RuntimeLayout, generation: str
) -> tuple[bytes, bytes]:
    """Render all owned unit bytes before a publication becomes visible."""

    try:
        service_template = layout.read_attested_file(
            "systemd/user/the-hive-hive-hourly-probe.service"
        )
        timer = layout.read_attested_file(
            "systemd/user/the-hive-hive-hourly-probe.timer"
        )
    except ValueError as exc:
        raise InstallError("install_release_invalid") from exc
    service = _render_hourly_probe_service(
        service_template, generation=generation, manifest_digest=layout.manifest_digest
    )
    return service, timer


def _materialize_hourly_probe_units(
    *, units: Path, staged: tuple[bytes, bytes]
) -> None:
    """Install only the already-attested, pre-rendered complete unit pair."""

    try:
        _source_directory(units)
    except InstallError as exc:
        raise InstallError("install_release_retention_failed") from exc
    _install_attested_bytes(
        units / "the-hive-hive-hourly-probe.service", staged[0], mode=0o644
    )
    _install_attested_bytes(
        units / "the-hive-hive-hourly-probe.timer", staged[1], mode=0o644
    )


@contextmanager
def _release_publish_lock(root: Path):
    descriptor = -1
    try:
        descriptor = os.open(
            root / _PUBLISH_LOCK_NAME,
            os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        os.fchmod(descriptor, 0o600)
        current = os.fstat(descriptor)
        if (
            not stat.S_ISREG(current.st_mode)
            or current.st_uid != os.geteuid()
            or stat.S_IMODE(current.st_mode) != 0o600
        ):
            raise InstallError("install_release_lock_invalid")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    except InstallError:
        raise
    except OSError as exc:
        raise InstallError("install_release_lock_invalid") from exc
    finally:
        if descriptor >= 0:
            try:
                fcntl.flock(descriptor, fcntl.LOCK_UN)
            finally:
                os.close(descriptor)


def _prune_release_generations(root: Path, *, retain: set[str]) -> None:
    generations = root / _RELEASE_GENERATIONS_NAME
    for candidate in sorted(generations.iterdir()):
        if candidate.name in retain:
            continue
        try:
            _relative_name(candidate.name)
            layout = RuntimeLayout.from_runtime_root(candidate)
            if _release_pointer_entry(layout)["generation"] != candidate.name:
                raise InstallError("install_release_invalid")
            shutil.rmtree(candidate)
        except (OSError, ValueError) as exc:
            raise InstallError("install_release_retention_failed") from exc
    _fsync_directory(generations)


def _unit_bound_generation(*, release_root: Path, source: Path) -> str | None:
    """Return the one attested generation named by an installed unit source.

    Discovery deliberately reads only private unit sources; service-manager
    state is mutable and cannot authorize deleting a generation.  A named unit
    that refers to this authority but cannot be fully attested is an error,
    never a reason to discard an old release.
    """

    try:
        text = _source_bytes(source).decode("utf-8")
    except (InstallError, UnicodeError) as exc:
        raise InstallError("install_release_retention_failed") from exc
    if _RELEASE_GENERATION_MARKER not in text:
        return None
    generations = set(
        re.findall(re.escape(_RELEASE_GENERATION_MARKER) + r"([^/:\s]+)", text)
    )
    if len(generations) != 1:
        raise InstallError("install_release_retention_failed")
    generation = generations.pop()
    try:
        _relative_name(generation)
    except InstallError as exc:
        raise InstallError("install_release_retention_failed") from exc
    if not re.search(
        re.escape(_RELEASE_GENERATION_MARKER) + re.escape(generation), text
    ):
        raise InstallError("install_release_retention_failed")
    digest_matches = re.findall(
        re.escape(generation) + r"\s+(sha256:[0-9a-f]{64})(?:\s|$)", text
    )
    if len(set(digest_matches)) != 1:
        raise InstallError("install_release_retention_failed")
    try:
        layout = RuntimeLayout.from_runtime_root(
            release_root / _RELEASE_GENERATIONS_NAME / generation
        )
    except ValueError as exc:
        raise InstallError("install_release_retention_failed") from exc
    if layout.manifest_digest != digest_matches[0]:
        raise InstallError("install_release_retention_failed")
    if source.name == "the-hive-resource-monitor.service":
        required_sources = (
            "bin/the-hive-resource-monitor",
            "src",
            "codex-agent-classes.json",
            "codex-hive.json",
        )
        if (
            any(
                f"{_RELEASE_GENERATION_MARKER}{generation}/{relative}" not in text
                for relative in required_sources
            )
            or (
                "ExecStart=%h/.local/bin/the-hive-resource-monitor "
                f"%h/.local/lib/the-hive-runtime {generation} {layout.manifest_digest}"
            )
            not in text
        ):
            raise InstallError("install_release_retention_failed")
    elif source.name == "the-hive-hive-hourly-probe.service":
        if (
            _HOURLY_PROBE_RUNTIME_ROOT_BINDING not in text
            or (
                f"BindReadOnlyPaths={_RELEASE_GENERATION_MARKER}{generation}:"
                f"{_RELEASE_GENERATION_MARKER}{generation}:norbind"
            )
            in text
            or (
                "ExecStart="
                f"{_RELEASE_GENERATION_MARKER}{generation}/bin/the-hive-hive-hourly-probe "
                f"%h/.local/lib/the-hive-runtime {generation} {layout.manifest_digest} --json"
            )
            not in text
        ):
            raise InstallError("install_release_retention_failed")
    else:
        raise InstallError("install_release_retention_failed")
    return generation


def _installed_live_generations(*, release_root: Path, units: Path | None) -> set[str]:
    """Find complete attested generations still named by installed unit sources."""

    if units is None:
        return set()
    try:
        _source_directory(units)
    except InstallError as exc:
        raise InstallError("install_release_retention_failed") from exc
    retained: set[str] = set()
    for name in _BOUND_RELEASE_UNIT_NAMES:
        source = units / name
        try:
            source.lstat()
        except FileNotFoundError:
            continue
        except OSError as exc:
            raise InstallError("install_release_retention_failed") from exc
        generation = _unit_bound_generation(release_root=release_root, source=source)
        if generation is not None:
            retained.add(generation)
    return retained


def _canonical_hook_session_pin_store(release_root: Path) -> HookSessionPinStoreV1:
    """Open only the one D320 state-root derived from this release authority."""

    try:
        library = release_root.parent
        local = library.parent
        home = local.parent
        if (
            library.name != "lib"
            or local.name != ".local"
            or not home.is_absolute()
            or release_root.name != _RUNTIME_ROOT_NAME
        ):
            raise InstallError("install_release_retention_failed")
        return HookSessionPinStoreV1.open_at(
            home / ".local" / "state" / "the-hive" / "hook-session-pins-v1"
        )
    except (HookSessionPinStoreError, InstallError) as exc:
        raise InstallError("install_release_retention_failed") from exc


def _fresh_release_root_before_publish(release_root: Path) -> bool:
    """Prove the sole-owner first-publish state before this function mutates it."""

    try:
        item = release_root.lstat()
    except FileNotFoundError:
        library = release_root.parent
        local = library.parent
        if (
            release_root.name != _RUNTIME_ROOT_NAME
            or library.name != "lib"
            or local.name != ".local"
        ):
            raise InstallError("install_release_retention_failed")
        _directory(library, mode=0o700, create=False)
        return True
    except OSError as exc:
        raise InstallError("install_release_retention_failed") from exc
    if stat.S_ISLNK(item.st_mode) or not stat.S_ISDIR(item.st_mode):
        raise InstallError("install_release_retention_failed")
    return False


def _attested_hook_session_pin_generations(
    *, release_root: Path, fresh_release_root: bool
) -> set[str]:
    """Read the canonical locked pin store; unreadable state fails closed."""

    # A missing release root observed before our first mutation proves there
    # is no immutable generation from which a binding could exist.  It is the
    # sole first-publish bootstrap; this function never creates a pin store.
    if fresh_release_root:
        return set()
    try:
        bindings = _canonical_hook_session_pin_store(release_root).retained_bindings(
            now_unix_ns=time.time_ns()
        )
    except HookSessionPinStoreError as exc:
        raise InstallError("install_release_retention_failed") from exc
    retained: set[str] = set()
    for pin in bindings.values():
        generation = pin.get("generation")
        manifest_digest = pin.get("runtime_manifest_digest")
        if not isinstance(generation, str) or not isinstance(manifest_digest, str):
            raise InstallError("install_release_retention_failed")
        try:
            _relative_name(generation)
            layout = RuntimeLayout.from_runtime_root(
                release_root / _RELEASE_GENERATIONS_NAME / generation
            )
        except (InstallError, ValueError) as exc:
            raise InstallError("install_release_retention_failed") from exc
        if _release_pointer_entry(layout) != {
            "generation": generation,
            "manifest_digest": manifest_digest,
        }:
            raise InstallError("install_release_retention_failed")
        retained.add(generation)
    return retained


def _publish_runtime_generation(
    *,
    stage: Path,
    release_root: Path,
    live_unit_dir: Path | None = None,
    live_libexec: Path | None = None,
) -> RuntimeLayout:
    """Publish exactly one manifest-attested generation under the sole image owner."""

    if (
        not stage.is_absolute()
        or not release_root.is_absolute()
        or stage == release_root
    ):
        raise InstallError("install_stage_untrusted")
    # Do not create even an empty release-root, generations directory, or
    # publisher lock until every candidate artifact that can be checked from
    # the immutable stage has passed.  In particular a failed first publish
    # must not consume the no-prior-generation bootstrap state.
    try:
        staged_layout = RuntimeLayout.from_runtime_root(stage)
        staged_mcp_launcher = _attested_stable_mcp_launcher_bytes(staged_layout)
        entry = _release_pointer_entry(staged_layout)
        staged_units = (
            _staged_hourly_probe_unit_bytes(
                layout=staged_layout, generation=entry["generation"]
            )
            if live_unit_dir is not None
            else None
        )
        staged_legacy_probe_launcher = (
            _attested_legacy_probe_launcher_bytes(staged_layout)
            if live_libexec is not None
            else None
        )
        if live_libexec is not None:
            _source_directory(live_libexec)
    except (InstallError, ValueError) as exc:
        raise InstallError("install_stage_validation_failed") from exc
    fresh_release_root = _fresh_release_root_before_publish(release_root)
    # A fresh root remains cleanup-eligible only while it contains the
    # publisher's empty generations/lock artifacts.  A visible generation
    # clears this marker until the inner rollback has fully restored the
    # prepublish state.
    fresh_cleanup_eligible = False
    try:
        _directory(release_root, mode=0o700, create=True)
        fresh_cleanup_eligible = fresh_release_root
        members = {item.name for item in release_root.iterdir()}
        if not members.issubset(
            {
                _RELEASE_GENERATIONS_NAME,
                _RELEASE_POINTERS_NAME,
                _PUBLISH_LOCK_NAME,
                _STABLE_MCP_LAUNCHER_NAME,
            }
        ):
            raise InstallError("install_release_root_legacy")
        generations = _child_directory(
            release_root, (_RELEASE_GENERATIONS_NAME,), mode=0o700
        )
        with _release_publish_lock(release_root):
            # Everything below this comment is attestable before the rename that
            # first makes the staged generation visible to another reader.
            _attested_hook_session_pin_generations(
                release_root=release_root, fresh_release_root=fresh_release_root
            )
            previous_hourly_units = (
                _snapshot_hourly_probe_units(units=live_unit_dir)
                if live_unit_dir is not None
                else None
            )
            previous_legacy_probe_launcher = (
                _legacy_probe_launcher_bytes(live_libexec)
                if live_libexec is not None
                else None
            )
            target = generations / entry["generation"]
            if target.exists() or target.is_symlink():
                raise InstallError("install_release_generation_exists")
            pointers = _read_release_pointers(release_root)
            previous_pointer = _release_pointer_bytes(release_root)
            previous_mcp_launcher = _stable_mcp_launcher_bytes(release_root)

            visible = False
            try:
                os.rename(stage, target)
                visible = True
                fresh_cleanup_eligible = False
            except OSError as exc:
                raise InstallError("install_swap_failed") from exc
            try:
                _fsync_directory(generations)
                _fsync_directory(release_root)
                layout = RuntimeLayout.from_runtime_root(target)
                if _release_pointer_entry(layout) != entry:
                    raise InstallError("install_release_invalid")
                if live_unit_dir is not None and staged_units is not None:
                    _materialize_hourly_probe_units(
                        units=live_unit_dir,
                        staged=staged_units,
                    )
                _materialize_stable_mcp_launcher(
                    source=staged_mcp_launcher, release_root=release_root
                )
                if (
                    live_libexec is not None
                    and staged_legacy_probe_launcher is not None
                ):
                    _materialize_legacy_probe_launcher(
                        source=staged_legacy_probe_launcher, libexec=live_libexec
                    )
                _write_release_pointers(
                    release_root,
                    {"current": entry, "previous": pointers["current"]},
                )
                if live_unit_dir is not None:
                    if (
                        _unit_bound_generation(
                            release_root=release_root,
                            source=live_unit_dir / "the-hive-hive-hourly-probe.service",
                        )
                        != entry["generation"]
                    ):
                        raise InstallError("install_release_retention_failed")
                # D320 permits conservative retention.  Deleting an immutable
                # generation after a visible cutover would be non-rollbackable,
                # so this source publisher retains every generation.  A later
                # authority may add deletion only with a fully reversible plan.
                return layout
            except (InstallError, ValueError) as exc:
                try:
                    _restore_release_pointer_bytes(release_root, previous_pointer)
                    _restore_stable_mcp_launcher(
                        release_root=release_root, previous=previous_mcp_launcher
                    )
                    if live_unit_dir is not None and previous_hourly_units is not None:
                        _restore_hourly_probe_units(
                            units=live_unit_dir, previous=previous_hourly_units
                        )
                    if live_libexec is not None:
                        _restore_legacy_probe_launcher(
                            libexec=live_libexec,
                            previous=previous_legacy_probe_launcher,
                        )
                    if visible:
                        _discard_unpublished_generation(
                            generations=generations, target=target, entry=entry
                        )
                    fresh_cleanup_eligible = fresh_release_root
                except InstallError:
                    raise InstallError(
                        "install_release_transaction_durability_unknown"
                    ) from exc
                if isinstance(exc, ValueError):
                    raise InstallError("install_release_invalid") from exc
                raise
    except (InstallError, ValueError) as exc:
        if fresh_release_root and fresh_cleanup_eligible:
            try:
                _remove_fresh_publish_artifacts(release_root=release_root)
            except InstallError:
                raise InstallError(
                    "install_release_transaction_durability_unknown"
                ) from exc
        if isinstance(exc, ValueError):
            raise InstallError("install_release_invalid") from exc
        raise


def _ensure_probe_lock(state: Path) -> None:
    lock = state / ".hive-hourly-probe.lock"
    descriptor = -1
    try:
        try:
            descriptor = os.open(
                lock,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
                0o600,
            )
        except FileExistsError:
            descriptor = -1
        if descriptor >= 0:
            os.close(descriptor)
            descriptor = -1
        item = lock.lstat()
        if (
            stat.S_ISLNK(item.st_mode)
            or not stat.S_ISREG(item.st_mode)
            or item.st_nlink != 1
            or item.st_uid != os.geteuid()
            or stat.S_IMODE(item.st_mode) != 0o600
        ):
            raise InstallError("install_target_untrusted")
    except OSError as exc:
        raise InstallError("install_target_untrusted") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _install_attested_runtime(*, home: Path) -> dict[str, object]:
    """Internal lifecycle API; never a second public operator transaction."""
    if not home.is_absolute():
        raise InstallError("home_unavailable")
    _directory(home, mode=0o700, create=False)
    repository = Path(__file__).resolve().parents[1]
    commit = _verified_release_commit(repository)
    library = _child_directory(home, (".local", "lib"), mode=0o700)
    libexec = _child_directory(home, (".local", "libexec"), mode=0o700)
    state = _child_directory(home, (".local", "state", "codex-master-mcp"), mode=0o700)
    units = _child_directory(home, (".config", "systemd", "user"), mode=0o700)
    _ensure_probe_lock(state)
    stage = Path(tempfile.mkdtemp(prefix=f".{_RUNTIME_ROOT_NAME}.stage.", dir=library))
    _build_runtime_image(
        repository=repository, stage=stage, generation=commit, commit=commit
    )
    # The image is copied only from a clean, named descendant.  Recheck after
    # the copy so a source mutation cannot be smuggled between provenance
    # verification and the manifest-last stage seal.
    if _verified_release_commit(repository) != commit:
        raise InstallError("install_release_checkout_changed")
    _validate_runtime_image_stage(stage=stage, home=home)
    layout = _publish_runtime_generation(
        stage=stage,
        release_root=library / _RUNTIME_ROOT_NAME,
        live_unit_dir=units,
        live_libexec=libexec,
    )
    generation = _release_pointer_entry(layout)["generation"]
    return {
        "status": "installed",
        "generation": generation,
        "manifest_digest": layout.manifest_digest,
        "raw_output": "not_returned",
    }


def main() -> int:
    parser = argparse.ArgumentParser(prog="the-hive-hive-hourly-probe-install")
    parser.add_argument("--home", type=Path, default=Path.home())
    parser.parse_args()
    print(
        json.dumps(
            {
                "status": "runtime_lifecycle_cutover_required",
                "raw_output": "not_returned",
            },
            sort_keys=True,
        )
    )
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
