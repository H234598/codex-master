#!/usr/bin/env python3
"""Build, install, or verify the codex-master-mcp(1) manpage."""

from __future__ import annotations

import argparse
import gzip
import os
from pathlib import Path
import stat
import sys
import tempfile


REPO_ROOT = Path(__file__).resolve().parents[1]
SOURCE = REPO_ROOT / "man" / "man1" / "codex-master-mcp.1"
ARTIFACT_NAME = "codex-master-mcp.1.gz"


class ManpageError(RuntimeError):
    """Raised when a manpage operation would be unsafe or unverifiable."""


def compressed_source() -> bytes:
    if SOURCE.is_symlink() or not SOURCE.is_file():
        raise ManpageError(f"manpage source is not a regular file: {SOURCE}")
    return gzip.compress(SOURCE.read_bytes(), compresslevel=9, mtime=0)


def require_absolute(path: Path, option: str) -> Path:
    expanded = path.expanduser()
    if not expanded.is_absolute():
        raise ManpageError(f"{option} must be an absolute path")
    return expanded


def reject_symlink_path(path: Path, *, first_checked: Path) -> None:
    current = first_checked
    while True:
        if current.is_symlink():
            raise ManpageError(f"refusing symlink in target path: {current}")
        if current == path:
            return
        try:
            relative = path.relative_to(current)
        except ValueError as exc:
            raise ManpageError("target path escaped its prefix") from exc
        current = current / relative.parts[0]


def write_regular_file(target: Path, payload: bytes) -> None:
    if target.is_symlink():
        raise ManpageError(f"refusing symlink target: {target}")
    if target.exists() and not target.is_file():
        raise ManpageError(f"target is not a regular file: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary_name = tempfile.mkstemp(prefix=f".{target.name}.", dir=target.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.chmod(0o644)
        os.replace(temporary, target)
    finally:
        if temporary.exists():
            temporary.unlink()


def build(output_dir: Path) -> Path:
    output_dir = require_absolute(output_dir, "--output-dir")
    reject_symlink_path(output_dir, first_checked=output_dir)
    target = output_dir / ARTIFACT_NAME
    write_regular_file(target, compressed_source())
    return target


def install(prefix: Path) -> Path:
    prefix = require_absolute(prefix, "--prefix")
    target_dir = prefix / "share" / "man" / "man1"
    reject_symlink_path(target_dir, first_checked=prefix)
    target = target_dir / ARTIFACT_NAME
    write_regular_file(target, compressed_source())
    return target


def verify(prefix: Path) -> Path:
    prefix = require_absolute(prefix, "--prefix")
    target_dir = prefix / "share" / "man" / "man1"
    reject_symlink_path(target_dir, first_checked=prefix)
    target = target_dir / ARTIFACT_NAME
    if target.is_symlink() or not target.is_file():
        raise ManpageError(f"installed manpage is not a regular file: {target}")
    if stat.S_IMODE(target.stat().st_mode) != 0o644:
        raise ManpageError(f"installed manpage mode is not 0644: {target}")
    if target.read_bytes() != compressed_source():
        raise ManpageError("installed manpage differs from source")
    return target


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Build, install, or verify codex-master-mcp(1)."
    )
    subparsers = result.add_subparsers(dest="command", required=True)

    build_parser = subparsers.add_parser("build", help="build deterministic .1.gz output")
    build_parser.add_argument("--output-dir", type=Path, required=True)

    default_prefix = Path.home() / ".local"
    for command in ("install", "verify"):
        command_parser = subparsers.add_parser(
            command,
            help=f"{command} the user-local manpage",
        )
        command_parser.add_argument("--prefix", type=Path, default=default_prefix)
    return result


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    try:
        if args.command == "build":
            target = build(args.output_dir)
            action = "built"
        elif args.command == "install":
            target = install(args.prefix)
            action = "installed"
        else:
            target = verify(args.prefix)
            action = "verified"
    except (ManpageError, OSError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"{action}: {target}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
