#!/usr/bin/env python3
"""Atomically move Fleet supervision to the The-Hive user-unit namespace.

This is deliberately separate from Codex-Usage.  It is the only public
mutating route for the Fleet watchdog namespace; its status call is read-only.
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass
import fcntl
import json
import os
from pathlib import Path
import secrets
import stat
import subprocess
from typing import Callable


OLD = ("codex-master-watchdog.service", "codex-master-watchdog.timer")
NEW = ("the-hive-watchdog.service", "the-hive-watchdog.timer")
_MAX_UNIT_BYTES = 64 * 1024
_MAX_POINTER_BYTES = 256 * 1024
_CANONICAL_EXEC_START = (
    b"ExecStart=%h/.local/lib/the-hive-runtime/the-hive-mcp watchdog active "
    b"--idle-seconds 60 --poll-interval-seconds 15 --report-grace-seconds 15 "
    b"--action stop --manage-unclaimed --quiet"
)
_CANONICAL_TIMER_DIRECTIVES = (
    b"OnBootSec=15s",
    b"OnUnitActiveSec=15s",
    b"AccuracySec=1s",
    b"Unit=the-hive-watchdog.service",
    b"Persistent=false",
)
_LOCK_NAME = ".the-hive-watchdog-cutover.lock"
_LOCK_GUARD_NAME = ".the-hive-watchdog-cutover.namespace.lock"
_LOCK_ANCHOR_NAME = ".the-hive-watchdog-cutover.anchor.lock"


class CutoverError(RuntimeError):
    """Data-sparse failure returned by the public Fleet transaction."""


@dataclass(frozen=True)
class _File:
    path: Path
    content: bytes | None
    identity: tuple[int, int, int, int, int, int] | None


@dataclass(frozen=True)
class _Link:
    path: Path
    target: str | None
    identity: tuple[int, int, int, int, int] | None


@dataclass(frozen=True)
class _Backup:
    path: Path
    identity: tuple[int, ...]
    is_link: bool


@dataclass(frozen=True)
class _Directory:
    path: Path
    identity: tuple[int, int, int, int]


@dataclass(frozen=True)
class _LifecycleLock:
    descriptor: int
    root_descriptor: int
    root: _Directory
    identity: tuple[int, int, int, int, int, int]
    guard_descriptor: int
    guard_parent: _Directory
    guard_parent_descriptor: int
    guard_identity: tuple[int, int, int, int, int, int]
    anchor_descriptor: int
    anchor_parent: _Directory
    anchor_parent_descriptor: int
    anchor_identity: tuple[int, int, int, int, int, int]


@dataclass(frozen=True)
class _Binding:
    home: Path
    unit_dir: Path
    unit_directory: _Directory | None
    runtime: dict[str, object]
    files: tuple[_File, ...]
    wants: tuple[_Link, ...]
    want_directories: dict[Path, _Directory]
    states: dict[str, tuple[bool, bool]]


def _private_directory(path: Path, *, create: bool = False) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        if not create:
            raise CutoverError("watchdog_cutover_input_untrusted") from None
        path.mkdir(mode=0o700)
        info = path.lstat()
    except OSError as exc:
        raise CutoverError("watchdog_cutover_input_untrusted") from exc
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISDIR(info.st_mode)
        or info.st_uid != os.geteuid()
        or stat.S_IMODE(info.st_mode) & 0o022
    ):
        raise CutoverError("watchdog_cutover_input_untrusted")


def _trusted_chain(path: Path, *, create_leaf: bool = False) -> None:
    if not path.is_absolute():
        raise CutoverError("watchdog_cutover_input_untrusted")
    current = Path(path.anchor)
    for index, component in enumerate(path.parts[1:]):
        current /= component
        if index == len(path.parts) - 2:
            _private_directory(current, create=create_leaf)
            continue
        try:
            info = current.lstat()
        except OSError as exc:
            raise CutoverError("watchdog_cutover_input_untrusted") from exc
        # A home path may be beneath a shared sticky ancestor such as /tmp in
        # tests.  The mutable boundary starts at the named home, so ancestors
        # are bound only against links while the target is private/owned.
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            raise CutoverError("watchdog_cutover_input_untrusted")


def _bind_directory(path: Path) -> _Directory:
    """Bind an owned, no-follow directory to an FD-verifiable identity."""

    _trusted_chain(path)
    try:
        before = path.lstat()
        descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            current = os.fstat(descriptor)
        finally:
            os.close(descriptor)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_input_untrusted") from exc
    if (
        stat.S_ISLNK(before.st_mode)
        or not stat.S_ISDIR(before.st_mode)
        or before.st_uid != os.geteuid()
        or stat.S_IMODE(before.st_mode) & 0o022
        or (before.st_dev, before.st_ino, stat.S_IMODE(before.st_mode), before.st_uid)
        != (current.st_dev, current.st_ino, stat.S_IMODE(current.st_mode), current.st_uid)
    ):
        raise CutoverError("watchdog_cutover_input_untrusted")
    return _Directory(
        path, (current.st_dev, current.st_ino, stat.S_IMODE(current.st_mode), current.st_uid),
    )


def _open_bound_directory(directory: _Directory) -> int:
    try:
        descriptor = os.open(
            directory.path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
        )
        current = os.fstat(descriptor)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_input_changed") from exc
    if directory.identity != (
        current.st_dev, current.st_ino, stat.S_IMODE(current.st_mode), current.st_uid,
    ):
        os.close(descriptor)
        raise CutoverError("watchdog_cutover_input_changed")
    return descriptor


def _fd_entry_matches_file(descriptor: int, name: str, expected: _File) -> bool:
    if expected.identity is None:
        return False
    try:
        item = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
    except OSError:
        return False
    return (
        stat.S_ISREG(item.st_mode)
        and (item.st_dev, item.st_ino, stat.S_IMODE(item.st_mode), item.st_uid, item.st_nlink, item.st_size)
        == expected.identity
    )


def _fd_entry_matches_link(descriptor: int, name: str, expected: _Link) -> bool:
    if expected.identity is None:
        return False
    try:
        item = os.stat(name, dir_fd=descriptor, follow_symlinks=False)
    except OSError:
        return False
    return (
        stat.S_ISLNK(item.st_mode)
        and (item.st_dev, item.st_ino, item.st_uid, item.st_nlink, item.st_size) == expected.identity
    )


def _fd_entry_is_absent(descriptor: int, name: str) -> bool:
    try:
        os.stat(name, dir_fd=descriptor, follow_symlinks=False)
    except FileNotFoundError:
        return True
    except OSError:
        return False
    return False


def _fd_entry_matches_directory(descriptor: int, directory: _Directory) -> bool:
    try:
        item = os.stat(directory.path.name, dir_fd=descriptor, follow_symlinks=False)
    except OSError:
        return False
    return (
        stat.S_ISDIR(item.st_mode)
        and (item.st_dev, item.st_ino, stat.S_IMODE(item.st_mode), item.st_uid) == directory.identity
    )


def _create_backup_directory(parent: _Directory) -> _Directory:
    """Create the private rollback directory through the bound parent FD."""

    descriptor = _open_bound_directory(parent)
    try:
        for _ in range(32):
            name = ".the-hive-watchdog.rollback." + secrets.token_hex(16)
            try:
                os.mkdir(name, 0o700, dir_fd=descriptor)
            except FileExistsError:
                continue
            try:
                child = os.open(
                    name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                    dir_fd=descriptor,
                )
                try:
                    current = os.fstat(child)
                finally:
                    os.close(child)
            except OSError as exc:
                raise CutoverError("watchdog_cutover_write_failed") from exc
            if (
                current.st_uid != os.geteuid()
                or stat.S_IMODE(current.st_mode) != 0o700
            ):
                raise CutoverError("watchdog_cutover_write_failed")
            return _Directory(
                parent.path / name,
                (current.st_dev, current.st_ino, stat.S_IMODE(current.st_mode), current.st_uid),
            )
    finally:
        os.close(descriptor)
    raise CutoverError("watchdog_cutover_write_failed")


def _remove_empty_backup_directory(backup: _Directory, parent: _Directory) -> None:
    """Remove only the exact empty rollback leaf through its bound parent FD."""

    descriptor = _open_bound_directory(parent)
    try:
        if not _fd_entry_matches_directory(descriptor, backup):
            raise CutoverError("watchdog_cutover_rollback_verification_failed")
        current = _open_bound_directory(backup)
        os.close(current)
        if not _fd_entry_matches_directory(descriptor, backup):
            raise CutoverError("watchdog_cutover_rollback_verification_failed")
        os.rmdir(backup.path.name, dir_fd=descriptor)
        try:
            os.stat(backup.path.name, dir_fd=descriptor, follow_symlinks=False)
        except FileNotFoundError:
            return
        raise CutoverError("watchdog_cutover_rollback_verification_failed")
    except OSError as exc:
        raise CutoverError("watchdog_cutover_rollback_verification_failed") from exc
    finally:
        os.close(descriptor)


def _discard_committed_backups(
    backups: dict[Path, _Backup], backup: _Directory, parent: _Directory
) -> None:
    """Delete only the transaction's known backup leaves before removing its directory."""

    parent_descriptor = _open_bound_directory(parent)
    descriptor = _open_bound_directory(backup)
    try:
        if not _fd_entry_matches_directory(parent_descriptor, backup):
            raise CutoverError("watchdog_cutover_rollback_verification_failed")
        expected = {item.path.name: item for item in backups.values()}
        if set(os.listdir(descriptor)) != set(expected):
            raise CutoverError("watchdog_cutover_rollback_verification_failed")
        for name, item in expected.items():
            if not _fd_entry_matches_directory(parent_descriptor, backup):
                raise CutoverError("watchdog_cutover_rollback_verification_failed")
            matches = (
                _fd_entry_matches_link(descriptor, name, _Link(item.path, "", item.identity))
                if item.is_link
                else _fd_entry_matches_file(descriptor, name, _File(item.path, b"", item.identity))
            )
            if not matches:
                raise CutoverError("watchdog_cutover_rollback_verification_failed")
            os.unlink(name, dir_fd=descriptor)
        os.fsync(descriptor)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_rollback_verification_failed") from exc
    finally:
        os.close(descriptor)
        os.close(parent_descriptor)
    _remove_empty_backup_directory(backup, parent)


def _read_file(path: Path, *, mode: int | tuple[int, ...] | None) -> _File:
    try:
        before = path.lstat()
        if (
            stat.S_ISLNK(before.st_mode)
            or not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.geteuid()
            or before.st_nlink != 1
            or (
                mode is not None
                and stat.S_IMODE(before.st_mode)
                not in ((mode,) if isinstance(mode, int) else mode)
            )
            or (mode is None and stat.S_IMODE(before.st_mode) & 0o022)
            or not 0 < before.st_size <= _MAX_UNIT_BYTES
        ):
            raise CutoverError("watchdog_cutover_input_untrusted")
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        try:
            current = os.fstat(descriptor)
            identity = (
                current.st_dev, current.st_ino, stat.S_IMODE(current.st_mode),
                current.st_uid, current.st_nlink, current.st_size,
            )
            if identity != (
                before.st_dev, before.st_ino, stat.S_IMODE(before.st_mode),
                before.st_uid, before.st_nlink, before.st_size,
            ):
                raise CutoverError("watchdog_cutover_input_untrusted")
            content = os.read(descriptor, before.st_size + 1)
            if len(content) != before.st_size:
                raise CutoverError("watchdog_cutover_input_untrusted")
        finally:
            os.close(descriptor)
    except CutoverError:
        raise
    except OSError as exc:
        raise CutoverError("watchdog_cutover_input_untrusted") from exc
    return _File(path, content, identity)


def _maybe_file(path: Path) -> _File:
    try:
        path.lstat()
    except FileNotFoundError:
        return _File(path, None, None)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_input_untrusted") from exc
    return _read_file(path, mode=(0o600, 0o644) if path.name in OLD else 0o644)


def _maybe_link(path: Path) -> _Link:
    try:
        item = path.lstat()
    except FileNotFoundError:
        return _Link(path, None, None)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_input_untrusted") from exc
    if not stat.S_ISLNK(item.st_mode) or item.st_uid != os.geteuid() or item.st_nlink != 1:
        raise CutoverError("watchdog_cutover_input_untrusted")
    try:
        target = os.readlink(path)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_input_untrusted") from exc
    return _Link(path, target, (item.st_dev, item.st_ino, item.st_uid, item.st_nlink, item.st_size))


def _is_direct_unit_want(link: _Link, unit: Path) -> bool:
    if link.target is None:
        return False
    target = link.target
    candidate = target if os.path.isabs(target) else os.fspath(link.path.parent / target)
    return os.path.normpath(candidate) == os.fspath(unit)


def _exact_directive(content: bytes, expected: bytes) -> bool:
    key = expected.split(b"=", 1)[0] + b"="
    return [line for line in content.splitlines() if line.startswith(key)] == [expected]


def _validate_successor_units(units: dict[str, bytes]) -> None:
    service = units.get(NEW[0])
    timer = units.get(NEW[1])
    if not isinstance(service, bytes) or not isinstance(timer, bytes):
        raise CutoverError("watchdog_cutover_input_untrusted")
    if not _exact_directive(service, _CANONICAL_EXEC_START):
        raise CutoverError("watchdog_cutover_input_untrusted")
    if not all(_exact_directive(timer, directive) for directive in _CANONICAL_TIMER_DIRECTIVES):
        raise CutoverError("watchdog_cutover_input_untrusted")


def _source_units() -> dict[str, bytes]:
    root = Path(__file__).resolve().parents[1]
    source = root / "systemd" / "user"
    _trusted_chain(source)
    # A clean private checkout may have been cloned under umask 0077.  Source
    # inputs are immutable by ownership/no-follow/identity rather than by the
    # eventual installed unit mode, which remains exact 0644.
    result = {name: _read_file(source / name, mode=None).content for name in NEW}
    if any(value is None for value in result.values()):
        raise CutoverError("watchdog_cutover_input_untrusted")
    complete = {name: value for name, value in result.items() if value is not None}
    _validate_successor_units(complete)
    return complete


def _pointer_current(root: Path) -> tuple[str, str]:
    pointer = _read_file(root / ".the-hive-release-pointers.json", mode=0o644)
    if pointer.content is None or len(pointer.content) > _MAX_POINTER_BYTES:
        raise CutoverError("watchdog_cutover_input_untrusted")
    try:
        value = json.loads(pointer.content.decode("utf-8"))
        current = value["current"]
        generation = current["generation"]
        digest = current["manifest_digest"]
    except (KeyError, TypeError, UnicodeError, json.JSONDecodeError) as exc:
        raise CutoverError("watchdog_cutover_input_untrusted") from exc
    if (
        not isinstance(generation, str) or len(generation) != 40
        or any(item not in "0123456789abcdef" for item in generation)
        or not isinstance(digest, str) or len(digest) != 71 or not digest.startswith("sha256:")
    ):
        raise CutoverError("watchdog_cutover_input_untrusted")
    return generation, digest


def _bind_runtime(home: Path) -> dict[str, object]:
    """Bind current image and the stable launcher used by the successor unit."""

    source = Path(__file__).resolve().parents[1] / "src"
    if not source.is_dir():
        raise CutoverError("watchdog_cutover_input_untrusted")
    import sys
    source_text = os.fspath(source)
    prior_dont_write_bytecode = sys.dont_write_bytecode
    sys.dont_write_bytecode = True
    sys.path.insert(0, source_text)
    try:
        from the_hive.runtime_layout import RuntimeLayout
        root = home / ".local" / "lib" / "the-hive-runtime"
        _trusted_chain(root)
        generation, digest = _pointer_current(root)
        layout = RuntimeLayout.from_current_release(root, generation, digest)
        expected_stable = layout.read_attested_file("bin/the-hive-mcp-stable")
        stable = _read_file(root / "the-hive-mcp", mode=0o755)
    except (ImportError, ValueError, CutoverError) as exc:
        if isinstance(exc, CutoverError):
            raise
        raise CutoverError("watchdog_cutover_input_untrusted") from exc
    finally:
        sys.dont_write_bytecode = prior_dont_write_bytecode
        if sys.path and sys.path[0] == source_text:
            sys.path.pop(0)
    if stable.content != expected_stable:
        raise CutoverError("watchdog_cutover_input_untrusted")
    return {
        "generation": generation,
        "manifest_digest": digest,
        "mcp_path": os.fspath(root / "the-hive-mcp"),
        "identity": stable.identity,
    }


def _default_systemctl(*arguments: str) -> None:
    completed = subprocess.run(
        ["/usr/bin/systemctl", "--user", *arguments], check=False,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=30,
    )
    if completed.returncode != 0:
        raise CutoverError("watchdog_cutover_systemd_failed")


def _default_state(unit: str) -> tuple[bool, bool]:
    def check(command: str) -> bool:
        completed = subprocess.run(
            ["/usr/bin/systemctl", "--user", command, "--quiet", unit], check=False,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=15,
        )
        if completed.returncode not in {0, 1, 3}:
            raise CutoverError("watchdog_cutover_systemd_state_unknown")
        return completed.returncode == 0
    return check("is-enabled"), check("is-active")


def _default_observe(command: tuple[str, ...]) -> None:
    completed = subprocess.run(
        list(command), check=False, stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60,
        env={"HOME": os.fspath(Path(command[0]).parents[3]), "LANG": "C.UTF-8", "PATH": "/usr/bin:/bin"},
    )
    if completed.returncode != 0:
        raise CutoverError("watchdog_cutover_observation_failed")


def _bind(
    home: Path, state: Callable[[str], tuple[bool, bool]], *, create_unit_dir: bool
) -> _Binding:
    if not home.is_absolute():
        raise CutoverError("watchdog_cutover_input_untrusted")
    _trusted_chain(home)
    unit_dir = home / ".config" / "systemd" / "user"
    if create_unit_dir:
        _trusted_chain(unit_dir, create_leaf=True)
    else:
        current = home
        for component in (".config", "systemd", "user"):
            current /= component
            try:
                current.lstat()
            except FileNotFoundError:
                break
            _trusted_chain(current)
    unit_directory = _bind_directory(unit_dir) if unit_dir.exists() else None
    files = tuple(_maybe_file(unit_dir / name) for name in (*OLD, *NEW))
    wants_dir = unit_dir / "timers.target.wants"
    if wants_dir.exists():
        _trusted_chain(wants_dir)
    wants = tuple(_maybe_link(wants_dir / name) for name in (*OLD, *NEW))
    want_directories = {
        item.path.parent: _bind_directory(item.path.parent)
        for item in wants
        if item.target is not None
    }
    states = {name: state(name) for name in (*OLD, *NEW)}
    return _Binding(
        home, unit_dir, unit_directory, _bind_runtime(home), files, wants, want_directories, states,
    )


def _revalidate_bound_inputs(binding: _Binding, source_units: dict[str, bytes] | None = None) -> None:
    _trusted_chain(binding.home)
    _trusted_chain(binding.unit_dir)
    if binding.unit_directory is not None:
        descriptor = _open_bound_directory(binding.unit_directory)
        os.close(descriptor)
    for item in binding.files:
        current = _maybe_file(item.path)
        if current.content != item.content or current.identity != item.identity:
            raise CutoverError("watchdog_cutover_input_changed")
    for item in binding.wants:
        directory = binding.want_directories.get(item.path.parent)
        if directory is not None:
            descriptor = _open_bound_directory(directory)
            os.close(descriptor)
        current = _maybe_link(item.path)
        if current.target != item.target or current.identity != item.identity:
            raise CutoverError("watchdog_cutover_input_changed")
    current_runtime = _bind_runtime(binding.home)
    if current_runtime != binding.runtime:
        raise CutoverError("watchdog_cutover_input_changed")
    if source_units is not None and _source_units() != source_units:
        raise CutoverError("watchdog_cutover_input_changed")


def _revalidate_phase(
    binding: _Binding,
    source_units: dict[str, bytes],
    staged: dict[str, _File],
    state: Callable[[str], tuple[bool, bool]],
    expected_states: dict[str, tuple[bool, bool]],
    expected_wants: dict[Path, _Link] | None = None,
) -> None:
    """Rebind every still-live input immediately before one mutation phase."""

    _trusted_chain(binding.home)
    _trusted_chain(binding.unit_dir)
    if binding.unit_directory is None:
        raise CutoverError("watchdog_cutover_input_changed")
    descriptor = _open_bound_directory(binding.unit_directory)
    os.close(descriptor)
    if _bind_runtime(binding.home) != binding.runtime or _source_units() != source_units:
        raise CutoverError("watchdog_cutover_input_changed")
    for item in binding.files:
        expected = staged.get(item.path.name, item)
        current = _maybe_file(item.path)
        if current.content != expected.content or current.identity != expected.identity:
            raise CutoverError("watchdog_cutover_input_changed")
    for item in (expected_wants or {item.path: item for item in binding.wants}).values():
        current = _maybe_link(item.path)
        if current.target != item.target or current.identity != item.identity:
            raise CutoverError("watchdog_cutover_input_changed")
    if {name: state(name) for name in (*OLD, *NEW)} != expected_states:
        raise CutoverError("watchdog_cutover_state_changed")


def _write_unit(
    path: Path,
    content: bytes,
    *,
    mode: int = 0o644,
    before_mutation: Callable[[], None] | None = None,
    directory: _Directory | None = None,
    expected_destination: _File | None = None,
) -> _File:
    if not content or len(content) > _MAX_UNIT_BYTES or mode not in {0o600, 0o644}:
        raise CutoverError("watchdog_cutover_input_untrusted")
    parent = path.parent
    descriptor = -1
    parent_descriptor = -1
    temporary = None
    try:
        bound_parent = directory or _bind_directory(parent)
        parent_descriptor = _open_bound_directory(bound_parent)
        if before_mutation is not None:
            before_mutation()
        for _ in range(32):
            temporary_name = ".the-hive-watchdog." + secrets.token_hex(16)
            try:
                descriptor = os.open(
                    temporary_name,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                    mode,
                    dir_fd=parent_descriptor,
                )
                temporary = temporary_name
                break
            except FileExistsError:
                continue
        if descriptor < 0 or temporary is None:
            raise CutoverError("watchdog_cutover_write_failed")
        os.write(descriptor, content)
        os.fchmod(descriptor, mode)
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        if before_mutation is not None:
            before_mutation()
        if expected_destination is None:
            raise CutoverError("watchdog_cutover_input_untrusted")
        destination_matches = (
            _fd_entry_is_absent(parent_descriptor, path.name)
            if expected_destination.identity is None
            else _fd_entry_matches_file(parent_descriptor, path.name, expected_destination)
        )
        if not destination_matches:
            raise CutoverError("watchdog_cutover_input_changed")
        os.replace(temporary, path.name, src_dir_fd=parent_descriptor, dst_dir_fd=parent_descriptor)
        temporary = None
        os.fsync(parent_descriptor)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_write_failed") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        if parent_descriptor >= 0:
            os.close(parent_descriptor)
        if temporary is not None:
            try:
                # The FD pins the original parent even if its path is rebound.
                cleanup_parent = _open_bound_directory(directory or _bind_directory(parent))
                try:
                    os.unlink(temporary, dir_fd=cleanup_parent)
                finally:
                    os.close(cleanup_parent)
            except FileNotFoundError:
                pass
    written = _read_file(path, mode=mode)
    if written.content != content or written.identity is None:
        raise CutoverError("watchdog_cutover_write_failed")
    return written


def _remove(
    path: Path, *, expected: _File | None = None, directory: _Directory | None = None
) -> None:
    item = _maybe_file(path)
    if expected is not None and (item.content != expected.content or item.identity != expected.identity):
        raise CutoverError("watchdog_cutover_input_changed")
    if item.content is not None:
        try:
            parent_descriptor = _open_bound_directory(directory or _bind_directory(path.parent))
            try:
                if not _fd_entry_matches_file(parent_descriptor, path.name, item):
                    raise CutoverError("watchdog_cutover_input_changed")
                os.unlink(path.name, dir_fd=parent_descriptor)
                os.fsync(parent_descriptor)
            finally:
                os.close(parent_descriptor)
        except OSError as exc:
            raise CutoverError("watchdog_cutover_write_failed") from exc


def _backup_file(
    path: Path,
    expected: _File,
    backup_root: Path,
    backups: dict[Path, _Backup],
    *,
    before_mutation: Callable[[], None] | None = None,
    source_directory: _Directory | None = None,
    backup_directory: _Directory | None = None,
) -> None:
    current = _maybe_file(path)
    if current != expected:
        raise CutoverError("watchdog_cutover_input_changed")
    destination = backup_root / path.name
    try:
        if before_mutation is not None:
            before_mutation()
        if _maybe_file(path) != expected:
            raise CutoverError("watchdog_cutover_input_changed")
        source_descriptor = _open_bound_directory(source_directory or _bind_directory(path.parent))
        destination_descriptor = _open_bound_directory(
            backup_directory or _bind_directory(backup_root),
        )
        try:
            if not _fd_entry_matches_file(source_descriptor, path.name, expected):
                raise CutoverError("watchdog_cutover_input_changed")
            os.replace(
                path.name, destination.name,
                src_dir_fd=source_descriptor, dst_dir_fd=destination_descriptor,
            )
            os.fsync(source_descriptor)
            os.fsync(destination_descriptor)
        finally:
            os.close(source_descriptor)
            os.close(destination_descriptor)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_write_failed") from exc
    assert expected.identity is not None
    backups[path] = _Backup(destination, expected.identity, False)


def _backup_link(
    path: Path,
    expected: _Link,
    backup_root: Path,
    backups: dict[Path, _Backup],
    *,
    before_mutation: Callable[[], None] | None = None,
    source_directory: _Directory | None = None,
    backup_directory: _Directory | None = None,
) -> None:
    current = _maybe_link(path)
    if current != expected:
        raise CutoverError("watchdog_cutover_input_changed")
    destination = backup_root / f"want-{path.name}"
    try:
        if before_mutation is not None:
            before_mutation()
        if _maybe_link(path) != expected:
            raise CutoverError("watchdog_cutover_input_changed")
        source_descriptor = _open_bound_directory(source_directory or _bind_directory(path.parent))
        destination_descriptor = _open_bound_directory(
            backup_directory or _bind_directory(backup_root),
        )
        try:
            if not _fd_entry_matches_link(source_descriptor, path.name, expected):
                raise CutoverError("watchdog_cutover_input_changed")
            os.replace(
                path.name, destination.name,
                src_dir_fd=source_descriptor, dst_dir_fd=destination_descriptor,
            )
            os.fsync(source_descriptor)
            os.fsync(destination_descriptor)
        finally:
            os.close(source_descriptor)
            os.close(destination_descriptor)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_write_failed") from exc
    assert expected.identity is not None
    backups[path] = _Backup(destination, expected.identity, True)


def _restore_backups(
    backups: dict[Path, _Backup],
    binding: _Binding,
    staged: dict[str, _File],
    expected_wants: dict[Path, _Link],
    backup_directory: _Directory,
) -> None:
    for target, item in backups.items():
        backup = item.path
        if not backup.exists() and not backup.is_symlink():
            raise CutoverError("watchdog_cutover_rollback_verification_failed")
        if target.parent == binding.unit_dir:
            expected = staged.get(target.name, _File(target, None, None))
            if _maybe_file(target) != expected:
                raise CutoverError("watchdog_cutover_rollback_verification_failed")
            target_directory = binding.unit_directory
            original = next(item for item in binding.files if item.path == target)
            is_link = False
        else:
            expected_want = expected_wants[target]
            if _maybe_link(target) != expected_want:
                raise CutoverError("watchdog_cutover_rollback_verification_failed")
            target_directory = binding.want_directories.get(target.parent)
            original = next(item for item in binding.wants if item.path == target)
            expected = expected_want
            is_link = True
        if target_directory is None:
            raise CutoverError("watchdog_cutover_rollback_verification_failed")
        try:
            source_descriptor = _open_bound_directory(backup_directory)
            destination_descriptor = _open_bound_directory(target_directory)
            try:
                source_matches = (
                    _fd_entry_matches_link(source_descriptor, backup.name, original)
                    if is_link
                    else _fd_entry_matches_file(source_descriptor, backup.name, original)
                )
                target_matches = (
                    _fd_entry_is_absent(destination_descriptor, target.name)
                    if expected.identity is None
                    else (
                        _fd_entry_matches_link(destination_descriptor, target.name, expected)
                        if is_link
                        else _fd_entry_matches_file(destination_descriptor, target.name, expected)
                    )
                )
                if not source_matches or not target_matches:
                    raise CutoverError("watchdog_cutover_rollback_verification_failed")
                os.replace(
                    backup.name, target.name,
                    src_dir_fd=source_descriptor, dst_dir_fd=destination_descriptor,
                )
                os.fsync(source_descriptor)
                os.fsync(destination_descriptor)
            finally:
                os.close(source_descriptor)
                os.close(destination_descriptor)
        except OSError as exc:
            raise CutoverError("watchdog_cutover_rollback_verification_failed") from exc


def _require_current_file(path: Path, expected: _File) -> None:
    if _maybe_file(path) != expected:
        raise CutoverError("watchdog_cutover_rollback_verification_failed")


def _restore_files(binding: _Binding, staged: dict[str, _File]) -> None:
    for item in binding.files:
        content = item.content
        if content is None:
            expected = staged.get(item.path.name)
            current = _maybe_file(item.path)
            if expected is None:
                if current.content is not None:
                    raise CutoverError("watchdog_cutover_input_changed")
            else:
                _remove(item.path, expected=expected, directory=binding.unit_directory)
        else:
            current = _maybe_file(item.path)
            if current.content is None:
                assert item.identity is not None
                _write_unit(
                    item.path,
                    content,
                    mode=item.identity[2],
                    directory=binding.unit_directory,
                    before_mutation=lambda: _require_current_file(item.path, current),
                    expected_destination=current,
                )
            elif staged.get(item.path.name) == current:
                assert item.identity is not None
                _write_unit(
                    item.path,
                    content,
                    mode=item.identity[2],
                    directory=binding.unit_directory,
                    before_mutation=lambda: _require_current_file(item.path, current),
                    expected_destination=current,
                )
            elif current.content != content or current.identity != item.identity:
                raise CutoverError("watchdog_cutover_input_changed")


def _restore_wants(binding: _Binding, expected_wants: dict[Path, _Link]) -> None:
    for item in binding.wants:
        current = _maybe_link(item.path)
        if current == item:
            continue
        if current != expected_wants[item.path]:
            raise CutoverError("watchdog_cutover_rollback_verification_failed")
        if current.target is not None:
            try:
                parent = binding.want_directories.get(item.path.parent)
                if parent is None:
                    raise CutoverError("watchdog_cutover_rollback_verification_failed")
                descriptor = _open_bound_directory(parent)
                try:
                    if not _fd_entry_matches_link(descriptor, item.path.name, current):
                        raise CutoverError("watchdog_cutover_rollback_verification_failed")
                    os.unlink(item.path.name, dir_fd=descriptor)
                    os.fsync(descriptor)
                finally:
                    os.close(descriptor)
            except OSError as exc:
                raise CutoverError("watchdog_cutover_write_failed") from exc


def _restore_states(binding: _Binding, systemctl: Callable[..., None]) -> None:
    for name in (NEW[1], NEW[0], OLD[1], OLD[0]):
        systemctl("stop", name)
        systemctl("disable", name)
    systemctl("daemon-reload")
    for name, (enabled, active) in binding.states.items():
        if enabled:
            systemctl("enable", name)
        if active:
            systemctl("start", name)


def _verify_rollback(binding: _Binding, state: Callable[[str], tuple[bool, bool]]) -> None:
    """Read back the complete persisted/manager rollback contract before reporting it."""

    _trusted_chain(binding.home)
    _trusted_chain(binding.unit_dir)
    if _bind_runtime(binding.home) != binding.runtime:
        raise CutoverError("watchdog_cutover_rollback_verification_failed")
    for item in binding.files:
        current = _maybe_file(item.path)
        if item.content is None:
            if current.content is not None:
                raise CutoverError("watchdog_cutover_rollback_verification_failed")
        elif (
            current.content != item.content
            or current.identity is None
            or item.identity is None
            or current.identity != item.identity
        ):
            raise CutoverError("watchdog_cutover_rollback_verification_failed")
    for item in binding.wants:
        current = _maybe_link(item.path)
        if current.target != item.target or current.identity != item.identity:
            raise CutoverError("watchdog_cutover_rollback_verification_failed")
    if {name: state(name) for name in (*OLD, *NEW)} != binding.states:
        raise CutoverError("watchdog_cutover_rollback_verification_failed")


def _verify_complete_cutover(
    binding: _Binding,
    source_units: dict[str, bytes],
    staged: dict[str, _File],
    expected_wants: dict[Path, _Link],
    state: Callable[[str], tuple[bool, bool]],
) -> None:
    """Read the committed namespace independently before declaring the one-way cutover."""

    _trusted_chain(binding.home)
    _trusted_chain(binding.unit_dir)
    if _bind_runtime(binding.home) != binding.runtime or _source_units() != source_units:
        raise CutoverError("watchdog_cutover_postcondition_failed")
    for item in binding.files:
        current = _maybe_file(item.path)
        if item.path.name in OLD:
            if current.content is not None:
                raise CutoverError("watchdog_cutover_postcondition_failed")
            continue
        expected = staged[item.path.name]
        if current.content != expected.content or current.identity != expected.identity:
            raise CutoverError("watchdog_cutover_postcondition_failed")
    for path, expected in expected_wants.items():
        current = _maybe_link(path)
        if current.target != expected.target or current.identity != expected.identity:
            raise CutoverError("watchdog_cutover_postcondition_failed")
    _require_exclusive_target_state(state)


def _watchdog_command(runtime: dict[str, object]) -> tuple[str, ...]:
    value = runtime.get("mcp_path")
    if not isinstance(value, str) or not value.startswith("/"):
        raise CutoverError("watchdog_cutover_input_untrusted")
    return (
        value, "watchdog", "active", "--idle-seconds", "60", "--poll-interval-seconds", "15",
        "--report-grace-seconds", "15", "--action", "stop", "--manage-unclaimed", "--quiet",
    )


def _require_exclusive_target_state(state: Callable[[str], tuple[bool, bool]]) -> None:
    old_states = {name: state(name) for name in OLD}
    if any(enabled or active for enabled, active in old_states.values()):
        raise CutoverError("watchdog_cutover_postcondition_failed")
    if state(NEW[1]) != (True, True):
        raise CutoverError("watchdog_cutover_postcondition_failed")


def _already_green(binding: _Binding, source_units: dict[str, bytes]) -> bool:
    files = {item.path.name: item.content for item in binding.files}
    return (
        all(files[name] is None for name in OLD)
        and all(not enabled and not active for enabled, active in (binding.states[name] for name in OLD))
        and all(item.target is None for item in binding.wants if item.path.name in OLD)
        and all(files[name] == source_units[name] for name in NEW)
        and binding.states[NEW[1]] == (True, True)
    )


def _reject_mixed_supervisor_prestate(binding: _Binding) -> None:
    old_live = any(enabled or active for enabled, active in (binding.states[name] for name in OLD))
    new_service_enabled, new_service_active = binding.states[NEW[0]]
    new_timer_enabled, new_timer_active = binding.states[NEW[1]]
    if new_service_active or (
        old_live and (new_service_enabled or new_timer_enabled or new_timer_active)
    ):
        raise CutoverError("watchdog_cutover_mixed_prestate")


def _lock_identity(parent_descriptor: int, descriptor: int, name: str) -> tuple[int, int, int, int, int, int]:
    """Return one exact no-follow lock identity held under the pinned parent FD."""

    try:
        item = os.fstat(descriptor)
        entry = os.stat(name, dir_fd=parent_descriptor, follow_symlinks=False)
    except OSError as exc:
        raise CutoverError("watchdog_cutover_lock_unavailable") from exc
    identity = (
        item.st_dev, item.st_ino, stat.S_IMODE(item.st_mode),
        item.st_uid, item.st_nlink, item.st_size,
    )
    if (
        not stat.S_ISREG(item.st_mode)
        or item.st_uid != os.geteuid()
        or item.st_nlink != 1
        or stat.S_IMODE(item.st_mode) != 0o600
        or identity != (
            entry.st_dev, entry.st_ino, stat.S_IMODE(entry.st_mode),
            entry.st_uid, entry.st_nlink, entry.st_size,
        )
    ):
        raise CutoverError("watchdog_cutover_lock_unavailable")
    return identity


def _open_lifecycle_entry(parent_descriptor: int, name: str) -> tuple[int, tuple[int, int, int, int, int, int]]:
    try:
        descriptor = os.open(
            name,
            os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=parent_descriptor,
        )
    except OSError as exc:
        raise CutoverError("watchdog_cutover_in_progress") from exc
    try:
        return descriptor, _lock_identity(parent_descriptor, descriptor, name)
    except BaseException:
        os.close(descriptor)
        raise


def _acquire_lifecycle_lock(home: Path) -> _LifecycleLock:
    _trusted_chain(home)
    lock_root = home / ".local" / "state" / "codex-master-mcp"
    anchor_parent = _bind_directory(home / ".local")
    guard_parent = _bind_directory(lock_root.parent)
    root_descriptor = -1
    guard_descriptor = -1
    guard_parent_descriptor = -1
    anchor_descriptor = -1
    anchor_parent_descriptor = -1
    descriptor = -1
    try:
        anchor_parent_descriptor = _open_bound_directory(anchor_parent)
        anchor_descriptor, anchor_identity = _open_lifecycle_entry(
            anchor_parent_descriptor, _LOCK_ANCHOR_NAME,
        )
        fcntl.flock(anchor_descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        guard_parent_descriptor = _open_bound_directory(guard_parent)
        guard_descriptor, guard_identity = _open_lifecycle_entry(
            guard_parent_descriptor, _LOCK_GUARD_NAME,
        )
        fcntl.flock(guard_descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        root = _bind_directory(lock_root)
        root_descriptor = _open_bound_directory(root)
        descriptor, identity = _open_lifecycle_entry(root_descriptor, _LOCK_NAME)
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        _lock_identity(root_descriptor, descriptor, _LOCK_NAME)
        return _LifecycleLock(
            descriptor, root_descriptor, root, identity,
            guard_descriptor, guard_parent, guard_parent_descriptor, guard_identity,
            anchor_descriptor, anchor_parent, anchor_parent_descriptor, anchor_identity,
        )
    except CutoverError:
        if descriptor >= 0:
            os.close(descriptor)
        if root_descriptor >= 0:
            os.close(root_descriptor)
        if guard_descriptor >= 0:
            os.close(guard_descriptor)
        if guard_parent_descriptor >= 0:
            os.close(guard_parent_descriptor)
        if anchor_descriptor >= 0:
            os.close(anchor_descriptor)
        if anchor_parent_descriptor >= 0:
            os.close(anchor_parent_descriptor)
        raise
    except OSError as exc:
        if descriptor >= 0:
            os.close(descriptor)
        if root_descriptor >= 0:
            os.close(root_descriptor)
        if guard_descriptor >= 0:
            os.close(guard_descriptor)
        if guard_parent_descriptor >= 0:
            os.close(guard_parent_descriptor)
        if anchor_descriptor >= 0:
            os.close(anchor_descriptor)
        if anchor_parent_descriptor >= 0:
            os.close(anchor_parent_descriptor)
        raise CutoverError("watchdog_cutover_in_progress") from exc


def _revalidate_lifecycle_lock_root(lock: _LifecycleLock) -> None:
    # Reopen all names to ensure that no namespace rebind has bypassed the
    # nested root/guard/anchor transaction locks; check entries via pinned FDs.
    descriptor = _open_bound_directory(lock.root)
    os.close(descriptor)
    descriptor = _open_bound_directory(lock.guard_parent)
    os.close(descriptor)
    descriptor = _open_bound_directory(lock.anchor_parent)
    os.close(descriptor)
    root_current = os.fstat(lock.root_descriptor)
    guard_current = os.fstat(lock.guard_parent_descriptor)
    anchor_current = os.fstat(lock.anchor_parent_descriptor)
    if (
        (root_current.st_dev, root_current.st_ino, stat.S_IMODE(root_current.st_mode), root_current.st_uid)
        != lock.root.identity
        or (guard_current.st_dev, guard_current.st_ino, stat.S_IMODE(guard_current.st_mode), guard_current.st_uid)
        != lock.guard_parent.identity
        or (anchor_current.st_dev, anchor_current.st_ino, stat.S_IMODE(anchor_current.st_mode), anchor_current.st_uid)
        != lock.anchor_parent.identity
        or _lock_identity(lock.root_descriptor, lock.descriptor, _LOCK_NAME) != lock.identity
        or _lock_identity(
            lock.guard_parent_descriptor, lock.guard_descriptor, _LOCK_GUARD_NAME,
        )
        != lock.guard_identity
        or _lock_identity(
            lock.anchor_parent_descriptor, lock.anchor_descriptor, _LOCK_ANCHOR_NAME,
        )
        != lock.anchor_identity
    ):
        raise CutoverError("watchdog_cutover_lock_unavailable")


def cutover(
    *, home: Path, systemctl: Callable[..., None] = _default_systemctl,
    observe: Callable[[tuple[str, ...]], None] = _default_observe,
    state: Callable[[str], tuple[bool, bool]] = _default_state,
) -> dict[str, object]:
    """Run the one-way Fleet namespace migration or restore its exact prior state."""

    lock = _acquire_lifecycle_lock(home)
    try:
        _revalidate_lifecycle_lock_root(lock)
        binding = _bind(home, state, create_unit_dir=True)
        source_units = _source_units()
        staged: dict[str, _File] = {}
        backups: dict[Path, _Backup] = {}
        expected_states = dict(binding.states)
        expected_wants = {item.path: item for item in binding.wants}

        def revalidate_phase() -> None:
            _revalidate_lifecycle_lock_root(lock)
            _revalidate_phase(
                binding, source_units, staged, state, expected_states, expected_wants,
            )

        def systemd_phase(*arguments: str) -> None:
            revalidate_phase()
            systemctl(*arguments)
            if len(arguments) == 2 and arguments[1] in expected_states:
                action, name = arguments
                enabled, active = expected_states[name]
                if action == "stop":
                    expected_states[name] = (enabled, False)
                elif action == "disable":
                    expected_states[name] = (False, active)
                elif action == "enable":
                    expected_states[name] = (True, active)
                elif action == "start":
                    expected_states[name] = (enabled, True)

        def observe_phase() -> None:
            """Fence the stop-capable observer on both sides of its live-state read."""

            revalidate_phase()
            _require_exclusive_target_state(state)
            revalidate_phase()
            _require_exclusive_target_state(state)
            observe(_watchdog_command(binding.runtime))
            _require_exclusive_target_state(state)

        # This is deliberately outside the rollback region: no live unit or
        # systemd state has changed yet, so a rebind is a fail-closed refusal,
        # not a partially committed transaction.
        revalidate_phase()
        _reject_mixed_supervisor_prestate(binding)
        if _already_green(binding, source_units):
            observe_phase()
            return {"status": "cutover_complete", "raw_output": "not_returned"}
        revalidate_phase()
        if binding.unit_directory is None:
            raise CutoverError("watchdog_cutover_input_changed")
        _revalidate_lifecycle_lock_root(lock)
        backup_directory = _create_backup_directory(binding.unit_directory)
        backup_root = backup_directory.path

        def before_mutation() -> None:
            revalidate_phase()

        try:
            for name in NEW:
                original = next(item for item in binding.files if item.path.name == name)
                if original.content is not None:
                    _backup_file(
                        original.path, original, backup_root, backups,
                        before_mutation=before_mutation,
                        source_directory=binding.unit_directory,
                        backup_directory=backup_directory,
                    )
                    staged[name] = _File(original.path, None, None)
                staged[name] = _write_unit(
                    binding.unit_dir / name,
                    source_units[name],
                    before_mutation=before_mutation,
                    directory=binding.unit_directory,
                    expected_destination=_File(binding.unit_dir / name, None, None),
                )
            revalidate_phase()
            systemd_phase("daemon-reload")
            for name in (OLD[1], OLD[0]):
                revalidate_phase()
                systemd_phase("stop", name)
                expected_states[name] = (expected_states[name][0], False)
                revalidate_phase()
                systemd_phase("disable", name)
                expected_states[name] = (False, expected_states[name][1])
            revalidate_phase()
            systemd_phase("enable", NEW[1])
            expected_states[NEW[1]] = (True, expected_states[NEW[1]][1])
            timer_want = binding.unit_dir / "timers.target.wants" / NEW[1]
            created_want = _maybe_link(timer_want)
            prior_want = expected_wants[timer_want]
            if prior_want.target is None:
                # User managers normally create this want during enable.  A
                # manager may instead retain enablement outside this local
                # wants directory, so bind an observed new link if present
                # and let the separately bound manager state attest either.
                if created_want.target is not None:
                    if not _is_direct_unit_want(created_want, binding.unit_dir / NEW[1]):
                        raise CutoverError("watchdog_cutover_input_changed")
                    expected_wants[timer_want] = created_want
            elif created_want != prior_want:
                raise CutoverError("watchdog_cutover_input_changed")
            revalidate_phase()
            systemd_phase("start", NEW[1])
            expected_states[NEW[1]] = (expected_states[NEW[1]][0], True)
            observe_phase()
            for name in OLD:
                old_file = next(item for item in binding.files if item.path.name == name)
                if old_file.content is not None:
                    revalidate_phase()
                    _backup_file(
                        old_file.path, old_file, backup_root, backups,
                        before_mutation=before_mutation,
                        source_directory=binding.unit_directory,
                        backup_directory=backup_directory,
                    )
                    staged[name] = _File(old_file.path, None, None)
                old_want = next(item for item in binding.wants if item.path.name == name)
                if old_want.target is not None:
                    revalidate_phase()
                    _backup_link(
                        old_want.path, old_want, backup_root, backups,
                        before_mutation=before_mutation,
                        source_directory=binding.want_directories.get(old_want.path.parent),
                        backup_directory=backup_directory,
                    )
                    expected_wants[old_want.path] = _Link(old_want.path, None, None)
            revalidate_phase()
            systemd_phase("daemon-reload")
            _verify_complete_cutover(binding, source_units, staged, expected_wants, state)
            _revalidate_lifecycle_lock_root(lock)
            _discard_committed_backups(backups, backup_directory, binding.unit_directory)
            return {"status": "cutover_complete", "raw_output": "not_returned"}
        except BaseException as original:
            # A revalidation refusal before any bound successor object or
            # manager state changed must not invoke a compensating systemd
            # mutation.  It may still have created transaction-private files,
            # which are removed and read back before returning the refusal.
            no_successor_mutation = all(
                _maybe_file(item.path) == item
                for item in binding.files
                if item.path.name in NEW
            )
            no_manager_mutation = {
                name: state(name) for name in (*OLD, *NEW)
            } == binding.states
            if not backups and no_successor_mutation and no_manager_mutation:
                try:
                    _revalidate_lifecycle_lock_root(lock)
                    _remove_empty_backup_directory(backup_directory, binding.unit_directory)
                except BaseException as rollback_error:
                    raise CutoverError("watchdog_cutover_rollback_failed") from rollback_error
                raise original
            try:
                _revalidate_lifecycle_lock_root(lock)
                _restore_backups(
                    backups, binding, staged, expected_wants, backup_directory,
                )
                bound_want_paths = {item.path for item in binding.wants}
                for target in backups:
                    if target in bound_want_paths:
                        expected_wants[target] = _maybe_link(target)
                _revalidate_lifecycle_lock_root(lock)
                _restore_files(binding, staged)
                staged = {item.path.name: item for item in binding.files}
                _revalidate_lifecycle_lock_root(lock)
                # Bind the manager's actual post-failure state once, before
                # rollback starts; every following systemd operation is then
                # individually revalidated against its prior result.
                expected_states = {name: state(name) for name in (*OLD, *NEW)}
                _restore_states(binding, systemd_phase)
                _revalidate_lifecycle_lock_root(lock)
                _restore_wants(binding, expected_wants)
                expected_wants = {item.path: item for item in binding.wants}
                systemd_phase("daemon-reload")
                _verify_rollback(binding, state)
                _revalidate_lifecycle_lock_root(lock)
                _remove_empty_backup_directory(backup_directory, binding.unit_directory)
            except BaseException as rollback_error:
                raise CutoverError("watchdog_cutover_rollback_failed") from rollback_error
            raise CutoverError("watchdog_cutover_rolled_back") from original
    finally:
        os.close(lock.descriptor)
        os.close(lock.root_descriptor)
        os.close(lock.guard_descriptor)
        os.close(lock.guard_parent_descriptor)
        os.close(lock.anchor_descriptor)
        os.close(lock.anchor_parent_descriptor)


def status(*, home: Path, state: Callable[[str], tuple[bool, bool]] = _default_state) -> dict[str, object]:
    """Return bounded read-only namespace and scheduler state."""

    binding = _bind(home, state, create_unit_dir=False)
    return {
        "status": "ok",
        "units": {name: {"enabled": enabled, "active": active} for name, (enabled, active) in binding.states.items()},
        "legacy_present": any(item.content is not None for item in binding.files[:2]),
        "successor_present": all(item.content is not None for item in binding.files[2:]),
        "raw_output": "not_returned",
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="the-hive-fleet-watchdog")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("cutover", "status"):
        command = commands.add_parser(name)
        command.add_argument("--home", required=True, type=Path)
    arguments = parser.parse_args(argv)
    try:
        result = cutover(home=arguments.home) if arguments.command == "cutover" else status(home=arguments.home)
        print(json.dumps(result, sort_keys=True))
        return 0
    except CutoverError as exc:
        print(json.dumps({"status": str(exc), "raw_output": "not_returned"}, sort_keys=True))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
