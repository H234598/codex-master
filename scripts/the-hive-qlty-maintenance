#!/usr/bin/env python3
"""Coordinate attested upgrades, shared guards and Queen-ordered precommit checks."""

from __future__ import annotations

import argparse
from collections.abc import Iterator
from contextlib import contextmanager
from datetime import datetime
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import tempfile
import time
from typing import TypedDict
from uuid import uuid4
import yaml

DAY = 24 * 60 * 60


class CheckStep(TypedDict):
    command: list[str]
    exit_code: int
    stdout: str
    stderr: str
    stdout_sha256: str
    stderr_sha256: str
    source_before: dict[str, str | None]
    source_after: dict[str, str | None]
    started_at: float
    ended_at: float


def private_directory(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    info = path.lstat()
    if (
        not stat.S_ISDIR(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_mode & 0o077
    ):
        raise ValueError("qlty_state_directory_untrusted")


def atomic_json(path: Path, value: dict) -> None:
    fd, name = tempfile.mkstemp(prefix=".qlty-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(value, stream, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(name, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        Path(name).unlink(missing_ok=True)


@contextmanager
def record_lock(state_root: Path, identity: str, suffix: str = ""):
    private_directory(state_root)
    key = hashlib.sha256(identity.encode()).hexdigest()
    fd = os.open(
        state_root / f"{key}{suffix}.lock",
        os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW,
        0o600,
    )
    try:
        info = os.fstat(fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.getuid()
            or info.st_nlink != 1
            or info.st_mode & 0o077
        ):
            raise ValueError("qlty_lock_untrusted")
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield state_root / f"{key}{suffix}.json"
    finally:
        os.close(fd)


def read_record(record: Path) -> dict:
    record_fd = os.open(record, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(record_fd) as stream:
        info = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.getuid()
            or info.st_nlink != 1
            or info.st_mode & 0o077
            or info.st_size > 1048576
        ):
            raise ValueError("qlty_record_untrusted")
        value = json.load(stream)
    if not isinstance(value, dict):
        raise ValueError("qlty_record_invalid")
    return value


@contextmanager
def upgrade_claim(state_root: Path) -> Iterator[tuple[Path, dict[str, object]] | None]:
    """Limit only the attested CLI upgrade, including failed or interrupted upgrades."""
    identity = "qlty-upgrade"
    with record_lock(state_root, identity) as record:
        previous = (
            read_record(record) if record.exists() or record.is_symlink() else None
        )
        now = time.time()
        if (
            isinstance(now, bool)
            or not isinstance(now, (int, float))
            or not math.isfinite(now)
            or now < 0
        ):
            raise ValueError("qlty_attempt_time_invalid")
        if previous is not None:
            started = previous["attempted_at"]
            if (
                isinstance(started, bool)
                or not isinstance(started, (int, float))
                or not math.isfinite(started)
                or started < 0
            ):
                raise ValueError("qlty_attempt_invalid")
            if now - started < DAY:
                yield None
                return
        value: dict[str, object] = {
            "identity": identity,
            "attempted_at": now,
            "status": "running",
            "steps": [],
        }
        atomic_json(record, value)
        yield record, value


def execute_steps(
    record: Path,
    value: dict,
    commands: list[list[str]],
    *,
    cwd: Path | None,
    expected_source: dict | None = None,
) -> int:
    logs = record.parent / "logs"
    private_directory(logs)
    run_logs = logs / uuid4().hex
    run_logs.mkdir(mode=0o700)
    for index, command in enumerate(commands):
        before = source_state(cwd) if cwd else None
        expected = (
            value["steps"][-1].get("source_after")
            if value["steps"]
            else value.get("source_before")
        )
        if index == 0 and expected_source is not None:
            expected = expected_source
        if cwd and before != expected:
            value["status"] = "source_changed"
            value["source_observed"] = before
            atomic_json(record, value)
            return 1
        log = run_logs / f"{index:02d}-{Path(command[1]).name}.log"
        with log.open("xb") as stream:
            environment = dict(os.environ, HOME=pwd.getpwuid(os.getuid()).pw_dir)
            result = subprocess.run(
                command,
                cwd=cwd,
                env=environment,
                stdout=stream,
                stderr=subprocess.STDOUT,
                check=False,
            )
        after = source_state(cwd) if cwd else None
        with log.open("rb") as stream:
            log_hash = hashlib.file_digest(stream, "sha256").hexdigest()
        value["steps"].append(
            {
                "command": command[1:],
                "exit_code": result.returncode,
                "log": str(log),
                "log_sha256": log_hash,
                "source_before": before,
                "source_after": after,
            }
        )
        if cwd and command[1] != "fmt" and before != after:
            value["status"] = "source_changed"
            atomic_json(record, value)
            return 1
        atomic_json(record, value)
    value["status"] = (
        "complete"
        if all(step["exit_code"] == 0 for step in value["steps"])
        else "findings_or_error"
    )
    atomic_json(record, value)
    return 0 if value["status"] == "complete" else 1


def upgrade(state_root: Path, qlty: str) -> int:
    with upgrade_claim(state_root) as claimed:
        if claimed is None:
            return 0
        if not os.access(qlty, os.X_OK):
            installer = str(Path(__file__).with_name("install-qlty.sh"))
            if execute_steps(*claimed, [["/bin/bash", installer]], cwd=None):
                return 1
            if not os.access(qlty, os.X_OK):
                claimed[1]["status"] = "cli_unavailable"
                atomic_json(*claimed)
                return 1
        return execute_steps(
            *claimed, [[qlty, "upgrade", "--verify-attestations"]], cwd=None
        )


def repository_identity(repository: Path) -> str:
    common = subprocess.check_output(
        [
            "git",
            "-C",
            str(repository),
            "rev-parse",
            "--path-format=absolute",
            "--git-common-dir",
        ],
        text=True,
    ).strip()
    path = Path(common).resolve(strict=True)
    info = path.stat()
    return f"{path}\0{info.st_dev}:{info.st_ino}"


def repository_binding(repository: Path) -> dict:
    root = Path(
        subprocess.check_output(
            ["git", "-C", str(repository), "rev-parse", "--show-toplevel"], text=True
        ).strip()
    ).resolve(strict=True)
    info = root.stat()
    return {
        "repository": str(root),
        "identity": repository_identity(root),
        "device": info.st_dev,
        "inode": info.st_ino,
    }


def source_state(
    repository: Path, *, exclude: tuple[str, ...] = ()
) -> dict[str, str | None]:
    """Bind tracked source bytes and metadata; never read untracked credentials."""

    def git(*arguments):
        return subprocess.check_output(["git", "-C", str(repository), *arguments])

    paths = git("ls-files", "--cached", "--others", "--exclude-standard", "-z").split(
        b"\0"
    )
    metadata: list[tuple[str, int, int, int, int, int, int] | tuple[str, str]] = []
    for raw in paths:
        if raw and os.fsdecode(raw) not in exclude:
            path = os.fsdecode(raw)
            try:
                info = (repository / path).lstat()
                metadata.append(
                    (
                        path,
                        info.st_dev,
                        info.st_ino,
                        info.st_mode,
                        info.st_size,
                        info.st_mtime_ns,
                        info.st_ctime_ns,
                    )
                )
            except FileNotFoundError:
                metadata.append((path, "missing"))
    head = subprocess.run(
        ["git", "-C", str(repository), "rev-parse", "--verify", "--quiet", "HEAD"],
        text=True,
        capture_output=True,
    )
    if head.returncode not in {0, 1}:
        raise ValueError("qlty_source_head_unavailable")
    revision = ["HEAD"] if head.returncode == 0 else []
    patch = git(
        "diff",
        "--binary",
        "--full-index",
        *revision,
        "--",
        ".",
        *(f":(exclude,literal){path}" for path in exclude),
    )
    index = git(
        "diff",
        "--cached",
        "--binary",
        "--full-index",
        "--",
        ".",
        *(f":(exclude,literal){path}" for path in exclude),
    )
    return {
        "head": head.stdout.strip() if head.returncode == 0 else None,
        "patch_sha256": hashlib.sha256(patch + index).hexdigest(),
        "file_metadata_sha256": hashlib.sha256(
            json.dumps(metadata, sort_keys=True).encode()
        ).hexdigest(),
    }


def work_document(path: Path) -> dict:
    if not path.exists() and not path.is_symlink():
        return {"schema_version": 1, "revision": 0, "guards": []}
    value = read_record(path)
    if (
        value.get("schema_version") != 1
        or not isinstance(value.get("guards"), list)
        or type(value.get("revision")) is not int
    ):
        raise ValueError("qlty_work_record_invalid")
    return value


def registered_state(repository: Path, state_root: Path) -> dict:
    with record_lock(state_root, repository_identity(repository), ".work") as record:
        return work_document(record)


def begin_guard(repository: Path, state_root: Path, *, owner: str, phase: str) -> dict:
    if (
        not owner
        or len(owner) > 256
        or any(ord(character) < 32 for character in owner)
        or phase not in {"work", "freeze", "test", "precommit"}
    ):
        raise ValueError("qlty_work_owner_invalid")
    binding = repository_binding(repository)
    with record_lock(state_root, binding["identity"], ".work") as record:
        document = work_document(record)
        if document.get("format_guard") is not None:
            raise ValueError("qlty_format_owner_unresolved")
        if (
            phase == "precommit"
            and document["guards"]
            or any(row["phase"] == "precommit" for row in document["guards"])
        ):
            raise ValueError("qlty_precommit_guard_active")
        if phase == "work" and any(
            row["phase"] in {"freeze", "test"} for row in document["guards"]
        ):
            raise ValueError("qlty_source_freeze_active")
        if phase in {"freeze", "test"} and any(
            row["phase"] == "work" for row in document["guards"]
        ):
            raise ValueError("qlty_work_guard_active")
        guard = {
            "guard_id": uuid4().hex,
            "owner": owner,
            "phase": phase,
            "binding": binding,
            "started_at": time.time(),
        }
        document["guards"].append(guard)
        document["revision"] += 1
        atomic_json(record, document)
        return guard


def end_guard(repository: Path, state_root: Path, *, owner: str, guard_id: str) -> dict:
    binding = repository_binding(repository)
    with record_lock(state_root, binding["identity"], ".work") as record:
        document = work_document(record)
        matches = [
            guard
            for guard in document["guards"]
            if guard["guard_id"] == guard_id
            and guard["owner"] == owner
            and guard["binding"] == binding
        ]
        if len(matches) != 1:
            raise ValueError("qlty_guard_owner_mismatch")
        document["guards"].remove(matches[0])
        document["revision"] += 1
        atomic_json(record, document)
        return {"ended_guard_id": guard_id, "coverage": "declared_local_work_only"}


def config_semantic_sha256(config: str) -> str:
    document = yaml.safe_load(config)

    def validate(value: object) -> None:
        if isinstance(value, dict):
            if any(type(key) is not str for key in value):
                raise ValueError("qlty_config_key_invalid")
            for child in value.values():
                validate(child)
        elif isinstance(value, list):
            for child in value:
                validate(child)
        elif type(value) not in (str, int, float, bool, type(None)):
            raise ValueError("qlty_config_value_invalid")

    validate(document)
    encoded = json.dumps(
        document,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
        allow_nan=False,
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def plugin_snapshots_equal(before: dict, after: dict) -> bool:
    return {key: value for key, value in before.items() if key != "config_sha256"} == {
        key: value for key, value in after.items() if key != "config_sha256"
    }


def plugin_evidence(config: str, catalog: str, version: str) -> dict:
    """Validate the CLI's merged definitions, including hidden supported plugins."""
    definitions_text = config.split("  definitions:\n", 1)[1].split("\nlanguage:", 1)[0]
    definitions = re.split(r"(?m)^    ([a-z0-9-]+):\n", definitions_text)
    supported = dict(zip(definitions[1::2], definitions[2::2]))
    enabled_text = config.split("\nplugin:\n", 1)[1].split("\nsmells:", 1)[0]
    enabled = re.findall(r"(?m)^- name: ([a-z0-9-]+)$", enabled_text)
    visible = set(re.findall(r"(?m)^  (?:✔ )?([a-z0-9-]+)$", catalog))
    hidden = {
        name
        for name, body in supported.items()
        if re.search(r"(?m)^      hidden: true$", body)
    }
    if (
        not supported
        or len(enabled) != len(set(enabled))
        or set(enabled) != set(supported)
        or visible != set(supported) - hidden
    ):
        raise ValueError("qlty_all_plugins_required")
    for block in re.split(r"(?m)^- name: ", enabled_text)[1:]:
        if any(
            not re.search(rf"(?m)^  {field}: {expected}$", block)
            for field, expected in [
                ("mode", "null"),
                ("triggers", r"\[\]"),
                ("skip_upstream", "null"),
            ]
        ):
            raise ValueError("qlty_plugin_restriction")
    if not version.startswith("qlty "):
        raise ValueError("qlty_version_missing")
    definitions = yaml.safe_load(config)["plugins"]["definitions"]
    formatters = sorted(
        [name, driver_name]
        for name, definition in definitions.items()
        for driver_name, driver in (definition.get("drivers") or {}).items()
        if driver.get("driver_type") == "formatter"
    )
    return {
        "formatters": formatters,
        "supported": sorted(supported),
        "enabled": sorted(enabled),
        "hidden": sorted(hidden),
        "version": version.strip(),
        "config_sha256": hashlib.sha256(config.encode()).hexdigest(),
        "config_semantic_sha256": config_semantic_sha256(config),
        "catalog_sha256": hashlib.sha256(catalog.encode()).hexdigest(),
    }


def bind_invocation_output(repository: Path) -> tuple[int, list[int], list[tuple]]:
    """Pin Qlty's local output or its exact per-workspace cache alias."""
    descriptors: list[int] = []
    entries: list[tuple] = []

    def identity(info: os.stat_result) -> tuple:
        return (info.st_dev, info.st_ino, info.st_uid, info.st_mode)

    def open_root(path: Path) -> int:
        if path.resolve(strict=True) != path:
            raise ValueError("qlty_invocation_path_untrusted")
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        descriptors.append(fd)
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise ValueError("qlty_invocation_path_untrusted")
        entries.append((None, path, identity(info)))
        return fd

    def open_directory(parent: int, name: str) -> int:
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        descriptors.append(fd)
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise ValueError("qlty_invocation_path_untrusted")
        entries.append((parent, name, identity(info)))
        return fd

    try:
        local = open_directory(open_root(repository), ".qlty")
        info = os.stat("out", dir_fd=local, follow_symlinks=False)
        if stat.S_ISLNK(info.st_mode):
            home = Path(pwd.getpwuid(os.getuid()).pw_dir)
            fingerprint = hashlib.md5(
                str(repository / ".qlty").encode(), usedforsecurity=False
            ).hexdigest()
            expected = home / ".qlty/cache/repos" / fingerprint / "out"
            if (
                info.st_uid != os.getuid()
                or info.st_nlink != 1
                or os.readlink("out", dir_fd=local) != str(expected)
            ):
                raise ValueError("qlty_invocation_path_untrusted")
            entries.append((local, "out", identity(info)))
            fd = open_root(home)
            for part in (".qlty", "cache", "repos", fingerprint, "out"):
                fd = open_directory(fd, part)
        else:
            fd = open_directory(local, "out")
        validate_invocation_output(entries)
        return fd, descriptors, entries
    except BaseException:
        for fd in reversed(descriptors):
            os.close(fd)
        raise


def validate_invocation_output(entries: list[tuple]) -> None:
    for parent, name, expected in entries:
        info = (
            os.lstat(name)
            if parent is None
            else os.stat(name, dir_fd=parent, follow_symlinks=False)
        )
        if (info.st_dev, info.st_ino, info.st_uid, info.st_mode) != expected:
            raise ValueError("qlty_invocation_path_untrusted")


def staged_formatter_cwd(
    cwd: Path, temporary: Path, temporary_fd: int, identity: tuple
) -> str:
    info = os.lstat(temporary)
    held = os.fstat(temporary_fd)
    if (info.st_dev, info.st_ino, info.st_uid, info.st_mode) != identity or (
        held.st_dev,
        held.st_ino,
        held.st_uid,
        held.st_mode,
    ) != identity:
        raise ValueError("qlty_staging_root_untrusted")
    if not cwd.is_absolute() or ".." in cwd.parts:
        raise ValueError("qlty_invocation_record_mismatch")
    try:
        parts = cwd.relative_to(temporary).parts
    except ValueError as error:
        raise ValueError("qlty_invocation_record_mismatch") from error
    if (
        len(parts) < 2
        or parts[0] != "qlty"
        or not re.fullmatch(r"[A-Za-z0-9]{8}-rw", parts[1])
    ):
        raise ValueError("qlty_invocation_record_mismatch")
    current = os.dup(temporary_fd)
    try:
        for part in parts:
            try:
                next_fd = os.open(
                    part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=current
                )
            except FileNotFoundError:
                break
            os.close(current)
            current = next_fd
            child = os.fstat(current)
            if child.st_uid != os.getuid() or child.st_mode & 0o022:
                raise ValueError("qlty_staging_root_untrusted")
    finally:
        os.close(current)
    return parts[1]


def precommit(
    repository: Path,
    state_root: Path,
    qlty: str,
    *,
    owner: str,
    format_paths: list[str],
) -> int:
    """Run one explicitly ordered check; there is no repository time claim."""
    repository = Path(repository_binding(repository)["repository"])
    if not format_paths or len(set(format_paths)) != len(format_paths):
        raise ValueError("qlty_format_scope_required")
    for name in format_paths:
        path = repository / name
        if (
            Path(name).is_absolute()
            or ".." in Path(name).parts
            or path.resolve(strict=True) != path
            or not path.is_file()
        ):
            raise ValueError("qlty_format_scope_invalid")
    private_directory(state_root)
    logs = state_root / "logs"
    private_directory(logs)
    logs = logs / uuid4().hex
    logs.mkdir(mode=0o700)
    record = logs / "precommit.json"
    steps: list[CheckStep] = []
    value: dict[str, object] = {
        "owner": owner,
        "format_paths": format_paths,
        "source_before": source_state(repository),
        "cli_sha256": hashlib.sha256(Path(qlty).read_bytes()).hexdigest(),
        "steps": steps,
        "status": "running",
    }
    guard = begin_guard(repository, state_root, owner=owner, phase="precommit")
    value["guard"] = guard
    output_descriptors: list[int] = []
    check_tmp = logs / "check-tmp"
    check_tmp_fd: int | None = None
    check_tmp_identity: tuple | None = None

    def capture(arguments: list[str], label: str) -> CheckStep:
        nonlocal check_tmp, check_tmp_fd, check_tmp_identity
        before = source_state(repository)
        expected = steps[-1]["source_after"] if steps else value["source_before"]
        if before != expected or repository_binding(repository) != guard["binding"]:
            raise ValueError("qlty_source_changed")
        stdout, stderr = logs / (label + ".stdout"), logs / (label + ".stderr")
        environment = dict(os.environ, HOME=pwd.getpwuid(os.getuid()).pw_dir)
        if arguments[0] == "check":
            if check_tmp_fd is not None:
                os.close(check_tmp_fd)
                check_tmp_fd = None
            check_tmp = logs / (label + "-tmp")
            check_tmp.mkdir(mode=0o700)
            check_tmp_fd = os.open(
                check_tmp, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
            )
            info = os.fstat(check_tmp_fd)
            if info.st_uid != os.getuid() or info.st_mode & 0o077:
                raise ValueError("qlty_staging_root_untrusted")
            check_tmp_identity = (info.st_dev, info.st_ino, info.st_uid, info.st_mode)
            environment["TMPDIR"] = str(check_tmp)
        started_at = time.time()
        with stdout.open("xb") as output, stderr.open("xb") as errors:
            result = subprocess.run(
                [qlty, *arguments],
                cwd=repository,
                env=environment,
                stdout=output,
                stderr=errors,
                check=False,
            )
        after = source_state(repository)
        step: CheckStep = {
            "command": arguments,
            "exit_code": result.returncode,
            "stdout": str(stdout),
            "stderr": str(stderr),
            "stdout_sha256": hashlib.sha256(stdout.read_bytes()).hexdigest(),
            "stderr_sha256": hashlib.sha256(stderr.read_bytes()).hexdigest(),
            "source_before": before,
            "source_after": after,
            "started_at": started_at,
            "ended_at": time.time(),
        }
        steps.append(step)
        atomic_json(record, value)
        if arguments[0] != "fmt" and before != after:
            raise ValueError("qlty_source_changed")
        return step

    def plugins(label: str) -> dict:
        results = [
            capture(args, label + suffix)
            for args, suffix in [
                (["--version"], "-version"),
                (["config", "show"], "-config"),
                (["plugins", "list"], "-catalog"),
            ]
        ]
        if any(step["exit_code"] for step in results):
            raise ValueError("qlty_plugin_evidence_failed")
        version, config, catalog = [
            Path(step["stdout"]).read_text() for step in results
        ]
        return plugin_evidence(config, catalog, version)

    try:
        atomic_json(record, value)
        before_plugins = plugins("before")
        value["plugins_before"] = before_plugins
        outside = source_state(repository, exclude=tuple(format_paths))
        formatted = capture(
            [
                "fmt",
                "--filter=ruff,prettier,shfmt",
                "--no-progress",
                "--skip-source-fetch",
                "--no-upgrade-check",
                "--",
                *format_paths,
            ],
            "fmt",
        )
        if source_state(repository, exclude=tuple(format_paths)) != outside:
            raise ValueError("qlty_format_scope_changed")
        if formatted["exit_code"]:
            raise ValueError("qlty_format_failed")
        value["formatted_source"] = source_state(repository)
        value["candidate_sha256"] = {
            name: hashlib.sha256((repository / name).read_bytes()).hexdigest()
            for name in format_paths
        }
        output_fd, output_descriptors, output_entries = bind_invocation_output(
            repository
        )
        for command, flags in [
            ("metrics", []),
            ("smells", ["--no-snippets"]),
            (
                "check",
                [
                    "--no-fix",
                    "--no-cache",
                    "--sarif",
                    "--no-progress",
                    "--print-errors",
                    "--debug",
                    "--skip-source-fetch",
                ],
            ),
        ]:
            capture([command, "--all", "--no-upgrade-check", *flags], command)
        check = steps[-1]

        def consume_check(check: CheckStep) -> tuple[dict, set[str]]:
            sarif = json.loads(Path(check["stdout"]).read_text())
            runs = sarif.get("runs", []) if isinstance(sarif, dict) else []
            if (
                not isinstance(sarif, dict)
                or sarif.get("version") != "2.1.0"
                or not isinstance(runs, list)
                or not runs
                or any(
                    not isinstance(run, dict)
                    or not isinstance(run.get("invocations"), list)
                    or not run["invocations"]
                    or any(
                        not isinstance(invocation, dict)
                        or invocation.get("executionSuccessful") is not True
                        for invocation in run["invocations"]
                    )
                    for run in runs
                )
            ):
                raise ValueError("qlty_sarif_incomplete")
            completed: dict[str, dict[str, str]] = {}
            candidate_targets: set[str] = set()
            stage_name: str | None = None
            if "--no-cache" not in check["command"] or check["exit_code"] not in {0, 1}:
                raise ValueError("qlty_check_execution_failed")
            for run in runs:
                driver = run.get("tool", {}).get("driver", {})
                semantic_version = driver.get("semanticVersion")
                if semantic_version != before_plugins["version"].split()[1]:
                    raise ValueError("qlty_producer_version_mismatch")
                for invocation in run["invocations"]:
                    for notice in invocation.get("toolExecutionNotifications", []):
                        kind = notice.get("descriptor", {}).get("id", "")
                        if kind == "qlty:message:invocation.concluded.error":
                            raise ValueError("qlty_invocation_failed")
                        if kind != "qlty:message:invocation.concluded.success":
                            continue
                        match = re.search(
                            r"\[([A-Za-z0-9_-]{1,64})\](?:\n|$)",
                            notice["message"]["text"],
                        )
                        if not match or match[1] in completed:
                            raise ValueError("qlty_invocation_identity_invalid")
                        name = match[1]
                        validate_invocation_output(output_entries)
                        with os.fdopen(
                            os.open(
                                f"invoke-{name}.yaml",
                                os.O_RDONLY | os.O_NOFOLLOW,
                                dir_fd=output_fd,
                            ),
                            "rb",
                        ) as stream:
                            info = os.fstat(stream.fileno())
                            if (
                                not stat.S_ISREG(info.st_mode)
                                or info.st_uid != os.getuid()
                                or info.st_nlink != 1
                                or info.st_mode & 0o022
                            ):
                                raise ValueError("qlty_invocation_file_untrusted")
                            raw = stream.read()
                        validate_invocation_output(output_entries)
                        document = yaml.safe_load(raw)
                        if not isinstance(document, dict):
                            raise ValueError("qlty_invocation_record_invalid")
                        targets = document.get("targetPaths")
                        started = document.get("startedAt")
                        if isinstance(started, str):
                            started = datetime.fromisoformat(started)
                        cwd_text = document.get("cwd")
                        if not isinstance(cwd_text, str):
                            raise ValueError("qlty_invocation_record_mismatch")
                        cwd = Path(cwd_text)
                        if cwd.resolve() != cwd or not cwd.resolve().is_relative_to(
                            repository
                        ):
                            if (
                                [document.get("pluginName"), document.get("driverName")]
                                not in before_plugins["formatters"]
                                or check_tmp_fd is None
                                or check_tmp_identity is None
                            ):
                                raise ValueError("qlty_invocation_record_mismatch")
                            current_stage = staged_formatter_cwd(
                                cwd, check_tmp, check_tmp_fd, check_tmp_identity
                            )
                            if stage_name is not None and stage_name != current_stage:
                                raise ValueError("qlty_invocation_record_mismatch")
                            stage_name = current_stage
                        if (
                            document.get("id") != name
                            or document.get("qltyCliVersion")
                            != before_plugins["version"].split()[1]
                            or document.get("pluginName")
                            not in before_plugins["enabled"]
                            or document.get("verb") != "EXECUTION_VERB_CHECK"
                            or not isinstance(targets, list)
                            or not targets
                            or any(not isinstance(target, str) for target in targets)
                            or type(document.get("targetsCount")) is not int
                            or document["targetsCount"] != len(targets)
                            or not isinstance(started, datetime)
                            or started.utcoffset() is None
                            or not check["started_at"]
                            <= started.timestamp()
                            <= check["ended_at"]
                            or not re.fullmatch(
                                r"[0-9]+", str(document.get("exitCode", ""))
                            )
                            or document.get("exitResult")
                            not in {"EXIT_RESULT_SUCCESS", "EXIT_RESULT_NO_ISSUES"}
                        ):
                            raise ValueError("qlty_invocation_record_mismatch")
                        copy = logs / f"invoke-{name}.yaml"
                        with copy.open("xb") as output:
                            output.write(raw)
                        completed[name] = {
                            "sha256": hashlib.sha256(raw).hexdigest(),
                            "path": str(copy),
                        }
                        candidate_targets.update(
                            set(targets).intersection(format_paths)
                        )
            if not completed:
                raise ValueError("qlty_no_actual_invocations")
            return completed, candidate_targets

        completed, candidate_targets = consume_check(check)
        missing = sorted(set(format_paths) - candidate_targets)
        if missing:
            supplement = capture(
                [
                    "check",
                    "--no-upgrade-check",
                    "--no-fix",
                    "--no-cache",
                    "--sarif",
                    "--no-progress",
                    "--print-errors",
                    "--debug",
                    "--skip-source-fetch",
                    "--",
                    *missing,
                ],
                "check-supplement",
            )
            extra_completed, extra_targets = consume_check(supplement)
            if completed.keys() & extra_completed.keys():
                raise ValueError("qlty_invocation_identity_invalid")
            if not set(missing).issubset(extra_targets):
                raise ValueError("qlty_candidate_coverage_incomplete")
            completed.update(extra_completed)
            candidate_targets.update(extra_targets)
        if not candidate_targets:
            raise ValueError("qlty_no_actual_invocations")
        value["invocation_evidence"] = {
            "completed": len(completed),
            "file_targets": len(candidate_targets),
            "records": completed,
        }
        after_plugins = plugins("after")
        value["plugins_after"] = after_plugins
        if not plugin_snapshots_equal(before_plugins, after_plugins):
            raise ValueError("qlty_plugins_changed")
        if value["cli_sha256"] != hashlib.sha256(Path(qlty).read_bytes()).hexdigest():
            raise ValueError("qlty_cli_changed")
        value["final_source"] = source_state(repository)
        value["status"] = (
            "complete"
            if all(step["exit_code"] == 0 for step in steps)
            else "findings_or_error"
        )
        return 0 if value["status"] == "complete" else 1
    except (
        OSError,
        ValueError,
        IndexError,
        KeyError,
        TypeError,
        yaml.YAMLError,
        subprocess.SubprocessError,
    ) as error:
        value["status"], value["reason"] = "hold", str(error)
        return 2
    finally:
        if check_tmp_fd is not None:
            os.close(check_tmp_fd)
        for fd in reversed(output_descriptors):
            os.close(fd)
        atomic_json(record, value)
        end_guard(repository, state_root, owner=owner, guard_id=guard["guard_id"])
        print(
            json.dumps(
                {"receipt": str(record), "status": value["status"]}, sort_keys=True
            )
        )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    operator_home = Path(pwd.getpwuid(os.getuid()).pw_dir)
    parser.add_argument(
        "operation", choices=["upgrade", "begin", "end", "status", "precommit"]
    )
    parser.add_argument(
        "--state-root",
        type=Path,
        default=operator_home / ".local/state/the-hive/qlty-maintenance",
    )
    parser.add_argument("--qlty", default=str(operator_home / ".qlty/bin/qlty"))
    parser.add_argument("--repo", type=Path)
    parser.add_argument("--owner")
    parser.add_argument("--phase", choices=["work", "freeze", "test"], default="work")
    parser.add_argument("--guard-id")
    parser.add_argument("--format-path", action="append", default=[])
    args = parser.parse_args()
    if args.operation == "upgrade":
        return upgrade(args.state_root, args.qlty)
    if (
        args.repo is None
        or args.operation in {"begin", "end", "precommit"}
        and not args.owner
        or args.operation == "end"
        and not args.guard_id
    ):
        parser.error("--repo and the operation's owner/guard fields are required")
    if args.operation == "precommit":
        return precommit(
            args.repo,
            args.state_root,
            args.qlty,
            owner=args.owner,
            format_paths=args.format_path,
        )
    if args.operation == "begin":
        result = begin_guard(
            args.repo, args.state_root, owner=args.owner, phase=args.phase
        )
    elif args.operation == "end":
        result = end_guard(
            args.repo, args.state_root, owner=args.owner, guard_id=args.guard_id
        )
    else:
        result = registered_state(args.repo, args.state_root)
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ValueError, OSError, subprocess.SubprocessError) as error:
        reason = (
            str(error) if isinstance(error, ValueError) else "qlty_environment_error"
        )
        print(
            json.dumps(
                {"status": "hold", "reason": reason, "error_type": type(error).__name__}
            )
        )
        raise SystemExit(2)
