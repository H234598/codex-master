{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 ${PLUGIN_ROOT}/com.github.copilot/hooks/copilot_bridge.py",
        "timeoutSec": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python3 ${PLUGIN_ROOT}/com.github.copilot/hooks/copilot_bridge.py",
        "timeoutSec": 10
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ${PLUGIN_ROOT}/com.github.copilot/hooks/copilot_bridge.py",
        "timeoutSec": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python3 ${PLUGIN_ROOT}/com.github.copilot/hooks/copilot_bridge.py",
        "timeoutSec": 10
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "python3 ${PLUGIN_ROOT}/com.github.copilot/hooks/copilot_bridge.py",
        "timeoutSec": 10
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "python3 ${PLUGIN_ROOT}/com.github.copilot/hooks/copilot_bridge.py",
        "timeoutSec": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ${PLUGIN_ROOT}/com.github.copilot/hooks/copilot_bridge.py",
        "timeoutSec": 10
      }
    ],
    "SessionEnd": [
      {
        "type": "command",
        "command": "python3 ${PLUGIN_ROOT}/com.github.copilot/hooks/copilot_bridge.py",
        "timeoutSec": 10
      }
    ]
  }
}
