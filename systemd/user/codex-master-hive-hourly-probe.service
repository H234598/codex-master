[Unit]
Description=Codex Master Hive hourly self-test
Documentation=man:systemd.service(5)

[Service]
Type=oneshot
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=tmpfs
KeyringMode=private
ProtectSystem=strict
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
IPAddressDeny=any
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077
ReadOnlyPaths=/usr/bin/python3
BindReadOnlyPaths=%h/.local/lib/codex-master-runtime:%h/.local/lib/codex-master-runtime:norbind
BindPaths=%h/.local/state/codex-master-mcp:%h/.local/state/codex-master-mcp:norbind
ReadWritePaths=%h/.local/state/codex-master-mcp
ExecStart=%h/.local/lib/codex-master-runtime/bin/codex-master-hive-hourly-probe --json
