[Unit]
Description=The-Hive OpenAI Modell- und Preisbestand täglich aktualisieren

[Service]
Type=oneshot
ExecStart=%h/.local/bin/the-hive-openai-pricing-inventory
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
StateDirectory=the-hive/openai-pricing
StateDirectoryMode=0700
ReadWritePaths=%h/.local/state/the-hive/openai-pricing
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
UMask=0077
