[Unit]
Description=The Hive Hive hourly self-test
Documentation=man:systemd.service(5)

[Service]
Type=oneshot
# Sum of the named Runtime Image Probe contract; regression-tested at install.
TimeoutStartSec=107s
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=tmpfs
KeyringMode=private
ProtectSystem=strict
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
IPAddressDeny=any
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0077
ReadOnlyPaths=/usr/bin/python3
# RuntimeLayout attests the release pointer and both retained generations.
BindReadOnlyPaths=%h/.local/lib/the-hive-runtime:%h/.local/lib/the-hive-runtime:norbind
BindPaths=%h/.local/state/codex-master-mcp:%h/.local/state/codex-master-mcp:norbind
ReadWritePaths=%h/.local/state/codex-master-mcp
ExecStart=%h/.local/lib/the-hive-runtime/generations/@MASTERJET_GENERATION@/bin/the-hive-hive-hourly-probe %h/.local/lib/the-hive-runtime @MASTERJET_GENERATION@ @MASTERJET_MANIFEST_DIGEST@ --json
