[Unit]
Description=The Hive administration daemon
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=notify
User=the-hive-admin
Group=the-hive-admin
SupplementaryGroups=the-hive-agent-state
WorkingDirectory=/var/empty
RuntimeDirectory=the-hive-admin
RuntimeDirectoryMode=0700
StateDirectory=codex-master-admin
StateDirectoryMode=0700
UMask=0007
ReadWritePaths=/run/the-hive-admin /var/lib/codex-master-admin /var/lib/codex-master-agent
LoadCredential=admin-config:/etc/the-hive-admin/admin-config.json
LoadCredential=admin-bearer:/etc/the-hive-admin/admin-bearer
LoadCredential=admin-totp:/etc/the-hive-admin/admin-totp
LoadCredential=admin-attestation:/etc/the-hive-admin/admin-attestation
LoadCredential=admin-vault-key:/etc/the-hive-admin/admin-vault-key
LoadCredential=admin-quota-evidence:/etc/the-hive-admin/admin-quota-evidence.json
LoadCredential=agent-bindings:/etc/the-hive-admin/agent-bindings.json
ExecStart=@THE_HIVE_BINDIR@/the-hive-admin
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
