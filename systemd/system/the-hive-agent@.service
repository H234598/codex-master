[Unit]
Description=The Hive agent launcher

[Service]
Type=exec
DynamicUser=yes
ExecStart=/usr/bin/python3 -I -E -s -P /usr/libexec/the-hive-agent-launcher
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateMounts=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=~@mount @module @keyring bpf
