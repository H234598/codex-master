[Unit]
Description=Codex Master home broker verifier

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/var/empty
Environment=PATH=/usr/sbin:/usr/bin
StateDirectory=codex-master-home-broker
StateDirectoryMode=0700
ExecStart=/usr/libexec/codex-master-broker-verify
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=~@mount @module @keyring bpf
