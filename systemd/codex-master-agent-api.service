[Unit]
Description=Codex Master isolated host-agent TLS API
Wants=network-online.target
Requires=codex-master-admin.service
After=network-online.target codex-master-admin.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=exec
User=codex-master-agent-api
Group=codex-master-agent-api
SupplementaryGroups=codex-master-agent-state
WorkingDirectory=/var/empty
UMask=0007
ReadWritePaths=/var/lib/codex-master-agent
LoadCredential=agent-server-key:/etc/codex-master/agent-server.key
LoadCredential=agent-server-cert:/etc/codex-master/agent-server.crt
LoadCredential=agent-client-ca:/etc/codex-master/agent-client-ca.crt
LoadCredential=agent-listen-address:/etc/codex-master/agent-listen-address
ExecStart=@CODEX_MASTER_BINDIR@/codex-master-agent-api --listen-address-credential --port=9443
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
