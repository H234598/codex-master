{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-master.local/schemas/hive-test-evidence-receipt-v1.schema.json",
  "title": "Hive Test Evidence Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository_id",
    "index_digest",
    "function_ids",
    "test_id",
    "source_digest_set_digest",
    "test_digest",
    "assertion_digest",
    "dependency_digest_set_digest",
    "executor_fingerprint",
    "boot_id_digest",
    "runner_version_digest",
    "environment_digest",
    "attempt_id",
    "started_at",
    "finished_at",
    "started_monotonic_ns",
    "finished_monotonic_ns",
    "result",
    "reason_code",
    "duration_ms",
    "cooldown_class",
    "expires_monotonic_ns"
  ],
  "properties": {
    "repository_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "index_digest": { "$ref": "#/$defs/digest" },
    "function_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "test_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "source_digest_set_digest": { "$ref": "#/$defs/digest" },
    "test_digest": { "$ref": "#/$defs/digest" },
    "assertion_digest": { "$ref": "#/$defs/digest" },
    "dependency_digest_set_digest": { "$ref": "#/$defs/digest" },
    "executor_fingerprint": { "$ref": "#/$defs/digest" },
    "boot_id_digest": { "$ref": "#/$defs/digest" },
    "runner_version_digest": { "$ref": "#/$defs/digest" },
    "environment_digest": { "$ref": "#/$defs/digest" },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "started_at": { "type": "string", "minLength": 20, "maxLength": 40, "pattern": "Z$" },
    "finished_at": { "type": "string", "minLength": 20, "maxLength": 40, "pattern": "Z$" },
    "started_monotonic_ns": { "type": "integer", "minimum": 0 },
    "finished_monotonic_ns": { "type": "integer", "minimum": 0 },
    "result": { "enum": ["passed", "failed", "blocked", "cancelled"] },
    "reason_code": { "type": "string", "minLength": 1, "maxLength": 128 },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "cooldown_class": { "enum": ["deterministic", "integration", "environmental", "external", "mandatory"] },
    "expires_monotonic_ns": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
