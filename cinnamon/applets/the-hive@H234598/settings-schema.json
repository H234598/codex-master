{
  "tracked-agents": {
    "type": "entry",
    "description": "Beobachtete Agentinnen",
    "tooltip": "Kommagetrennte konkrete IDs, zum Beispiel a1,b1. Erlaubt sind 1 bis 6 IDs aus a1 bis c100.",
    "default": "a1,b1"
  },
  "refresh-on-open": {
    "type": "switch",
    "description": "Beim Öffnen aktualisieren",
    "default": true
  },
  "background-refresh": {
    "type": "switch",
    "description": "Im Hintergrund aktualisieren",
    "tooltip": "Standardmäßig aus. Aktualisierungen bleiben read-only.",
    "default": false
  },
  "refresh-interval-seconds": {
    "type": "spinbutton",
    "description": "Aktualisierungsintervall",
    "default": 60,
    "min": 15,
    "max": 3600,
    "step": 15,
    "units": "Sekunden"
  },
  "overview-interval-seconds": {
    "type": "spinbutton",
    "description": "Fleet-Overview-Intervall",
    "default": 30,
    "min": 15,
    "max": 3600,
    "step": 15,
    "units": "Sekunden"
  },
  "overview-session-no-active-only": {
    "type": "switch",
    "description": "Overview sessionsbasiert vollständig anzeigen",
    "default": false
  },
  "overview-compact": {
    "type": "switch",
    "description": "Overview kompakt anzeigen",
    "default": true
  },
  "overview-detail": {
    "type": "switch",
    "description": "Overview-Agentdetails anzeigen",
    "default": true
  },
  "terminal-command": {
    "type": "entry",
    "description": "Terminal für Flottenstatus",
