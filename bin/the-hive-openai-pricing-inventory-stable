#!/usr/bin/bash
set -euo pipefail

stable_path="${BASH_SOURCE[0]}"
launcher_name="the-hive-openai-pricing-inventory"
bin_dir="${stable_path%/${launcher_name}}"
local_root="${bin_dir%/bin}"
[[ "${bin_dir}" != "${stable_path}" && "${bin_dir}" == /* && "${bin_dir}/${launcher_name}" == "${stable_path}" && "${local_root}" != "${bin_dir}" && "${local_root}" == /* && "${local_root}/bin" == "${bin_dir}" ]] || exit 64
release_root="${local_root}/lib/the-hive-runtime"
for variable in "${!CODEX_@}"; do unset "${variable}"; done
unset PYTHONHOME PYTHONPATH
export PATH=/usr/bin:/bin
exec /usr/bin/python3 -I -B -c '
import hashlib
import json
import os
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
stable_path = Path(sys.argv[2])
try:
    if stable_path != root.parent.parent / "bin" / "the-hive-openai-pricing-inventory":
        raise ValueError("invalid stable path")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    pointer = root / ".the-hive-release-pointers.json"
    descriptor = os.open(pointer, flags)
    try:
        current = os.fstat(descriptor)
        if (
            not stat.S_ISREG(current.st_mode)
            or current.st_nlink != 1
            or current.st_uid != os.geteuid()
            or stat.S_IMODE(current.st_mode) != 0o644
            or current.st_size <= 0
            or current.st_size > 256 * 1024
        ):
            raise ValueError("invalid pointer")
        raw = os.read(descriptor, current.st_size + 1)
        if len(raw) != current.st_size:
            raise ValueError("pointer changed")
    finally:
        os.close(descriptor)

    def unique_object(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise ValueError("duplicate pointer member")
            value[key] = item
        return value

    pointers = json.loads(raw.decode("utf-8"), object_pairs_hook=unique_object)
    if (
        not isinstance(pointers, dict)
        or set(pointers) != {"schema_version", "current", "previous"}
        or pointers.get("schema_version") != 1
        or not isinstance(pointers.get("current"), dict)
        or set(pointers["current"]) != {"generation", "manifest_digest"}
    ):
        raise ValueError("invalid current pointer")
    generation = pointers["current"]["generation"]
    digest = pointers["current"]["manifest_digest"]
    if (
        not isinstance(generation, str)
        or not generation
        or "/" in generation
        or generation in {".", ".."}
        or not isinstance(digest, str)
        or not digest.startswith("sha256:")
        or len(digest) != 71
        or any(character not in "0123456789abcdef" for character in digest[7:])
    ):
        raise ValueError("invalid release binding")
    manifest_path = root / "generations" / generation / ".the-hive-runtime-manifest.json"
    descriptor = os.open(manifest_path, flags)
    try:
        manifest_stat = os.fstat(descriptor)
        if (
            not stat.S_ISREG(manifest_stat.st_mode)
            or manifest_stat.st_nlink != 1
            or manifest_stat.st_uid != os.geteuid()
            or stat.S_IMODE(manifest_stat.st_mode) != 0o644
            or manifest_stat.st_size <= 0
            or manifest_stat.st_size > 512 * 1024
        ):
            raise ValueError("invalid manifest")
        manifest_raw = os.read(descriptor, manifest_stat.st_size + 1)
        if len(manifest_raw) != manifest_stat.st_size:
            raise ValueError("manifest changed")
    finally:
        os.close(descriptor)
    if "sha256:" + hashlib.sha256(manifest_raw).hexdigest() != digest:
        raise ValueError("manifest digest mismatch")
    manifest = json.loads(manifest_raw.decode("utf-8"), object_pairs_hook=unique_object)
    files = manifest.get("files") if isinstance(manifest, dict) else None
    expected = (
        files.get("bin/the-hive-openai-pricing-inventory-stable")
        if isinstance(files, dict)
        else None
    )
    if (
        not isinstance(expected, dict)
        or set(expected) != {"mode", "nlink", "size", "sha256"}
        or expected.get("mode") != 0o755
        or expected.get("nlink") != 1
        or not isinstance(expected.get("size"), int)
        or expected["size"] <= 0
        or not isinstance(expected.get("sha256"), str)
        or len(expected["sha256"]) != 64
    ):
        raise ValueError("stable launcher absent from manifest")
    stable = stable_path.lstat()
    if (
        not stat.S_ISREG(stable.st_mode)
        or stable.st_nlink != 1
        or stable.st_uid != os.geteuid()
        or stat.S_IMODE(stable.st_mode) != 0o755
        or stable.st_size != expected["size"]
    ):
        raise ValueError("stable launcher invalid")
    descriptor = os.open(stable_path, flags)
    try:
        stable_raw = os.read(descriptor, stable.st_size + 1)
        if len(stable_raw) != stable.st_size:
            raise ValueError("stable launcher changed")
    finally:
        os.close(descriptor)
    if hashlib.sha256(stable_raw).hexdigest() != expected["sha256"]:
        raise ValueError("stable launcher drift")
    entry_expected = (
        files.get("bin/the-hive-openai-pricing-inventory")
        if isinstance(files, dict)
        else None
    )
    if (
        not isinstance(entry_expected, dict)
        or set(entry_expected) != {"mode", "nlink", "size", "sha256"}
        or entry_expected.get("mode") != 0o755
        or entry_expected.get("nlink") != 1
        or not isinstance(entry_expected.get("size"), int)
        or entry_expected["size"] <= 0
        or not isinstance(entry_expected.get("sha256"), str)
        or len(entry_expected["sha256"]) != 64
    ):
        raise ValueError("invalid release entrypoint")
    entrypoint = root / "generations" / generation / "bin" / "the-hive-openai-pricing-inventory"
    entry_descriptor = -1
    try:
        entry_descriptor = os.open(entrypoint, flags)
        entry = os.fstat(entry_descriptor)
        if (
            not stat.S_ISREG(entry.st_mode)
            or entry.st_nlink != 1
            or entry.st_uid != os.geteuid()
            or stat.S_IMODE(entry.st_mode) != entry_expected["mode"]
            or entry.st_size != entry_expected["size"]
        ):
            raise ValueError("invalid release entrypoint")
        entry_raw = os.read(entry_descriptor, entry.st_size + 1)
        if (
            len(entry_raw) != entry.st_size
            or hashlib.sha256(entry_raw).hexdigest() != entry_expected["sha256"]
        ):
            raise ValueError("release entrypoint drift")
        os.lseek(entry_descriptor, 0, os.SEEK_SET)
        os.set_inheritable(entry_descriptor, True)
        pinned_entry = f"/proc/self/fd/{entry_descriptor}"
        os.execve(
            pinned_entry,
            [pinned_entry, str(root), generation, digest, *sys.argv[3:]],
            {
                "HOME": os.fspath(root.parents[2]),
                "LANG": "C.UTF-8",
                "PATH": "/usr/bin:/bin",
                "PYTHONNOUSERSITE": "1",
                "PYTHONDONTWRITEBYTECODE": "1",
            },
        )
    except Exception:
        if entry_descriptor >= 0:
            os.close(entry_descriptor)
        raise
except Exception:
    raise SystemExit(64)
' "$release_root" "$stable_path" "$@"
