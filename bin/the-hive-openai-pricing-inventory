#!/usr/bin/bash
set -euo pipefail

if (( $# < 3 )); then
    exit 64
fi
release_root="$1"
generation="$2"
manifest_digest="$3"
for variable in "${!CODEX_@}"; do unset "${variable}"; done
unset PYTHONHOME PYTHONPATH
export PATH=/usr/bin:/bin
exec /usr/bin/python3 -I -B -c '
import fcntl
import os
import runpy
import stat
import sys
from pathlib import Path


def fail():
    raise SystemExit(64)


root = Path(sys.argv[1])
generation = sys.argv[2]
manifest_digest = sys.argv[3]
if (
    not root.is_absolute()
    or not generation
    or "/" in generation
    or generation in {".", ".."}
    or not manifest_digest.startswith("sha256:")
    or len(manifest_digest) != 71
    or any(character not in "0123456789abcdef" for character in manifest_digest[7:])
):
    fail()
candidate = root / "generations" / generation / "src"
try:
    sys.path.insert(0, str(candidate))
    from the_hive.runtime_layout import RuntimeLayout

    layout = RuntimeLayout.from_current_release(root, generation, manifest_digest)
except Exception:
    fail()
if layout.root / "src" != candidate:
    fail()
lock_descriptor = os.environ.pop("THE_HIVE_RUNTIME_PUBLISH_LOCK_FD", None)
if lock_descriptor is not None:
    try:
        if not lock_descriptor.isdecimal():
            fail()
        descriptor = int(lock_descriptor)
        if descriptor < 0:
            fail()
        held_lock = os.fstat(descriptor)
        live_lock = os.stat(
            root / ".the-hive-release-publish.lock", follow_symlinks=False
        )
        if (
            not stat.S_ISREG(held_lock.st_mode)
            or held_lock.st_nlink != 1
            or held_lock.st_uid != os.geteuid()
            or stat.S_IMODE(held_lock.st_mode) != 0o600
            or (held_lock.st_dev, held_lock.st_ino)
            != (live_lock.st_dev, live_lock.st_ino)
        ):
            fail()
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)
    except (OSError, ValueError):
        fail()
sys.argv = [str(layout.root / "bin" / "the-hive-openai-pricing-inventory"), *sys.argv[4:]]
try:
    runpy.run_module("the_hive.pricing_inventory", run_name="__main__", alter_sys=True)
except SystemExit:
    raise
except Exception:
    fail()
' "$release_root" "$generation" "$manifest_digest" "${@:4}"
