#!/usr/bin/env python3
"""Release one held scope gate into a fixed absolute argv without a shell."""

from __future__ import annotations

import os
import re
import secrets
import socket
import stat
import subprocess
import sys
import time


_TMUX_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")
_CONTROL_SOCKET_NAME = re.compile(r"^codex-master-resource-[a-f0-9]{32}$")
_TMUX_PATH = "/usr/bin/tmux"
_DECIMAL = re.compile(r"^(?:0|[1-9][0-9]*)$")
_CGROUP_COMPONENT = re.compile(rb"^[A-Za-z0-9][A-Za-z0-9_.@:-]{0,127}$")
_SESSION_POLL_SECONDS = 0.1
_TMUX_COMMAND_TIMEOUT_SECONDS = 1.0
_PANE_EXEC_EVIDENCE_TIMEOUT_SECONDS = 5.0
_PROC_CGROUP_MAX_BYTES = 4096
_GATE_READY = b"ready\n"


def _reject() -> None:
    os._exit(64)


def _valid_name(value: object) -> bool:
    return isinstance(value, str) and _TMUX_NAME.fullmatch(value) is not None and ".." not in value


def _valid_control_socket_name(value: object) -> bool:
    return isinstance(value, str) and _CONTROL_SOCKET_NAME.fullmatch(value) is not None


def _parse_decimal(value: object, *, allow_zero: bool) -> int:
    if not isinstance(value, str) or _DECIMAL.fullmatch(value) is None:
        _reject()
    parsed = int(value)
    if parsed > (1 << 64) - 1 or (not allow_zero and parsed == 0):
        _reject()
    return parsed


def _open_runner_target(owner_pid: int, source_fd: int, device: int, inode: int) -> int:
    try:
        fd = os.open(f"/proc/{owner_pid}/fd/{source_fd}", getattr(os, "O_PATH", os.O_RDONLY))
        metadata = os.fstat(fd)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_dev != device
            or metadata.st_ino != inode
            or not os.access(f"/proc/{os.getpid()}/fd/{fd}", os.X_OK)
        ):
            os.close(fd)
            _reject()
        return fd
    except OSError:
        _reject()


def _tmux_session_exists(socket_name: str, session_name: str, environment: dict[str, str]) -> bool:
    try:
        result = subprocess.run(
            [_TMUX_PATH, "-L", socket_name, "has-session", "-t", session_name],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=environment,
            check=False,
            timeout=_TMUX_COMMAND_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def _scope_for_pid(pid: int) -> str | None:
    if type(pid) is not int or pid <= 0:
        return None
    try:
        fd = os.open(f"/proc/{pid}/cgroup", os.O_RDONLY | getattr(os, "O_CLOEXEC", 0))
        try:
            raw = os.read(fd, _PROC_CGROUP_MAX_BYTES + 1)
        finally:
            os.close(fd)
    except OSError:
        return None
    if (
        len(raw) > _PROC_CGROUP_MAX_BYTES
        or raw.count(b"\n") != 1
        or not raw.endswith(b"\n")
        or not raw.startswith(b"0::/")
    ):
        return None
    value = raw[3:-1]
    components = value[1:].split(b"/")
    if not components or any(_CGROUP_COMPONENT.fullmatch(component) is None for component in components):
        return None
    try:
        return value.decode("ascii")
    except UnicodeDecodeError:
        return None


def _tmux_pane_pid(socket_name: str, session_name: str, environment: dict[str, str]) -> int | None:
    try:
        result = subprocess.run(
            [_TMUX_PATH, "-L", socket_name, "display-message", "-p", "-t", session_name, "#{pane_pid}"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=environment,
            check=False,
            timeout=_TMUX_COMMAND_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    try:
        value = result.stdout.decode("ascii")
    except UnicodeDecodeError:
        return None
    if not value.endswith("\n") or value.count("\n") != 1:
        return None
    value = value[:-1]
    if _DECIMAL.fullmatch(value) is None:
        return None
    pane_pid = int(value)
    return pane_pid if 0 < pane_pid <= (1 << 64) - 1 else None


def _pane_executable_identity(pid: int) -> tuple[int, int] | None:
    path = f"/proc/{pid}/exe"
    try:
        metadata = os.stat(path)
    except OSError:
        return None
    if not stat.S_ISREG(metadata.st_mode) or not os.access(path, os.X_OK):
        return None
    return metadata.st_dev, metadata.st_ino


def _terminate_tmux_session(socket_name: str, session_name: str, environment: dict[str, str]) -> None:
    try:
        subprocess.run(
            [_TMUX_PATH, "-L", socket_name, "kill-session", "-t", session_name],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=environment,
            check=False,
            timeout=_TMUX_COMMAND_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def _await_pane_exec_evidence(
    socket_name: str,
    session_name: str,
    environment: dict[str, str],
    *,
    device: int,
    inode: int,
) -> bool:
    expected_scope = _scope_for_pid(os.getpid())
    if expected_scope is None:
        return False
    expected_identity = (device, inode)
    pane_pid: int | None = None
    initial_identity: tuple[int, int] | None = None
    deadline = time.monotonic() + _PANE_EXEC_EVIDENCE_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        if not _tmux_session_exists(socket_name, session_name, environment):
            return False
        current_pane_pid = _tmux_pane_pid(socket_name, session_name, environment)
        if current_pane_pid is None:
            return False
        if pane_pid is None:
            pane_pid = current_pane_pid
        elif current_pane_pid != pane_pid:
            return False
        if _scope_for_pid(pane_pid) != expected_scope:
            return False
        identity = _pane_executable_identity(pane_pid)
        if identity is None:
            return False
        if identity == expected_identity:
            return True
        if initial_identity is None:
            initial_identity = identity
        elif identity != initial_identity:
            return False
        time.sleep(_SESSION_POLL_SECONDS)
    return False


def main() -> None:
    arguments = sys.argv[1:]
    if len(arguments) != 7:
        _reject()
    control_socket_name, socket_name, session_name, owner_pid_text, source_fd_text, device_text, inode_text = arguments
    if not _valid_control_socket_name(control_socket_name) or not _valid_name(socket_name) or not _valid_name(session_name):
        _reject()
    owner_pid = _parse_decimal(owner_pid_text, allow_zero=False)
    source_fd = _parse_decimal(source_fd_text, allow_zero=True)
    device = _parse_decimal(device_text, allow_zero=True)
    inode = _parse_decimal(inode_text, allow_zero=False)
    runner_fd = _open_runner_target(owner_pid, source_fd, device, inode)
    challenge = secrets.token_hex(32)
    expected = f"{challenge}\n".encode("ascii")
    control_socket: socket.socket | None = None
    received = bytearray()
    try:
        control_socket = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        control_socket.connect(b"\0" + control_socket_name.encode("ascii"))
        control_socket.sendall(expected)
        while len(received) < len(expected) + 1:
            chunk = control_socket.recv((len(expected) + 1) - len(received))
            if not chunk:
                break
            received.extend(chunk)
    except OSError:
        _reject()
    if control_socket is None or bytes(received) != expected:
        _reject()
    holder_pid = os.getpid()
    environment = {
        "LANG": "C",
        "LC_ALL": "C",
        "PATH": "/usr/bin:/bin",
        "CODEX_MASTER_RUNNER_EXEC_PATH": f"/proc/{holder_pid}/fd/{runner_fd}",
    }
    child_pid = os.fork()
    if child_pid == 0:
        try:
            os.execve(
                _TMUX_PATH,
                [_TMUX_PATH, "-L", socket_name, "new-session", "-d", "-s", session_name],
                environment,
            )
        except OSError:
            os._exit(127)
        finally:
            if control_socket is not None:
                control_socket.close()
    try:
        _completed_pid, status = os.waitpid(child_pid, 0)
    except OSError:
        _reject()
    if not os.WIFEXITED(status) or os.WEXITSTATUS(status) != 0 or not _tmux_session_exists(socket_name, session_name, environment):
        _reject()
    try:
        control_socket.sendall(_GATE_READY)
    except OSError:
        _reject()
    finally:
        try:
            control_socket.close()
        except OSError:
            _reject()
        control_socket = None
    verified = False
    try:
        verified = _await_pane_exec_evidence(
            socket_name,
            session_name,
            environment,
            device=device,
            inode=inode,
        )
    finally:
        if not verified:
            _terminate_tmux_session(socket_name, session_name, environment)
        try:
            os.close(runner_fd)
        except OSError:
            verified = False
    if not verified:
        _reject()


if __name__ == "__main__":
    main()
