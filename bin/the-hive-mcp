#!/usr/bin/bash
set -euo pipefail

(( $# >= 3 )) || exit 64
release_root="$1"
generation="$2"
manifest_digest="$3"
for variable in "${!CODEX_@}"; do unset "${variable}"; done
unset PYTHONHOME PYTHONPATH
export PATH=/usr/bin:/bin
exec /usr/bin/python3 -I -B -c '
import runpy
import sys
from pathlib import Path

release_root = Path(sys.argv[1])
generation = sys.argv[2]
manifest_digest = sys.argv[3]
if (
    not release_root.is_absolute()
    or not generation
    or "/" in generation
    or generation in {".", ".."}
    or not manifest_digest.startswith("sha256:")
    or len(manifest_digest) != 71
    or any(character not in "0123456789abcdef" for character in manifest_digest[7:])
):
    raise SystemExit(64)
candidate = release_root / "generations" / generation / "src"
try:
    # The bootstrap is used only to load the attester.  Application imports do
    # not start until the returned layout has revalidated the current pointer.
    sys.path.insert(0, str(candidate))
    from the_hive.runtime_layout import RuntimeLayout
    layout = RuntimeLayout.from_current_release(
        release_root, generation, manifest_digest
    )
except Exception:
    raise SystemExit(64)
if layout.root / "src" != candidate:
    raise SystemExit(64)
sys.argv = [str(layout.root / "bin" / "the-hive-mcp"), *sys.argv[4:]]
runpy.run_module("the_hive.server", run_name="__main__", alter_sys=True)
' "$release_root" "$generation" "$manifest_digest" "${@:4}"
