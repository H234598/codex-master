def random_message() -> str:
    """Create a genuinely random notification from bounded word lists."""
    anrede = secrets.choice(ANREDE)
    nomen = secrets.choice(NOMEN)
    verb = secrets.choice(VERBEN)
    aktion = secrets.choice(AKTIONEN)
    status = secrets.choice(STATUS)
    zweck = secrets.choice(ZWECKE)
    zeitpunkt = secrets.choice(ZEITPUNKTE)
    uebergabe = secrets.choice(UEBERGABEN)
    absender = secrets.choice(ABSENDER)
    template = secrets.choice(GRUNDSAETZE)
    return template.format(
        anrede=anrede,
        nom=nomen["nom"],
        acc=nomen["acc"],
        dat=nomen["dat"],
        poss=nomen["poss"],
        verb=verb,
        aktion=aktion,
        einleitung=secrets.choice(EINLEITUNGEN),
        status=status,
        zweck=zweck,
        zeitpunkt=zeitpunkt,
        uebergabe=uebergabe,
        absender=absender,
    )


def notify(message: str) -> None:
    notify_send = shutil.which("notify-send")
    if not notify_send:
        return
    try:
        subprocess.run(
            [notify_send, "--urgency=normal", "Masterjet: Dokumentübergabe", message],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def main() -> int:
    if len(sys.argv) != 2:
        print(f"Verwendung: {sys.argv[0]} /absoluter/pfad/plan.md", file=sys.stderr)
        return 2
    path = Path(sys.argv[1]).expanduser().resolve()
    if path.suffix.lower() != ".md" or not path.is_file():
        print(
            "Es muss eine vorhandene Markdowndatei angegeben werden.", file=sys.stderr
        )
        return 2
    if not path.is_absolute():  # defensive; resolve() should already ensure this
        print("Der Dokumentpfad muss absolut sein.", file=sys.stderr)
        return 2
    message = f"{random_message()} Pfad: {path}"
    notify(message)
    print(str(path))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
