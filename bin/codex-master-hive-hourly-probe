#!/usr/bin/python3 -I
"""Compatibility launcher for the historical public Hive hourly-probe path."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import stat
import sys


_GENERATION = re.compile(r"[0-9a-f]{40}\Z")
_MANIFEST_DIGEST = re.compile(r"sha256:[0-9a-f]{64}\Z")


def _fail(code: str) -> None:
    print(f"hive_hourly_probe_error code={code}", file=sys.stderr, flush=True)
    raise SystemExit(2)


def _current_probe() -> tuple[Path, Path, str, str]:
    launcher = Path(__file__).absolute()
    if launcher.is_symlink() or launcher.parent.name != "libexec":
        _fail("legacy_probe_launcher_invalid")
    home = launcher.parents[2]
    release_root = home / ".local" / "lib" / "the-hive-runtime"
    pointer = release_root / ".the-hive-release-pointers.json"
    try:
        raw = pointer.read_bytes()
        value = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, RecursionError):
        _fail("legacy_probe_release_unavailable")
    if (
        not isinstance(value, dict)
        or frozenset(value) != {"schema_version", "current", "previous"}
        or value.get("schema_version") != 1
        or not isinstance(value.get("current"), dict)
        or frozenset(value["current"]) != {"generation", "manifest_digest"}
    ):
        _fail("legacy_probe_release_invalid")
    generation = value["current"].get("generation")
    manifest_digest = value["current"].get("manifest_digest")
    if (
        not isinstance(generation, str)
        or not _GENERATION.fullmatch(generation)
        or not isinstance(manifest_digest, str)
        or not _MANIFEST_DIGEST.fullmatch(manifest_digest)
    ):
        _fail("legacy_probe_release_invalid")
    entrypoint = (
        release_root
        / "generations"
        / generation
        / "bin"
        / "the-hive-hive-hourly-probe"
    )
    try:
        item = entrypoint.lstat()
    except OSError:
        _fail("legacy_probe_entrypoint_unavailable")
    if (
        stat.S_ISLNK(item.st_mode)
        or not stat.S_ISREG(item.st_mode)
        or not item.st_mode & stat.S_IXUSR
    ):
        _fail("legacy_probe_entrypoint_invalid")
    return entrypoint, release_root, generation, manifest_digest


def main() -> int:
    arguments = tuple(sys.argv[1:])
    if arguments not in {(), ("--json",)}:
        _fail("arguments_invalid")
    entrypoint, release_root, generation, manifest_digest = _current_probe()
    os.execve(
        os.fspath(entrypoint),
        [
            os.fspath(entrypoint),
            os.fspath(release_root),
            generation,
            manifest_digest,
            "--json",
        ],
        os.environ,
    )
    raise AssertionError("unreachable")


if __name__ == "__main__":
    raise SystemExit(main())
