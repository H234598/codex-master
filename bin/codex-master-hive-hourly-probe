#!/usr/bin/python3 -I
"""Attested compatibility launcher for the historical Hive probe path."""

from __future__ import annotations

import os
from pathlib import Path
import runpy
import stat
import sys


sys.dont_write_bytecode = True

_GENERATION = "@MASTERJET_GENERATION@"
_MANIFEST_DIGEST = "@MASTERJET_MANIFEST_DIGEST@"


def _fail(code: str) -> None:
    print(f"hive_hourly_probe_error code={code}", file=sys.stderr, flush=True)
    raise SystemExit(2)


def _launcher_release_root() -> Path:
    launcher = Path(__file__).absolute()
    try:
        item = launcher.lstat()
    except OSError:
        _fail("legacy_probe_launcher_unavailable")
    if (
        launcher.is_symlink()
        or launcher.parent.name != "libexec"
        or not stat.S_ISREG(item.st_mode)
        or item.st_nlink != 1
        or item.st_uid != os.geteuid()
        or stat.S_IMODE(item.st_mode) != 0o755
    ):
        _fail("legacy_probe_launcher_invalid")
    return launcher.parents[2] / ".local" / "lib" / "the-hive-runtime"


def _attested_layout() -> object:
    release_root = _launcher_release_root()
    source_root = release_root / "generations" / _GENERATION / "src"
    try:
        # RuntimeLayout validates the complete pointer object (including
        # previous), all image paths without following links, bounded sizes,
        # modes, ownership, and the full manifest before the probe module runs.
        sys.path.insert(0, os.fspath(source_root))
        from the_hive.runtime_layout import LayoutError, RuntimeLayout

        layout = RuntimeLayout.from_current_release(
            release_root, _GENERATION, _MANIFEST_DIGEST
        )
        if layout.probe_entrypoint != (
            release_root
            / "generations"
            / _GENERATION
            / "bin"
            / "the-hive-hive-hourly-probe"
        ):
            raise LayoutError("runtime_layout_invalid")
        return layout
    except (ImportError, OSError, TypeError, ValueError):
        _fail("legacy_probe_attestation_failed")


def main() -> int:
    if tuple(sys.argv[1:]) not in {(), ("--json",)}:
        _fail("arguments_invalid")
    layout = _attested_layout()
    del layout
    try:
        sys.argv = [
            os.fspath(
                _launcher_release_root()
                / "generations"
                / _GENERATION
                / "bin"
                / "the-hive-hive-hourly-probe"
            ),
            "--json",
        ]
        runpy.run_module("the_hive.hive.hourly_probe", run_name="__main__", alter_sys=True)
    except (ImportError, OSError, TypeError, ValueError):
        _fail("legacy_probe_runtime_unavailable")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
